# modules/edge_infra/Kconfig

menu "Edge_Infra (Storage, Bus, and Infrastructure Drivers)"

config EDGE_INFRA_SQLITE
    bool "Enable SQLite Storage Service & Driver"
    default y
    help
      Enables sqlite_service and sqlite_storage_driver in edge_infra.

config EDGE_INFRA_DDS
    bool "Enable CycloneDDS DataHub Backend"
    default y
    help
      Enables CycloneDDS distributed mesh DataHub backend in edge_infra.

config EDGE_INFRA_MQTT
    bool "Enable Northbound MQTT Bridge Backend"
    default y
    help
      Enables MQTT cloud bridge DataHub backend in edge_infra.

endmenu

menu "Edge_Security (Industrial Hardening)"
config EDGEC_SECURITY_DPI
    bool "Enable Deep Packet Inspection Firewall"
    default y
config EDGEC_SECURITY_SIGNED_LOGS
    bool "Enable Cryptographically Signed Audit Logs"
    default y
endmenu
