# /etc/systemd/system/cedgex-sim-sensor.service
#
# Example systemd service file for running the sim_sensor_app.
#
# To install:
# 1. Copy this file to /etc/systemd/system/
# 2. Make sure the sim_sensor_app executable is at /usr/local/bin/
# 3. Run: sudo systemctl daemon-reload
# 4. Run: sudo systemctl enable cedgex-sim-sensor.service
# 5. Run: sudo systemctl start cedgex-sim-sensor.service
#
# To check logs:
# journalctl -u cedgex-sim-sensor -f

[Unit]
Description=C-EdgeX Simulated Sensor Application
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sim_sensor_app

# --- Process Supervision ---
# Always restart the service if it exits, crashes, or is killed.
Restart=always
# Wait 5 seconds before restarting to prevent rapid-fire restarts.
RestartSec=5

# --- Security & Sandboxing (Good Practices) ---
# Run as a non-privileged user if possible.
# User=cedgex
# Group=cedgex

# Limit the process's capabilities.
# NoNewPrivileges=true
# ProtectSystem=full
# ProtectHome=true
# PrivateTmp=true
# PrivateDevices=true

# --- Resource Limits ---
# Prevent the application from consuming all system memory.
MemoryLimit=100M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
