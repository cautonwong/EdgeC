        "type": "object",
        "required": [
          "month",
          "top",
          "peak",
          "flat",
          "valley"
        ],
        "properties": {
          "month": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "top": {
            "type": "number"
          },
          "peak": {
            "type": "number"
          },
          "flat": {
            "type": "number"
          },
          "valley": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
