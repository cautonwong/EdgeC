{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch IEMS",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/iems",
            "args": ["-m", "iems", "-w", "8080", "-r", "8081"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(gdb) Launch HEMS",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/hems",
            "args": ["-m", "hems"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "MIMode": "gdb"
        }
    ]
}