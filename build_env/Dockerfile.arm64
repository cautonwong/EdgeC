# build_env/Dockerfile.arm64
#
# Defines the ARM64 cross-compilation environment.
# It extends the base x64 environment and adds the ARM toolchain.

# Use the x64 image as a base to ensure tools like CMake are consistent.
ARG BASE_IMAGE_ARG=c-edgex-builder-x64
FROM ${BASE_IMAGE_ARG} as base

# Install the ARM64 cross-compiler toolchain.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc-11-aarch64-linux-gnu \
    g++-11-aarch64-linux-gnu \
    && rm -rf /var/lib/apt/lists/*

# The rest of the configuration is inherited from the base image.
# The `arm64-gnu.toolchain.cmake` file will find and use this compiler.
WORKDIR /work
CMD ["/bin/bash"]
