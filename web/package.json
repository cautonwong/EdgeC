{
  "name": "edgeos-web-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "products/*"
  ],
  "scripts": {
    "tooling": "node tooling/cli.mjs all",
    "tooling:validate": "node tooling/cli.mjs validate",
    "tooling:contrast": "node tooling/cli.mjs contrast",
    "registry": "node tooling/cli.mjs registry --all",
    "test:unit": "node --test tooling/test/*.test.mjs mock-server/test/*.test.mjs && npm run test:sdk",
    "mock:iems": "node mock-server/server.mjs --product iems --port 8081",
    "mock:dcu": "node mock-server/server.mjs --product dcu --port 8082",
    "test:e2e": "node tooling/cli.mjs registry --all && playwright test",
    "test:e2e:iems": "node tooling/cli.mjs registry --all && playwright test --project=iems",
    "build:all": "npm run build --prefix products/iems && npm run build --prefix products/dcu && npm run build --prefix products/smart_box",
    "test:sdk": "node core/scripts/build-sdk-tests.mjs && node --test core/test/*.test.cjs",
    "test:e2e:dcu": "node tooling/cli.mjs registry --all && playwright test --project=dcu",
    "test:e2e:smartbox": "node tooling/cli.mjs registry --all && playwright test --project=smartbox",
    "mock:watchdog": "node mock-server/watchdog.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0"
  }
}
