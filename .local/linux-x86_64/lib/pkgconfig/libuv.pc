prefix=/root/.local/linux-x86_64
exec_prefix=${prefix}
libdir=/root/.local/linux-x86_64/lib
includedir=/root/.local/linux-x86_64/include
LIBUV_STATIC=-L${libdir} -l:libuv.a -lpthread -ldl -lrt -lm

Name: libuv
Version: 1.51.1
Description: multi-platform support library with a focus on asynchronous I/O.
URL: http://libuv.org/

Libs: -L${libdir} -luv -lpthread -ldl -lrt -lm
Cflags: -I${includedir}
