prefix=/root/.local/linux-aarch64
exec_prefix=${prefix}
libdir=/root/.local/linux-aarch64/lib
includedir=/root/.local/linux-aarch64/include

Name: libuv-static
Version: 1.51.1
Description: multi-platform support library with a focus on asynchronous I/O.
URL: http://libuv.org/

Libs: -L${libdir} -l:libuv.a -lpthread -ldl -lrt -lm
Cflags: -I${includedir}
