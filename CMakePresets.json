{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja"
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug",
      "description": "Build for x64 architecture with Debug information and ASan.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release",
      "description": "Build for x64 architecture with Release optimizations.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_ASAN": "OFF"
      }
    },
    {
      "name": "x64-coverage",
      "displayName": "x64 Code Coverage",
      "description": "Build with coverage reporting enabled.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${preset.name}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "--coverage",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage"
      }
    },
    {
      "name": "arm64-debug",
      "displayName": "ARM64 Cross-Compile Debug",
      "description": "Cross-compile for ARM64 with Debug information.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/arm64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_ASAN": "OFF",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/arm64-gnu.toolchain.cmake"
      }
    },
    {
      "name": "arm64-release",
      "displayName": "ARM64 Cross-Compile Release",
      "description": "Cross-compile for ARM64 with Release optimizations.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/arm64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_ASAN": "OFF",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/arm64-gnu.toolchain.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug"
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release"
    },
    {
      "name": "arm64-debug",
      "configurePreset": "arm64-debug"
    },
    {
      "name": "arm64-release",
      "configurePreset": "arm64-release"
    }
  ],
  "testPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "output": {"outputOnFailure": true}
    }
  ]
}
