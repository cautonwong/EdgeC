# ==========================================
# Stage 1: Build Environment
# ==========================================
FROM debian:bookworm-slim AS builder

ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    git \
    pkg-config \
    libssl-dev \
    golang \
    curl \
    ca-certificates \
    python3 \
    python3-venv \
    && if [ "$TARGETARCH" = "arm64" ]; then \
       apt-get install -y gcc-aarch64-linux-gnu g++-aarch64-linux-gnu; \
    fi \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . .

# Build based on architecture
RUN mkdir -p build && cd build && \
    if [ "$TARGETARCH" = "arm64" ]; then \
        cmake .. -GNinja -DCMAKE_BUILD_TYPE=Release \
                 -DCMAKE_TOOLCHAIN_FILE=cmake/toolchains/aarch64-linux-gnu.cmake \
                 -DCMAKE_INSTALL_PREFIX=/app/runtime; \
    else \
        cmake .. -GNinja -DCMAKE_BUILD_TYPE=Release \
                 -DCMAKE_INSTALL_PREFIX=/app/runtime; \
    fi && \
    cmake --build . --target install

# ========================================== 
# Stage 2: Production Runtime
# ==========================================
FROM debian:bookworm-slim

ARG TARGETARCH
LABEL maintainer="EdgeOS Team"
LABEL description="EdgeOS Production Runtime"

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/runtime /app

# Copy correct local libraries
COPY --from=builder /build/.local/linux-$(if [ "$TARGETARCH" = "arm64" ]; then echo "aarch64"; else echo "x86_64"; fi)/lib /app/lib
COPY --from=builder /build/config /app/config

ENV LD_LIBRARY_PATH=/app/lib
ENV PATH="/app/bin:${PATH}"

# Default entrypoint for IEMS
ENTRYPOINT ["iems"]
CMD ["--config", "/app/config/iems_pipelines.json"]