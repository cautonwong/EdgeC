# EdgeOS / EdgeC AI-Augmented Code Review & Gate Container
# 遵循 docs/modular_2.md 全封装部署规范
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# 1. 系统基础工具与 C/C++ 静态检查链
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git build-essential \
    python3 python3-pip python3-venv \
    clang-tidy cppcheck ca-certificates jq \
    && rm -rf /var/lib/apt/lists/*

# 2. 安装 Node.js 20 与 Alibaba OCR
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g @alibaba-group/open-code-review || true && \
    rm -rf /var/lib/apt/lists/*

# 3. Python 虚拟环境与 CRG、Anthropic SDK、MCP
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --no-cache-dir code-review-graph anthropic mcp || true

# 4. 挂载编排逻辑
WORKDIR /workspace
COPY scripts/ci/ /app/scripts/ci/
RUN chmod +x /app/scripts/ci/*.py

ENTRYPOINT ["python3", "/app/scripts/ci/run_pure_mcp_orchestrator.py"]
