if SOC_SERIES_RN8XXX

config SOC_SERIES
	default "renergy_rn8xxx"

config SOC_RENERGY_RN8XXX
	bool
	default y

config SOC
	default "rn8318" if SOC_RN8318

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 58982400 if SOC_RENERGY_CORE1
	default 29491200 if SOC_RENERGY_CORE0

config NUM_IRQS
	default 147

endif # SOC_SERIES_RN8XXX
