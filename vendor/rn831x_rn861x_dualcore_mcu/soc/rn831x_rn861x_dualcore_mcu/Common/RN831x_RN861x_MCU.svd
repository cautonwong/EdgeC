                     <enumeratedValues>
                        <enumeratedValue>
                           <name>POSITIVE</name>
                           <description>Positive polarity (Idle level = High, Modulation = Low)</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NEGATIVE</name>
                           <description>Negative polarity (Idle level = Low, Modulation = High)</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DATLEN</name>
                     <access>read-write</access>
                     <bitRange>[6:5]</bitRange>
                     <description>Data Length - excludes parity bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>5B</name>
                           <description>5 bits data length</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>6B</name>
                           <description>6 bits data length</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>7B</name>
                           <description>7 bits data length</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>8B</name>
                           <description>8 bits data length</description>
                           <value>0x3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PARS</name>
                     <access>read-write</access>
                     <bitRange>[9:7]</bitRange>
                     <description>Parity Selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NONE</name>
                           <description>No parity</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ODD</name>
                           <description>Odd parity</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EVEN</name>
                           <description>Even parity</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ZERO</name>
                           <description>Fixed to 0 parity</description>
                           <value>0x3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ONE</name>
                           <description>Fixed to 1 parity</description>
                           <value>0x4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>USER_DEFINED</name>
                           <description>User-defined parity</description>
                           <value>0x5</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>STOPS</name>
                     <access>read-write</access>
                     <bitRange>[10:10]</bitRange>
