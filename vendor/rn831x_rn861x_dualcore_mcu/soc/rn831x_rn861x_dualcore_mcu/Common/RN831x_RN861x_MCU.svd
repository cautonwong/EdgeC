                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SYSCLK</name>
                           <description>select by system mode (hcmm pll_1hz, not hcmm RTC_1hz)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RTC</name>
                           <description>select RTC_1hz</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>IF</name>
               <description>RTC interrupt flags register</description>
               <addressOffset>0x38</addressOffset>
               <size>32</size>
