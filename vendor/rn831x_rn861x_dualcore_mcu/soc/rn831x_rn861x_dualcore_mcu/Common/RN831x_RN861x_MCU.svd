                  </field>
               </fields>
            </register>
            <register>
               <name>STA</name>
               <description>Status Register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TXIF</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Transmit Complete Flag</description>
