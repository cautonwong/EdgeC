                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>CORE0 FLASH mapped to address 0x0000_0000</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2</name>
                           <description>CORE0 FLASH mapped to address 0x1020_0000</description>
                           <value>0x2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CORE1</name>
                     <access>read-write</access>
                     <bitRange>[6:4]</bitRange>
                     <description>Core1 Address ReMapping</description>
                     <enumeratedValues>
