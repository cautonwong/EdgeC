                     <enumeratedValues>
                        <enumeratedValue>
                           <name>STORE_MEMORY</name>
                           <description>Data is stored in memory regardless of parity error.</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOT_STORE_MEMORY</name>
                           <description>When parity error occurs, the current frame is not stored in memory.</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
