      <peripheral>
         <name>LCD_CORE0</name>
         <description>LCD Module core0</description>
         <groupName>LCD</groupName>
         <baseAddress>0x20060000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x0048</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>CTRL</name>
               <description>LCD control register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <resetValue>0x0</resetValue>
               <fields>
                  <field>
                     <name>EN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>LCD enable bit</description>
                  </field>
                  <field>
                     <name>DUTY</name>
                     <access>read-write</access>
                     <bitRange>[3:1]</bitRange>
                     <description>LCD duty control bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>STA</name>
                           <description>static output (COM0)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1_2</name>
                           <description>duty cycle = 1/2 (COM0~1)</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1_3</name>
                           <description>duty cycle = 1/3 (COM0~2)</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1_4</name>
                           <description>duty cycle = 1/4 (COM0~3)</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1_6</name>
                           <description>duty cycle = 1/6 (COM0~5)</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1_8</name>
                           <description>duty cycle = 1/8 (COM0~7)</description>
                           <value>5</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BIAS</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>LCD bias control bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>1_3</name>
                           <description>Select LCD bias as 1/3 voltage bias</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1_4</name>
                           <description>Select LCD bias as 1/4 voltage bias</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BIASLVL</name>
                     <access>read-write</access>
                     <bitRange>[10:5]</bitRange>
                     <description>Charge pump bias level control bit</description>
                  </field>
                  <field>
                     <name>TYPE</name>
                     <access>read-write</access>
                     <bitRange>[11:11]</bitRange>
                     <description>LCD driver wave type bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>A</name>
                           <description>Select LCD drive type A</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>B</name>
                           <description>Select LCD drive type B</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PWD_PUMP</name>
                     <access>read-write</access>
