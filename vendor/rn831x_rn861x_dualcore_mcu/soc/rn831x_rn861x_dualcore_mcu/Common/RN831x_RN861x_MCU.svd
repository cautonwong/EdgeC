                  </field>
               </fields>
            </register>
            <register>
               <name>TW_BAUD</name>
               <description>UART_TW Baud Rate Register</description>
               <addressOffset>0x5C</addressOffset>
               <size>32</size>
               <resetValue>0xBFF</resetValue>
               <fields>
                  <field>
                     <name fieldName="None">TW_BAUD</name>
                     <bitRange>[13:0]</bitRange>
                     <description>TW mode baud rate configuration for each bit length. Default value is for 14M system clock and 4800 baud.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TW_EN</name>
               <description>UART_TW Enable Register</description>
               <addressOffset>0x60</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">TW_EN</name>
                     <bitRange>[1:0]</bitRange>
                     <description>TW_KICK</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CAL_CTRL</name>
               <description>UART Calibration Control Register (Low-level Length Counting)</description>
               <addressOffset>0x64</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>UART_CAL_EN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Calibration Enable</description>
                  </field>
                  <field>
                     <name>CAL_MODE</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>Measurement Mode</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CONTINUOUS</name>
                           <description>Continuous measurement</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FIXED_DATA</name>
                           <description>Fixed data measurement</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>POS_START</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>Measurement Start Point</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>RX_FALLING_EDGE</name>
                           <description>RX falling edge</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RX_RISING_EDGE</name>
                           <description>RX rising edge</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>POS_END</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>Measurement End Point</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>RX_FALLING_EDGE</name>
                           <description>RX falling edge</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RX_RISING_EDGE</name>
                           <description>RX rising edge</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CAL_DATA</name>
                     <access>read-write</access>
                     <bitRange>[12:4]</bitRange>
                     <description>Data value for fixed data measurement mode. The measurement register is updated only when this data is received</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CAL_CNT</name>
               <description>ART Calibration Count Register</description>
               <addressOffset>0x68</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CAL_CNT</name>
                     <bitRange>[31:0]</bitRange>
                     <description>Measurement result: Continuous mode: Updated after each low-level measurement. Fixed data mode: Updated after receiving and measuring the configured low-level length.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TX_DRLAY</name>
               <description>Transmit Delay Configuration Register (UART6-7)</description>
               <addressOffset>0x6C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TIMEOUT_CNT</name>
                     <access>read-write</access>
                     <bitRange>[1:0]</bitRange>
                     <description>Delay Insertion. Effective when TX_DELAY_EN=1</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>1B</name>
                           <description>1 UART data bit time</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2B</name>
                           <description>2 UART data bit times</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3B</name>
                           <description>3 UART data bit times</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4B</name>
                           <description>4 UART data bit times</description>
                           <value>0x3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TX_DELAY_EN</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>Transmit Delay Enable</description>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
