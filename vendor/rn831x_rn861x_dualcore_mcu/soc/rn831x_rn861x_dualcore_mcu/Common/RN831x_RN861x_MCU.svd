                  <field>
                     <name>DMA_CH6</name>
                     <access>read-write</access>
                     <bitRange>[13:12]</bitRange>
                     <description>Channel 6: UART0 channel access SRAM priority configuration.</description>
                  </field>
                  <field>
                     <name>DMA_CH7</name>
                     <access>read-write</access>
                     <bitRange>[15:14]</bitRange>
                     <description>Channel 7: UART1 channel access SRAM priority configuration.</description>
                  </field>
                  <field>
                     <name>DMA_CH8</name>
                     <access>read-write</access>
                     <bitRange>[17:16]</bitRange>
                     <description>Channel 8: UART2 channel access SRAM priority configuration.</description>
                  </field>
                  <field>
                     <name>DMA_CH9</name>
                     <access>read-write</access>
                     <bitRange>[19:18]</bitRange>
                     <description>Channel 9: UART3 channel access SRAM priority configuration.</description>
                  </field>
                  <field>
                     <name>DMA_CH10</name>
                     <access>read-write</access>
                     <bitRange>[21:20]</bitRange>
                     <description>Channel 10: UART4 channel access SRAM priority configuration.</description>
                  </field>
                  <field>
                     <name>DMA_CH11</name>
                     <access>read-write</access>
                     <bitRange>[23:22]</bitRange>
                     <description>Channel 11: UART5 channel access SRAM priority configuration.</description>
                  </field>
                  <field>
                     <name>DMA_CH12</name>
                     <access>read-write</access>
                     <bitRange>[25:24]</bitRange>
                     <description>Channel 12: UART6 channel access SRAM priority configuration.</description>
                  </field>
                  <field>
                     <name>DMA_CH13</name>
                     <access>read-write</access>
                     <bitRange>[27:26]</bitRange>
                     <description>Channel 13: UART7 channel access SRAM priority configuration.</description>
                  </field>
                  <field>
                     <name>DMA_CH14</name>
                     <access>read-write</access>
                     <bitRange>[29:28]</bitRange>
                     <description>Channel 14: CAN channel access SRAM priority configuration.</description>
                  </field>
                  <field>
                     <name>DMA_CH15</name>
                     <access>read-write</access>
                     <bitRange>[31:30]</bitRange>
                     <description>Channel 15: TCO_PWM channel access SRAM priority configuration.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_PRI1_CTRL</name>
               <description>DMA Access SRAM Priority Configuration Register 1</description>
               <addressOffset>0x50C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>DMA_CH16</name>
                     <access>read-write</access>
                     <bitRange>[1:0]</bitRange>
                     <description>Channel 16: TC1_PWM channel access SRAM priority configuration.</description>
                  </field>
                  <field>
                     <name>DMA_CH17</name>
                     <access>read-write</access>
                     <bitRange>[3:2]</bitRange>
                     <description>Channel 17: AES channel access SRAM priority configuration.</description>
                  </field>
                  <field>
                     <name>DMA_CH18</name>
                     <access>read-write</access>
                     <bitRange>[5:4]</bitRange>
