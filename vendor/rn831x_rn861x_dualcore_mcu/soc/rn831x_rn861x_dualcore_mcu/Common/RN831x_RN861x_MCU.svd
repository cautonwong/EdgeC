      <peripheral>
         <name>LSRX_CORE0</name>
         <description>LSRX Module core0</description>
         <groupName>LSRX</groupName>
         <baseAddress>0x2002C000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x002C</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>FTOP</name>
               <description>LSRX identify frame header register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <resetValue>0x800A8000</resetValue>
               <fields>
                  <field>
                     <name>FTOP</name>
                     <bitRange>[31:0]</bitRange>
                     <description>LSRX identify frame header bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>FHD</name>
               <description>LSRX identify frame header enable register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>B0CHKEN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>First byte check funcstion of frame header enable bit</description>
                  </field>
                  <field>
                     <name>B0PRTEN</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>First byte parity function of frame enable bit</description>
                  </field>
                  <field>
                     <name>B1CHKEN</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>Second byte of check funcstion of frame header enable bit</description>
                  </field>
                  <field>
                     <name>B1PRTEN</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>Second byte parity function of frame enable bit</description>
                  </field>
                  <field>
                     <name>B2CHKEN</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>Third byte of check funcstion of frame header enable bit</description>
                  </field>
                  <field>
                     <name>B2PRTEN</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>Third byte parity function of frame enable bit</description>
                  </field>
                  <field>
                     <name>B3CHKEN</name>
                     <access>read-write</access>
                     <bitRange>[6:6]</bitRange>
                     <description>Fourth byte of check funcstion of frame header enable bit</description>
                  </field>
                  <field>
                     <name>B3PRTEN</name>
                     <access>read-write</access>
                     <bitRange>[7:7]</bitRange>
                     <description>Fourth byte parity function of frame enable bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CTL</name>
               <description>LSRX control register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field enums="ALL_ENUM">
                     <name>CHL0_SEL</name>
                     <access>read-write</access>
                     <bitRange>[3:0]</bitRange>
                     <description>Channel0 select bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>UART0</name>
                           <description>Channel select UART0</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART1</name>
                           <description>Channel select UART1</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART2</name>
                           <description>Channel select UART2</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART3</name>
                           <description>Channel select UART3</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART4</name>
                           <description>Channel select UART4</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART5</name>
                           <description>Channel select UART5</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART6</name>
                           <description>Channel select UART6</description>
                           <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UART7</name>
                           <description>Channel select UART7</description>
                           <value>7</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="CHL0_SEL">
                     <name>CHL1_SEL</name>
                     <access>read-write</access>
                     <bitRange>[7:4]</bitRange>
                     <description>Channel1 select bits</description>
                  </field>
                  <field derivedFrom="CHL0_SEL">
                     <name>CHL2_SEL</name>
                     <access>read-write</access>
                     <bitRange>[11:8]</bitRange>
                     <description>Channel2 select bits</description>
                  </field>
                  <field derivedFrom="CHL0_SEL">
                     <name>CHL3_SEL</name>
                     <access>read-write</access>
                     <bitRange>[15:12]</bitRange>
                     <description>Channel3 select bits</description>
                  </field>
                  <field>
                     <name>IDLE_DET</name>
                     <access>read-write</access>
                     <bitRange>[16:16]</bitRange>
                     <description>LSRX idle check enable bit</description>
                  </field>
                  <field>
                     <name>CHL0EN</name>
                     <access>read-write</access>
                     <bitRange>[17:17]</bitRange>
                     <description>Channel0 receive enable bit</description>
                  </field>
                  <field>
                     <name>CHL1EN</name>
                     <access>read-write</access>
                     <bitRange>[18:18]</bitRange>
                     <description>Channel1 receive enable bit</description>
                  </field>
                  <field>
                     <name>CHL2EN</name>
                     <access>read-write</access>
                     <bitRange>[19:19]</bitRange>
                     <description>Channel2 receive enable bit</description>
                  </field>
                  <field>
                     <name>CHL3EN</name>
                     <access>read-write</access>
                     <bitRange>[20:20]</bitRange>
                     <description>Channel3 receive enable bit</description>
                  </field>
                  <field>
                     <name>TIME_TH</name>
                     <access>read-write</access>
                     <bitRange>[25:21]</bitRange>
                     <description>Threshold time config bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CAL_CFG</name>
               <description>Calibration configuration register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CAL_CNT</name>
                     <access>read-write</access>
                     <bitRange>[22:0]</bitRange>
                     <description>Calibration wave output cycle config bits</description>
                  </field>
                  <field>
                     <name>PAR_DATA</name>
                     <access>read-write</access>
                     <bitRange>[30:23]</bitRange>
                     <description>Parity data bits of calibration wave</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>EN</name>
               <description>LSRX enable register</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <resetValue>0x0</resetValue>
               <fields>
                  <field>
                     <name>EN</name>
                     <bitRange>[0:0]</bitRange>
                     <description>LSRX enable bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IE</name>
               <description>LSRX interrupt enable register</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <resetValue>0x0</resetValue>
               <fields>
                  <field>
                     <name>CAL_FINISH_IE</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Calibration wave transmit finish enable bit</description>
                  </field>
                  <field>
                     <name>CAL_UPDATE_IE</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>Calibration update interrupt enable bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IF</name>
               <description>LSRX interrupt flag register</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <resetValue>0x0</resetValue>
               <fields>
                  <field>
                     <name>CAL_FINISH_IF</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Calibration wave transmit finish interrupt flag bit</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>CHL0_UPDATE_IF</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>Channel0 update interrupt flag bit</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>CHL1_UPDATE_IF</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>Channel1 update interrupt flag bit</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>CHL2_UPDATE_IF</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>Channel2 update interrupt flag bit</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>CHL3_UPDATE_IF</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>Channel3 update interrupt flag bit</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>CHL0_VALID_IF</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>Channel0 receive timeout flag bit</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>CHL1_VALID_IF</name>
                     <access>read-write</access>
                     <bitRange>[6:6]</bitRange>
                     <description>Channel1 receive timeout flag bit</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>CHL2_VALID_IF</name>
                     <access>read-write</access>
                     <bitRange>[7:7]</bitRange>
                     <description>Channel2 receive timeout flag bit</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>CHL3_VALID_IF</name>
                     <access>read-write</access>
                     <bitRange>[8:8]</bitRange>
                     <description>Channel3 receive timeout flag bit</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CH0FH_TIME</name>
               <description>Channel0 frame header time register</description>
               <addressOffset>0x1C</addressOffset>
               <size>32</size>
               <resetValue>0x0</resetValue>
               <fields>
                  <field>
                     <name>CH0FH_TIME</name>
                     <bitRange>[24:0]</bitRange>
                     <description>Channel0 frame header time bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CH1FH_TIME</name>
               <description>Channel1 frame header time register</description>
               <addressOffset>0x20</addressOffset>
               <size>32</size>
               <resetValue>0x0</resetValue>
               <fields>
                  <field>
                     <name>CH1FH_TIME</name>
                     <bitRange>[24:0]</bitRange>
                     <description>Channel1 frame header time bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CH2FH_TIME</name>
               <description>Channel2 frame header time register</description>
               <addressOffset>0x24</addressOffset>
               <size>32</size>
               <resetValue>0x0</resetValue>
               <fields>
                  <field>
                     <name>CH2FH_TIME</name>
                     <bitRange>[24:0]</bitRange>
                     <description>Channel2 frame header time bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CH3FH_TIME</name>
               <description>Channel3 frame header time register</description>
               <addressOffset>0x28</addressOffset>
               <size>32</size>
               <resetValue>0x0</resetValue>
               <fields>
                  <field>
                     <name>CH3FH_TIME</name>
                     <bitRange>[24:0]</bitRange>
                     <description>Channel3 frame header time bits</description>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral derivedFrom="LSRX_CORE0">
         <name>LSRX_CORE1</name>
         <description>LSRX Module core1</description>
         <groupName>LSRX</groupName>
         <baseAddress>0xA002C000</baseAddress>
      </peripheral>
      <peripheral>
         <name>LVDCMP_CORE0</name>
         <description>LVD and CMP module</description>
         <groupName>ANALOG</groupName>
         <baseAddress>0x200BC000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x20</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>LVDCTRL</name>
               <description>LVD Control Register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>LVDS</name>
                     <bitRange>[3:0]</bitRange>
                     <description>LVD threshold voltage set bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>1P9</name>
                           <description>select 1.9 as LVD Vil, 2.0 as LVD Vih</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2P1</name>
                           <description>select 2.1 as LVD Vil, 2.2 as LVD Vih</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2P3</name>
                           <description>select 2.3 as LVD Vil, 2.4 as LVD Vih</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2P5</name>
                           <description>select 2.5 as LVD Vil, 2.6 as LVD Vih</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2P7</name>
                           <description>select 2.7 as LVD Vil, 2.8 as LVD Vih</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2P9</name>
                           <description>select 2.9 as LVD Vil, 3.0 as LVD Vih</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P1</name>
                           <description>select 3.1 as LVD Vil, 3.2 as LVD Vih</description>
                           <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P3</name>
                           <description>select 3.3 as LVD Vil, 3.4 as LVD Vih</description>
                           <value>7</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P5</name>
                           <description>select 3.5 as LVD Vil, 3.6 as LVD Vih</description>
                           <value>8</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P7</name>
                           <description>select 3.7 as LVD Vil, 3.8 as LVD Vih</description>
                           <value>9</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3P9</name>
                           <description>select 3.9 as LVD Vil, 4.0 as LVD Vih</description>
                           <value>10</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4P1</name>
                           <description>select 4.1 as LVD Vil, 4.2 as LVD Vih</description>
                           <value>11</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4P3</name>
                           <description>select 4.3 as LVD Vil, 4.4 as LVD Vih</description>
                           <value>12</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4P5</name>
                           <description>select 4.5 as LVD Vil, 4.6 as LVD Vih</description>
                           <value>13</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4P7</name>
                           <description>select 4.7 as LVD Vil, 4.8 as LVD Vih</description>
                           <value>14</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LVDIN</name>
                           <description>select 1.25 as LVD Vil, 1.45 as LVD Vih ,and compare with voltage found on LVDIN pin</description>
                           <value>15</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LVD_FLT_CNT</name>
                     <bitRange>[11:4]</bitRange>
                     <description>The filter can be configured from 0 to 255 clock cycles. Setting to 0 disables the filter.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CMPCTRL</name>
               <description>CMP Control Register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field enums="ALL_ENUM">
                     <name>MODE_CMP1R</name>
                     <bitRange>[0:0]</bitRange>
                     <description>switch bit of CMP1 internal 600K simpling resistor(=1 register off, =0 register on)</description>
                  </field>
                  <field derivedFrom="MODE_CMP1R">
                     <name>MODE_CMP2R</name>
                     <bitRange>[1:1]</bitRange>
                     <description>switch bit of CMP2 internal 600K simpling resistor(=1 register off, =0 register on)</description>
                  </field>
                  <field enums="ALL_ENUM">
                     <name>HYSEN_CMP1</name>
                     <bitRange>[2:2]</bitRange>
                     <description>CMP1 hysteresis switch bit</description>
                  </field>
                  <field derivedFrom="HYSEN_CMP1">
                     <name>HYSEN_CMP2</name>
                     <bitRange>[3:3]</bitRange>
                     <description>CMP2 hysteresis switch bit</description>
                  </field>
                  <field>
                     <name>CMP1_FLT_CNT</name>
                     <bitRange>[11:4]</bitRange>
                     <description>The filter can be configured from 0 to 255 clock cycles. Setting to 0 disables the filter.</description>
                  </field>
                  <field>
                     <name>CMP2_FLT_CNT</name>
                     <bitRange>[19:12]</bitRange>
                     <description>The filter can be configured from 0 to 255 clock cycles. Setting to 0 disables the filter.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IE</name>
               <description>CMP, LVD Interrupt Enable Register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CMP1IE</name>
                     <bitRange>[0:0]</bitRange>
                     <description>comparator No.1 interrupt enable bit</description>
                  </field>
                  <field>
                     <name>CMP2IE</name>
                     <bitRange>[1:1]</bitRange>
                     <description>comparator No.2 interrupt enable bit</description>
                  </field>
                  <field>
                     <name>LVDIE</name>
                     <bitRange>[2:2]</bitRange>
                     <description>LVD interrupt enable bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IF</name>
               <description>CMP, LVD Interrupt Flag Register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CMP1IF</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>comparator NO.1 interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>CMP2IF</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>comparator No.2 interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>LVDIF</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>LVD interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>LVDPWD</name>
               <description>LVD Power Down Register</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">LVDPWD</name>
                     <bitRange>[31:0]</bitRange>
                     <description>LVD Power Down Register bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PWDN</name>
                           <description>LVD off,Power down</description>
                           <value>0x55AAAA55</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>LVD enable</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CMP2PWD</name>
               <description>CMP2 Power Down Register</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CMP2PWD</name>
                     <bitRange>[31:0]</bitRange>
                     <description>CMP2 Power Down Register bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PWDN</name>
                           <description>cmp off,Power down</description>
                           <value>0xAA5555AA</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>cmp enable</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CMP1PWD</name>
               <description>CMP1 Power Down Register</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CMP1PWD</name>
                     <bitRange>[31:0]</bitRange>
                     <description>CMP1 Power Down Register bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PWDN</name>
                           <description>cmp off,Power down</description>
                           <value>0xA5A55A5A</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>cmp enable</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral derivedFrom="LVDCMP_CORE0">
         <name>LVDCMP_CORE1</name>
         <groupName>ANALOG</groupName>
         <baseAddress>0xA00BC000</baseAddress>
      </peripheral>
      <peripheral>
         <name>M2M_CORE0</name>
         <description>M2M module</description>
         <groupName>M2M</groupName>
         <baseAddress>0x20078000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x20</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>MODE</name>
               <description>M2M Mode Register.</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>IVLD</name>
                     <access>read-write</access>
                     <bitRange>[3:0]</bitRange>
                     <description>Set input data valid in byte.</description>
                  </field>
                  <field>
                     <name>OVLD</name>
                     <access>read-write</access>
                     <bitRange>[7:4]</bitRange>
                     <description>Set output data valid in byte.</description>
                  </field>
                  <field>
                     <name>ORV</name>
                     <access>read-write</access>
                     <bitRange>[8:8]</bitRange>
                     <description>Reverse output data in byte.</description>
                  </field>
                  <field>
                     <name>DUMMY</name>
                     <access>read-write</access>
                     <bitRange>[9:9]</bitRange>
                     <description>Enable set dummy value.</description>
                  </field>
                  <field>
                     <name>ADDRREV</name>
                     <access>read-write</access>
                     <bitRange>[10:10]</bitRange>
                     <description>Reverse data by address.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CTRL</name>
               <description>M2M Control Register.</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>EN</name>
                     <bitRange>[0:0]</bitRange>
                     <description>Enable M2M running</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DUMMY</name>
               <description>M2M invalid address Dummy value Register.</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>VAL</name>
                     <bitRange>[31:0]</bitRange>
                     <description>Set dummy value</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>SADDR</name>
               <description>M2M Source Data Address Register.</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>ADDR</name>
                     <bitRange>[16:0]</bitRange>
                     <description>Set source data address</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DADDR</name>
               <description>M2M Destination Data Address Register.</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>ADDR</name>
                     <bitRange>[16:0]</bitRange>
                     <description>Set destination data address</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>ILEN</name>
               <description>M2M Source Data Length Register.</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>LEN</name>
                     <bitRange>[16:0]</bitRange>
                     <description>Set data length</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IE</name>
               <description>M2M Interrupt Enable Register.</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>DONE</name>
                     <bitRange>[0:0]</bitRange>
                     <description>Enable M2M interrupt</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IF</name>
               <description>M2M Interrupt Flags Register.</description>
               <addressOffset>0x1C</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>DONE</name>
                     <bitRange>[0:0]</bitRange>
                     <description>Check M2M interrupt flag</description>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral derivedFrom="M2M_CORE0">
         <name>M2M_CORE1</name>
         <description>M2M module</description>
         <groupName>M2M</groupName>
         <baseAddress>0xA0078000</baseAddress>
      </peripheral>
      <peripheral>
         <name>MADC_CORE0</name>
         <description>ADC</description>
         <groupName>ANALOG</groupName>
         <baseAddress>0x200B8000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x44</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>AD_CTRL</name>
               <description>SAR ADC control register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>SAR_CH</name>
                     <bitRange>[2:0]</bitRange>
                     <description>SAR ADC channel selection bits(part1)</description>
                  </field>
                  <field>
                     <name>SAR_PGA</name>
                     <bitRange>[4:3]</bitRange>
                     <description>SAR ADC PGA selection bits(old configuration used for compatibility)</description>
                  </field>
                  <field enums="NO_ENUM">
                     <name>SAR_IE</name>
                     <bitRange>[5:5]</bitRange>
                     <description>SAR ADC interrupt enable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>do not generate interrupt request on SAR event</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>generate interrupt request on SAR event</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SAR_CH3</name>
                     <bitRange>[6:6]</bitRange>
                     <description>SAR ADC channel selection bits(part2)</description>
                  </field>
                  <field>
                     <name>SAR_WAIT</name>
                     <bitRange>[11:7]</bitRange>
                     <description>set SAR ADC duration config bits((SAR_WAIT+1)*30.5us) between enable and sample</description>
                  </field>
                  <field>
                     <name>REF_WAIT</name>
                     <bitRange>[16:12]</bitRange>
                     <description>set voltage reference duration config bits((REF_WAIT+1)*30.5us) between REF enable and ADC enable</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>AD_START</name>
               <description>SAR ADC start register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">AD_START</name>
                     <bitRange>[0:0]</bitRange>
                     <description>SAR ADC start control bit, =1 start sar-measure once</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>AD_STAT</name>
               <description>SAR ADC status register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>DREADY</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>SAR ADC data ready/pending flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PEND</name>
                           <description>SAR ADC data pending flag</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>READY</name>
                           <description>SAR ADC data ready flag</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TPS_BUSY</name>
                     <access>read-only</access>
                     <bitRange>[1:1]</bitRange>
                     <description>automatic temperature measurement busy flag</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>IDLE</name>
                           <description>no outstanding automatic temperature measurement</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BUSY</name>
                           <description>pending automatic temperature measurement</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>AD_DATA</name>
               <description>SAR ADC data register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">AD_DATA</name>
                     <bitRange>[9:0]</bitRange>
                     <description>SAR ADC result data bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>AD_CTRL1</name>
               <description>SAR ADC control register No.1</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>SAR_PGA</name>
                     <bitRange>[2:0]</bitRange>
                     <description>SAR ADC PGA config bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0P5</name>
                           <description>PGA select as 0.5</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1P0</name>
                           <description>PGA select as 1.0</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1P5</name>
                           <description>PGA select as 1.5</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2P0</name>
                           <description>PGA select as 2.0</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>0P25</name>
                           <description>PGA select as 0.25</description>
                           <value>4</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SAR_PGA_SEL</name>
                     <bitRange>[3:3]</bitRange>
                     <description>SAR ADC PGA selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CTRL_PGA</name>
                           <description>select AD_CTRL[4:3] PGA as PGA</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CTRL1_PGA</name>
                           <description>select AD_CTRL1[2:0] PGA as PGA</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SAR_CONVERT</name>
                     <bitRange>[14:8]</bitRange>
                     <description>SAR ADC simple to DOUT wait time config bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>AD_DATA2</name>
               <description>SAR ADC data register 2</description>
               <addressOffset>0x1C</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">AD_DATA2</name>
                     <bitRange>[11:0]</bitRange>
                     <description>SAR ADC 12 bit result data bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>AD_CTRL3</name>
               <description>SAR ADC control register No.3</description>
               <addressOffset>0x20</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>ACC_CNT</name>
                     <bitRange>[7:0]</bitRange>
                     <description>SAR ADC output data accumulation count configuration(for AD_DATA3)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>AD_DATA3</name>
               <description>SAR ADC data register 3</description>
               <addressOffset>0x24</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">AD_DATA3</name>
                     <bitRange>[15:0]</bitRange>
                     <description>SAR ADC 16 bit result data bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>ANA_RST_STAT</name>
               <description>ANA reset state register</description>
               <addressOffset>0x28</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>PORIF</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>POR reset interrupt flag(POR reset interrupt is a non-maskable interrupt)</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>BORIF</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>BOR reset interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>BORIE</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>BOR reset interrupt enable bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>ANA_PAD</name>
               <description>ANA_PAD register</description>
               <addressOffset>0x3C</addressOffset>
               <size>32</size>
               <fields>
                  <field enums="ALL_ENUM">
                     <name>PL01_AE</name>
                     <bitRange>[0:0]</bitRange>
                     <description>Enable bit for SAR AIN5 analog input</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>disable analog input</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>enable analog input</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="PL01_AE">
                     <name>PL02_AE</name>
                     <bitRange>[1:1]</bitRange>
                     <description>Enable bit for SAR AIN6 analog input</description>
                  </field>
                  <field derivedFrom="PL01_AE">
                     <name>PL03_AE</name>
                     <bitRange>[2:2]</bitRange>
                     <description>Enable bit for SAR AIN7 analog input</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>ANA_RST</name>
               <description>VBAT soft reset register</description>
               <addressOffset>0x40</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>ANA_RST</name>
                     <bitRange>[7:0]</bitRange>
                     <description>Reset all resetable register of VBAT</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>RST</name>
                           <description>Reset all resetable register of VBAT</description>
                           <value>0xA8</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>Do not reset</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PS</name>
                     <bitRange>[15:8]</bitRange>
                     <description>password cfg bits of ANA_RST</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PS</name>
                           <description>password of ANA_RST</description>
                           <value>0xA5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>disable [7:0]write</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral derivedFrom="MADC_CORE0">
         <name>MADC_CORE1</name>
         <description>ADC</description>
         <baseAddress>0xA00B8000</baseAddress>
      </peripheral>
      <peripheral>
         <name>MAILBOX_CORE0</name>
         <description>MAILBOX Module core0</description>
         <groupName>MAILBOX_CORE0</groupName>
         <baseAddress>0x3000C000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x0304</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>CSR</name>
               <description>Control/Status Register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>MBX_IN_FULL</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Input mailbox status bit. For CORE0: Write 1 to clear input mailbox status. For CORE1: Write 1 to indicate input mailbox full, set INTST.MBX_IFRE</description>
                  </field>
                  <field>
                     <name>MBX_OUT_FULL</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>Output mailbox status bit.For CORE0: Write 1 to indicate output mailbox full, sets INTST.MBX_DONE. For CORE1: Write 1 to clear output mailbox status.</description>
                  </field>
                  <field>
                     <name>MBX_LINK</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>Write 1 to connect mailbox channel. If successful, this bit sets automatically to 1 (only core1 can access).</description>
                  </field>
                  <field>
                     <name>MBX_ALB_UNLINK</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>Write 1 to disconnect from mailbox and clear CSR.MBX_LINK bit (only core1 can access).</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>RESET</name>
               <description>Reset Register (only core0 can access)</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>MBX_OUT_EMPTY</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>CORE0 writes 1 to this bit to clear CSR.MBX_OUT_FULL.</description>
                  </field>
                  <field>
                     <name>MBX_UNLINK</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>CORE0 writes 1 to this bit to clear CSR.MBX_LINKED bit and disconnect CORE1 from mailbox.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>LINKID</name>
               <description>Connection Host ID Register</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>ID</name>
                     <bitRange>[0:0]</bitRange>
                     <description>Read back the host ID number that has connected to the input mailbox</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>LOCKOUT</name>
               <description>Lockout Register</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>MBX</name>
                     <bitRange>[0:0]</bitRange>
                     <description>Mailbox lock status, accessible only by CORE1</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>INTEN</name>
               <description>CORE0/CORE1 Interrupt Enable Register</description>
               <addressOffset>0x38</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>MBX_IFRE</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>CORE0(CORE1) input mailbox full(empty) interrupt enable.</description>
                  </field>
                  <field>
                     <name>MBX_DONE</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>CORE0(CORE1) output mailbox empty(full) interrupt enable.</description>
                  </field>
                  <field>
                     <name>MBX_LINKABLE</name>
                     <access>read-write</access>
                     <bitRange>[16:16]</bitRange>
                     <description>CORE1 mailbox connectable interrupt enable.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>INTST</name>
               <description>CORE0/CORE1 Interrupt Status Register</description>
               <addressOffset>0x3C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>MBX_IFRE</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Input mailbox interrupt flag.</description>
                  </field>
                  <field>
                     <name>MBX_DONE</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>Output mailbox interrupt flag</description>
                  </field>
                  <field>
                     <name>MBX_LINKABLE</name>
                     <access>read-write</access>
                     <bitRange>[16:16]</bitRange>
                     <description>CORE1 mailbox connectable interrupt flag</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>OPT</name>
               <description>Internal Configuration Status Register</description>
               <addressOffset>0x5C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>MBX_NUM</name>
                     <access>read-only</access>
                     <bitRange>[3:0]</bitRange>
                     <description>Indicates number of existing input/output mailbox pairs, Current system only has 1 mailbox pair, hardware fixed to 1</description>
                  </field>
                  <field>
                     <name>MBX_SIZE</name>
                     <access>read-only</access>
                     <bitRange>[5:4]</bitRange>
                     <description>Hardware-specified actual implementation size of each input/output mailbox</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>128BYTE</name>
                           <description>128Bytes</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>256BYTE</name>
                           <description>256Bytes (default)</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>512BYTE</name>
                           <description>512Bytes</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1024BYTE</name>
                           <description>1024Bytes</description>
                           <value>0x3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ACTIVE_HOST_N</name>
                     <access>read-only</access>
                     <bitRange>[7:6]</bitRange>
                     <description>Indicates number of cores that can connect to mailbox. Current system only has CORE1</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>FROZE</name>
               <description>Freeze Host Access Configuration Register (only core0 can access)</description>
               <addressOffset>0x60</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">FROZE</name>
                     <bitRange>[31:0]</bitRange>
                     <description>CORE0 writes 1 to lock the core number that can access MAILBOX registers</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>ID_VAL</name>
               <description>Accessible Host ID Register (only core0 can access)</description>
               <addressOffset>0x64</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">ID_VAL</name>
                     <bitRange>[0:0]</bitRange>
                     <description>Written by CORE0 with the core host_id number that can access MAILBOX registers (CORE1 core host_id is 0)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>ID_MASK</name>
               <description>Accessible Host ID Mask Register (only core0 can access)</description>
               <addressOffset>0xE4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>MASK</name>
                     <bitRange>[0:0]</bitRange>
                     <description>Written by CORE0 with the core host_id mask that can access MAILBOX registers</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>MBX_KEY0</name>
               <description>CORE0 Password Register (only core0 can access)</description>
               <addressOffset>0x300</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">MBX_KEY0</name>
                     <bitRange>[31:0]</bitRange>
                     <description>CORE0 writes password register, password is 0xA538E827</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>MBX_KEY1</name>
               <description>CORE1 Password Register (only core1 can access)</description>
               <addressOffset>0x304</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">MBX_KEY1</name>
                     <bitRange>[31:0]</bitRange>
                     <description>CORE1 writes password register, password is 0xA538EC63</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>MESSAGE</name>
               <description>Mailbox Message Register. 256 Bytes SRAM.</description>
               <addressOffset>0x2000</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>MSG</name>
                     <bitRange>[31:0]</bitRange>
                     <description>256 Bytes Mailbox Message SRAM</description>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral derivedFrom="MAILBOX_CORE0">
         <name>MAILBOX_CORE1</name>
         <description>MAILBOX Module core1</description>
         <groupName>MAILBOX_CORE1</groupName>
         <baseAddress>0xB000C000</baseAddress>
      </peripheral>
      <peripheral>
         <name>QSPI0</name>
         <description>QSPI0 Module</description>
         <groupName>QSPI</groupName>
         <baseAddress>0xB0088000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x0088</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>SCKDIV</name>
               <description>Clock Divisor Register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">SCKDIV</name>
                     <bitRange>[11:0]</bitRange>
                     <description>Clock divisor factor selection bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>SCKMODE</name>
               <description>Clock Mode Register (Master/Slave)</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CPHA</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Clock (SCK) Phase selection bit. In DDR mode, only CPHA=0 is supported</description>
                  </field>
                  <field>
                     <name>CPOL</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>Clock (SCK) Polarity selection bit.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>SCKSAMPLE</name>
               <description>Sample Point Configuration Register (DDR Mode)</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>SCKSMP</name>
                     <bitRange>[11:0]</bitRange>
                     <description>DDR Mode SCK sample point delay selection bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>FORCE</name>
               <description>Pin Output Force Register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>FORCE_EN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Force output enable for non-data pins in different interface modes.</description>
                  </field>
                  <field>
                     <name>FORCE_WP</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>WP (IO2) pin output state selection bit (when not used as data line). Invalid in Quad-line mode.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CSID</name>
               <description>Chip Select ID Register</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CSID</name>
                     <bitRange>[2:0]</bitRange>
                     <description>Chip Select device ID selection bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CSDEF</name>
               <description>Chip Select Default Value Register</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CSDEF</name>
                     <bitRange>[0:0]</bitRange>
                     <description>CS0 default (idle) state selection bit (Master mode)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CSMODE</name>
               <description>Chip Select Mode Register</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CSMODE</name>
                     <access>read-write</access>
                     <bitRange>[1:0]</bitRange>
                     <description>Chip Select mode selection bits. Use Hold mode for continuous data transfer, switch to Disable mode after transfer completes.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>AUTO</name>
                           <description>Auto mode</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HOLD</name>
                           <description>Hold mode</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DISABLE</name>
                           <description>Disable mode</description>
                           <value>0x3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>VERSION</name>
               <description>Version Register</description>
               <addressOffset>0x1C</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">VERSION</name>
                     <bitRange>[31:0]</bitRange>
                     <description>QSPI Version 2.1.0</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>ADDR_WRAP</name>
               <description>SPI Flash Start Address Offset Register</description>
               <addressOffset>0x20</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>OFFSET</name>
                     <bitRange>[31:0]</bitRange>
                     <description>SPI Flash start address offset value</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>BOUNDARY_CFG</name>
               <description>SPI Flash Address Boundary Configuration Register</description>
               <addressOffset>0x24</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>BOUNDARY</name>
                     <bitRange>[31:0]</bitRange>
                     <description>XIP boundary address configuration register</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DELAY0</name>
               <description>Delay Control Register 0</description>
               <addressOffset>0x28</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CSSCK</name>
                     <access>read-write</access>
                     <bitRange>[7:0]</bitRange>
                     <description>Delay cycles from CS assertion (falling edge) to first valid SCK rising edge.</description>
                  </field>
                  <field>
                     <name>SCKCS</name>
                     <access>read-write</access>
                     <bitRange>[23:16]</bitRange>
                     <description>Delay cycles from last valid SCK edge to CS deassertion (rising edge).</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DELAY1</name>
               <description>Delay Control Register 1</description>
               <addressOffset>0x2C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>INTERCS</name>
                     <access>read-write</access>
                     <bitRange>[7:0]</bitRange>
                     <description>Minimum delay cycles from CS deassertion (rising edge) to next CS assertion (falling edge).</description>
                  </field>
                  <field>
                     <name>INTERXFR</name>
                     <access>read-write</access>
                     <bitRange>[23:16]</bitRange>
                     <description>Delay cycles between two data frames.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>FIFO_NUM</name>
               <description>FIFO Valid Data Count Register</description>
               <addressOffset>0x30</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TX_NUM</name>
                     <access>read-only</access>
                     <bitRange>[2:0]</bitRange>
                     <description>TX FIFO valid data count.</description>
                  </field>
                  <field>
                     <name>RX_NUM</name>
                     <access>read-only</access>
                     <bitRange>[18:16]</bitRange>
                     <description>RX FIFO valid data count.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TSIZE</name>
               <description>DMA Transfer Data Length Register.</description>
               <addressOffset>0x34</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">TSIZE</name>
                     <bitRange>[31:0]</bitRange>
                     <description>transfer data length (in beats)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>RSIZE</name>
               <description>DMA Receive Data Length Register.</description>
               <addressOffset>0x38</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">RSIZE</name>
                     <bitRange>[31:0]</bitRange>
                     <description>receive data length (in beats).</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>FMT</name>
               <description>Frame Format Register (Master/Slave, Non-XIP Mode)</description>
               <addressOffset>0x40</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>PROTO</name>
                     <access>read-write</access>
                     <bitRange>[1:0]</bitRange>
                     <description>Interface mode (number of data lines) selection bits.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SINGLE</name>
                           <description>Single-line mode</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DUAL</name>
                           <description>Dual-line mode</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>QUAD</name>
                           <description>Quad-line mode</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HALF_DUPLEX</name>
                           <description>Single-line Half-duplex mode</description>
                           <value>0x3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ENDIAN</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>Bit endianness (transmission order within byte).</description>
                  </field>
                  <field>
                     <name>DIR</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>Pin data transfer direction selection bit (for configurable I/O pins).</description>
                  </field>
                  <field>
                     <name>PROTO_HI</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>High bit extension for QSPI_FMT.PROTO[1:0] (See PROTO below).</description>
                  </field>
                  <field>
                     <name>ENDIAN_BYTE</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>Byte endianness (transmission order within 32-bit word).</description>
                  </field>
                  <field>
                     <name>LEN</name>
                     <access>read-write</access>
                     <bitRange>[21:16]</bitRange>
                     <description>Frame data bit width selection bits. Master mode supports 4-32 bits, Slave mode supports 8/16/32 bits.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>8BIT</name>
                           <description>Data length for SPI transfer: 8 bits</description>
                           <value>8</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>16BIT</name>
                           <description>Data length for SPI transfer: 16 bits</description>
                           <value>16</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>32BIT</name>
                           <description>Data length for SPI transfer: 32 bits</description>
                           <value>32</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>TXDATA</name>
               <description>Transmit Data Register (Master/Slave)</description>
               <addressOffset>0x48</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">TXDATA</name>
                     <bitRange>[31:0]</bitRange>
                     <description>Transmit data buffer. Valid data width depends on QSPI_FMT.LEN register configuration.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>RXDATA</name>
               <description>Receive Data Register (Master/Slave)</description>
               <addressOffset>0x4C</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">RXDATA</name>
                     <bitRange>[31:0]</bitRange>
                     <description>Receive data buffer. Valid data width depends on QSPI_FMT.LEN register configuration.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TX_MARK</name>
               <description>Transmit FIFO Threshold Register (Master/Slave)</description>
               <addressOffset>0x50</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TX_MARK</name>
                     <access>read-write</access>
                     <bitRange>[2:0]</bitRange>
                     <description>ransmit FIFO threshold selection bit. Interrupt flag tx_irq is raised when TX FIFO valid data count is less than this threshold.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>1</name>
                           <description>1 valid data item</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2</name>
                           <description>2 valid data items</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3</name>
                           <description>3 valid data items</description>
                           <value>0x3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4</name>
                           <description>4 valid data items</description>
                           <value>0x4</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>RX_MARK</name>
               <description>Receive FIFO Threshold Register (Master/Slave)</description>
               <addressOffset>0x54</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>RX_MARK</name>
                     <access>read-write</access>
                     <bitRange>[2:0]</bitRange>
                     <description>Receive FIFO threshold selection bit. Interrupt flag rx_irq is raised when RX FIFO valid data count exceeds this threshold.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>0 valid data item</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>1 valid data item</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2</name>
                           <description>2 valid data items</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3</name>
                           <description>3 valid data items</description>
                           <value>0x3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>FCTRL</name>
               <description>SPI Flash Interface Control Register (XIP)</description>
               <addressOffset>0x60</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>FLASH_EN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>XIP Mode Enable bit.</description>
                  </field>
                  <field>
                     <name>FLASH_WMASK_EN</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>Measurement Mode</description>
                  </field>
                  <field>
                     <name>FLASH_WEN</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>Measurement Start Point</description>
                  </field>
                  <field>
                     <name>FLASH_BURST_EN</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>Measurement End Point</description>
                  </field>
                  <field>
                     <name>FLASH_WRAP_EN</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>Data value for fixed data measurement mode. The measurement register is updated only when this data is received</description>
                  </field>
                  <field>
                     <name>BOUNDRY_EN</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>XIP Mode Boundary Address Enable bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>FFMT</name>
               <description>SPI Flash Command Format Register (XIP)</description>
               <addressOffset>0x64</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CMD_EN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Instruction Send Enable bit.</description>
                  </field>
                  <field>
                     <name>ADDR_LEN</name>
                     <access>read-write</access>
                     <bitRange>[3:1]</bitRange>
                     <description>Address Length selection bits.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NONE</name>
                           <description>Skip Address phase</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>8BIT</name>
                           <description>Address Length 8 bits</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>16BIT</name>
                           <description>Address Length 16 bits</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>24BIT</name>
                           <description>Address Length 24 bits (default)</description>
                           <value>0x3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>32BIT</name>
                           <description>Address Length 32 bits</description>
                           <value>0x4</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RPAD_CNT</name>
                     <access>read-write</access>
                     <bitRange>[7:4]</bitRange>
                     <description>Read instruction dummy cycle count selection bits (Lower 4 bits). The 5th bit (MSB) of RPAD_CNT is configured in FFMT1.RPAD_CNT_H.</description>
                  </field>
                  <field>
                     <name>CMD_PROTO</name>
                     <access>read-write</access>
                     <bitRange>[9:8]</bitRange>
                     <description>Command Phase Interface Mode selection bits.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SINGLE</name>
                           <description>XIP Command Single-line mode</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DUAL</name>
                           <description>XIP Command Dual-line mode</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>QUAD</name>
                           <description>XIP Command Quad-line mode</description>
                           <value>0x2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ADDR_PROTO</name>
                     <access>read-write</access>
                     <bitRange>[11:10]</bitRange>
                     <description>Address Phase Interface Mode selection bits.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SINGLE</name>
                           <description>XIP Address Single-line mode</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DUAL</name>
                           <description>XIP Address Dual-line mode</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>QUAD</name>
                           <description>XIP Address Quad-line mode</description>
                           <value>0x2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DATA_PROTO</name>
                     <access>read-write</access>
                     <bitRange>[13:12]</bitRange>
                     <description>Data Phase Interface Mode selection bits.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SINGLE</name>
                           <description>XIP Data Single-line mode</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DUAL</name>
                           <description>XIP Data Dual-line mode</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>QUAD</name>
                           <description>XIP Data Quad-line mode</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HALF_DUPLEX</name>
                           <description>XIP Data Single-line Half-duplex mode</description>
                           <value>0x3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ENDIAN_F</name>
                     <access>read-write</access>
                     <bitRange>[14:14]</bitRange>
                     <description>XIP Mode bit endianness (transmission order within byte). This bit does not change byte order, only the bit order within a single byte.</description>
                  </field>
                  <field>
                     <name>DATA_PROTO_HI</name>
                     <access>read-write</access>
                     <bitRange>[15:15]</bitRange>
                     <description>High bit extension for QSPI_FFMT.DATA_PROTO[1:0] (See DATA_PROTO).</description>
                  </field>
                  <field>
                     <name>RCMD_CODE</name>
                     <access>read-write</access>
                     <bitRange>[23:16]</bitRange>
                     <description>SPI Flash Read Instruction Opcode.</description>
                  </field>
                  <field>
                     <name>PAD_CODE</name>
                     <access>read-write</access>
                     <bitRange>[31:24]</bitRange>
                     <description>First 8 bits of data transmitted during dummy cycles.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IE</name>
               <description>Interrupt Enable Register (Master/Slave)</description>
               <addressOffset>0x70</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TX_IRQ_EN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Transmit FIFO Threshold Interrupt Enable bit</description>
                  </field>
                  <field>
                     <name>RX_IRQ_EN</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>Receive FIFO Threshold Interrupt Enable bit.</description>
                  </field>
                  <field>
                     <name>TX_UDR_EN</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>Transmit FIFO Underflow Interrupt Enable bit.</description>
                  </field>
                  <field>
                     <name>RX_OVR_EN</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>Receive FIFO Overflow Interrupt Enable bit.</description>
                  </field>
                  <field>
                     <name>RX_UDR_EN</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>Receive FIFO Underflow Interrupt Enable bit.</description>
                  </field>
                  <field>
                     <name>TX_OVR_EN</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>Transmit FIFO Overflow Interrupt Enable bit.</description>
                  </field>
                  <field>
                     <name>DONE_EN</name>
                     <access>read-write</access>
                     <bitRange>[7:7]</bitRange>
                     <description>Transfer Done Interrupt Enable bit.</description>
                  </field>
                  <field>
                     <name>TX_DONE_EN</name>
                     <access>read-write</access>
                     <bitRange>[11:11]</bitRange>
                     <description>(DMA) Transmit Done Interrupt Enable bit.</description>
                  </field>
                  <field>
                     <name>RX_DONE_EN</name>
                     <access>read-write</access>
                     <bitRange>[12:12]</bitRange>
                     <description>(DMA) Receive Done Interrupt Enable bit.</description>
                  </field>
                  <field>
                     <name>CFG_ERR_EN</name>
                     <access>read-write</access>
                     <bitRange>[14:14]</bitRange>
                     <description>Configuration Frame Error Interrupt Enable bit.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IP</name>
               <description>Interrupt Pending Register (Master/Slave)</description>
               <addressOffset>0x74</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TX_IRQ</name>
                     <access>read-only</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Transmit FIFO Threshold Interrupt Flag. Set when TX FIFO valid data count is less than TX_MARK threshold.</description>
                  </field>
                  <field>
                     <name>RX_IRQ</name>
                     <access>read-only</access>
                     <bitRange>[1:1]</bitRange>
                     <description>Receive FIFO Threshold Interrupt Flag. Set when RX FIFO valid data count exceeds RX_MARK threshold.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>FFMT1</name>
               <description>SPI Flash Command Format Register 1 (XIP)</description>
               <addressOffset>0x78</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>WCMD_CODE</name>
                     <access>read-write</access>
                     <bitRange>[7:0]</bitRange>
                     <description>SPI Flash Write Instruction Opcode.</description>
                  </field>
                  <field>
                     <name>WPAD_CNT</name>
                     <access>read-write</access>
                     <bitRange>[12:8]</bitRange>
                     <description>Write instruction dummy cycle count selection bits.</description>
                  </field>
                  <field>
                     <name>RPAD_CNT_H</name>
                     <access>read-write</access>
                     <bitRange>[13:13]</bitRange>
                     <description>High bit (Bit 4) for read instruction dummy cycle count selection. Lower 4 bits are in FFMT.RPAD_CNT.</description>
                  </field>
                  <field>
                     <name>DDR_EN</name>
                     <access>read-write</access>
                     <bitRange>[17:14]</bitRange>
                     <description>DDR Enable bits for different phases: Instruction[14], Address[15], Mode[16], Data[17].</description>
                  </field>
                  <field>
                     <name>MODE_PROTO</name>
                     <access>read-write</access>
                     <bitRange>[19:18]</bitRange>
                     <description>Mode Byte Phase Interface Mode selection bits.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SINGLE</name>
                           <description>XIP Mode Single-line mode</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DUAL</name>
                           <description>XIP Mode Dual-line mode</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>QUAD</name>
                           <description>XIP Mode Quad-line mode</description>
                           <value>0x2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MODE_CODE</name>
                     <access>read-write</access>
                     <bitRange>[27:20]</bitRange>
                     <description>SPI Flash Mode Byte.</description>
                  </field>
                  <field>
                     <name>MODE_CNT</name>
                     <access>read-write</access>
                     <bitRange>[31:28]</bitRange>
                     <description>Mode Byte Length selection bits.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>STA</name>
               <description>Status Register</description>
               <addressOffset>0x7C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>BUSY</name>
                     <access>read-only</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Transfer Busy Flag (Master/Slave)</description>
                  </field>
                  <field>
                     <name>RX_OVR_ERR</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>Receive FIFO Overflow Error Flag.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TX_UDR_ERR</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>Transmit FIFO Underflow Error Flag.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TX_FULL</name>
                     <access>read-only</access>
                     <bitRange>[4:4]</bitRange>
                     <description>Transmit FIFO Full Flag.</description>
                  </field>
                  <field>
                     <name>RX_EMPTY</name>
                     <access>read-only</access>
                     <bitRange>[5:5]</bitRange>
                     <description>Receive FIFO Empty Flag.</description>
                  </field>
                  <field>
                     <name>RX_UDR_ERR</name>
                     <access>read-write</access>
                     <bitRange>[9:9]</bitRange>
                     <description>Receive FIFO Underflow Error Flag. Set if QSPI_RXDATA is read while RX FIFO is empty.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TX_OVR_ERR</name>
                     <access>read-write</access>
                     <bitRange>[10:10]</bitRange>
                     <description>Transmit FIFO Overflow Error Flag. Set if QSPI_TXDATA is written while TX FIFO is full.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TX_EMPTY</name>
                     <access>read-only</access>
                     <bitRange>[11:11]</bitRange>
                     <description>Transmit FIFO Empty Flag.</description>
                  </field>
                  <field>
                     <name>RX_FULL</name>
                     <access>read-only</access>
                     <bitRange>[12:12]</bitRange>
                     <description>Receive FIFO Full Flag.</description>
                  </field>
                  <field>
                     <name>DONE</name>
                     <access>read-write</access>
                     <bitRange>[13:13]</bitRange>
                     <description>Transfer Done Flag. Set when a data transfer is complete (send/receive finished) and TX FIFO is empty.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TX_DONE</name>
                     <access>read-write</access>
                     <bitRange>[17:17]</bitRange>
                     <description>DMA Transmit Done Flag. Set when transmitted data count reaches TSIZE.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RX_DONE</name>
                     <access>read-write</access>
                     <bitRange>[18:18]</bitRange>
                     <description>DMA Receive Done Flag. Set when received data count reaches RSIZE.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>CFG_ERR</name>
                     <access>read-write</access>
                     <bitRange>[20:20]</bitRange>
                     <description>Frame Configuration Error Flag. Set when a frame config error occurs in normal QSPI or XIP mode.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>SDR_SCKSAMPLE</name>
               <description>Sample Point Configuration Register (SDR Mode)</description>
               <addressOffset>0x80</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">SDR_SCKSAMPLE</name>
                     <bitRange>[11:0]</bitRange>
                     <description>SDR Mode SCK sample point delay selection bit.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CR</name>
               <description>Control Register</description>
               <addressOffset>0x84</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>MSTER</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Master/Slave Mode Selection bit.</description>
                  </field>
                  <field>
                     <name>DMA_EN</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>DMA Mode Enable bit.</description>
                  </field>
                  <field>
                     <name>DDR_EN</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>DDR Mode Enable bit (Master mode only).</description>
                  </field>
                  <field>
                     <name>CSI</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>Software-controlled Chip Select state (Slave mode, valid when SSM=1).</description>
                  </field>
                  <field>
                     <name>CSOE</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>Master Mode Chip Select Output Enable bit.</description>
                  </field>
                  <field>
                     <name>SSM</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>Software Slave Management (CS) Enable bit.</description>
                  </field>
                  <field>
                     <name>DMA_TX_EN</name>
                     <access>read-write</access>
                     <bitRange>[8:8]</bitRange>
                     <description>Transmit DMA Mode Enable bit.</description>
                  </field>
                  <field>
                     <name>DMA_RX_EN</name>
                     <access>read-write</access>
                     <bitRange>[9:9]</bitRange>
                     <description>Receive DMA Mode Enable bit.</description>
                  </field>
                  <field>
                     <name>DMA_RXCT_MODE</name>
                     <access>read-write</access>
                     <bitRange>[10:10]</bitRange>
                     <description>DMA Continuous Receive Mode Enable bit.</description>
                  </field>
                  <field>
                     <name>DMA_TXCT_MODE</name>
                     <access>read-write</access>
                     <bitRange>[11:11]</bitRange>
                     <description>DMA Continuous Transmit Mode Enable bit.</description>
                  </field>
                  <field>
                     <name>SPI_RXFIFO_EN</name>
                     <access>read-write</access>
                     <bitRange>[13:13]</bitRange>
                     <description>Receive FIFO Enable bit.</description>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral derivedFrom="QSPI0">
         <name>QSPI1</name>
         <description>QSPI1 Module</description>
         <groupName>QSPI</groupName>
         <baseAddress>0xB008C000</baseAddress>
      </peripheral>
      <peripheral>
         <name>RTC_CORE0</name>
         <description>real time clock</description>
         <baseAddress>0x200B4000</baseAddress>
         <registers>
            <register>
               <name>CTRL</name>
               <description>control register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>FOUT</name>
                     <access>read-write</access>
                     <bitRange>[2:0]</bitRange>
                     <description>RTC output frequency selections FOUT bits.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>RTCOUT forbidden</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PLLOUT</name>
                           <description>select RTCOUT as PLL, freq depend on PLLOUT_SEL</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1_30HZ</name>
                           <description>select RTCOUT as LOSC, frequency of 1/30Hz</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>32KHZ</name>
                           <description>select RTCOUT as LOSC, frequency of 32768Hz</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>16HZ</name>
                           <description>select RTCOUT as LOSC, frequency of 16Hz</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>8HZ</name>
                           <description>select RTCOUT as LOSC, frequency of 8Hz</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4HZ</name>
                           <description>select RTCOUT as LOSC, frequency of 4Hz</description>
                           <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1HZ</name>
                           <description>select RTCOUT as LOSC, frequency of 1Hz</description>
                           <value>7</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TCP</name>
                     <access>read-write</access>
                     <bitRange>[5:3]</bitRange>
                     <description>temperature compensation period bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>2S</name>
                           <description>select temperature compensation period as 2 second(or 0.5s for 8025T)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>10S</name>
                           <description>select temperature compensation period as 10 second(or 2s for 8025T)</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>20S</name>
                           <description>select temperature compensation period as 20 second(or 10s for 8025T)</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>30S</name>
                           <description>select temperature compensation period as 30 second(or 30s for 8025T)</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1MIN</name>
                           <description>select temperature compensation period as 1 minute(not for 8025T)</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2MIN</name>
                           <description>select temperature compensation period as 2 minute(not for 8025T)</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>5MIN</name>
                           <description>select temperature compensation period as 5 minute(not for 8025T)</description>
                           <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>10MIN</name>
                           <description>select temperature compensation period as 10 minute(not for 8025T)</description>
                           <value>7</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TSE</name>
                     <access>read-write</access>
                     <bitRange>[7:6]</bitRange>
                     <description>temparature compentation mode selection config bits.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>disable automatic temperature compensation</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>AUTOEN</name>
                           <description>enable automatic cyclic temperature compensation</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>USER0EN</name>
                           <description>enable user mode 0, automatic temperature compensation triggered by setting temperature(temperature set by user)</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>USER1EN</name>
                           <description>enable user mode 1, automatic temperature compensation triggered by setting temperature(temperature unchangeable)</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WRTC</name>
                     <access>read-write</access>
                     <bitRange>[8:8]</bitRange>
                     <description>RTC register write enable/disable bit(controls offset 0x00-0x1C/0x3C/0xC4/0x168, except this field.)</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>RTC register set as read_only</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>RTC register set as writable</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WRBUSY</name>
                     <access>read-only</access>
                     <bitRange>[9:9]</bitRange>
                     <description>RTC register writing busy flag (RTC register only can be changed or set when Wr_busy is 0)</description>
                  </field>
                  <field>
                     <name>CALBUSY</name>
                     <access>read-only</access>
                     <bitRange>[10:10]</bitRange>
                     <description>RTC calibration busy flag</description>
                  </field>
                  <field>
                     <name>STF_TRIG</name>
                     <access>write-only</access>
                     <bitRange>[12:12]</bitRange>
                     <description>software time freeze trigger bit(freezed timestamp will be save to 0x120~0x12C)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>SC</name>
               <description>seconds register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">SC</name>
                     <bitRange>[6:0]</bitRange>
                     <description>seconds bits (BCD format, SC[6:4] standing for 10 seconds,SC[3:0] standing seconds)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>MN</name>
               <description>minutes register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">MN</name>
                     <bitRange>[6:0]</bitRange>
                     <description>minutes bits (BCD format, MN[6:4] standing for 10 minutes,MN[3:0] standing for minutes)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>HR</name>
               <description>hours register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">HR</name>
                     <bitRange>[5:0]</bitRange>
                     <description>hours bits (BCD format, HR[5:4] standing for 10 hours,HR[3:0] standing for hours)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DT</name>
               <description>date register</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">DT</name>
                     <bitRange>[5:0]</bitRange>
                     <description>date bits (BCD format, DT[5:4] standing for 10 date,DT[3:0] standing for date)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>MO</name>
               <description>month register</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">MO</name>
                     <bitRange>[4:0]</bitRange>
                     <description>month bits (BCD format, MO[5] standing for 10 month,MO[3:0] standing for month)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>YR</name>
               <description>year register</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">YR</name>
                     <bitRange>[7:0]</bitRange>
                     <description>year bits (BCD format, YR[7:4] standing for 10 year,YR[3:0] standing for year)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DW</name>
               <description>day of the week register</description>
               <addressOffset>0x1C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">DW</name>
                     <bitRange>[2:0]</bitRange>
                     <description>day of the week bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CNT1</name>
               <description>RTC counter1 register</description>
               <addressOffset>0x20</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CNT</name>
                     <bitRange>[7:0]</bitRange>
                     <description>RTC counter1 perset value bits(set CNT1 flag every (CNT+1) seconds)</description>
                  </field>
                  <field>
                     <name>PD</name>
                     <bitRange>[8:8]</bitRange>
                     <description>RTC CNT1 ON/OFF control bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ON</name>
                           <description>counter1 on (from perpetual calendar second interrupt)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>counter1 off, reset the counter value and restart</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DBGSTB</name>
                     <bitRange>[10:10]</bitRange>
                     <description>RTC_CNT1 debugmode halt counting enable/disable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PAUSE</name>
                           <description>halt counting when SoC halted by debugger</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>COUNTINUE</name>
                           <description>keep counting when SoC halted by debugger</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CNT2</name>
               <description>RTC counter2 register</description>
               <addressOffset>0x24</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CNT</name>
                     <bitRange>[7:0]</bitRange>
                     <description>RTC counter2 perset value bits(set counter2 flag every (CNT+1)/256 seconds)</description>
                  </field>
                  <field>
                     <name>PD</name>
                     <bitRange>[8:8]</bitRange>
                     <description>RTC CNT2 ON/OFF control bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ON</name>
                           <description>counter2 on(from internal 1/256 s interrupt)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>counter2 off, reset the counter value</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CLK_SEL</name>
                     <bitRange>[9:9]</bitRange>
                     <description>CNT2 CLK selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>LOSC</name>
                           <description>select LOSC as clock source of cnt2</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RCL</name>
                           <description>select RCL as clock source of cnt2</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DBGSTB</name>
                     <bitRange>[10:10]</bitRange>
                     <description>RTC_CNT2 debugmode halt counting enable/disable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PAUSE</name>
                           <description>halt counting when SoC halted by debugger</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>COUNTINUE</name>
                           <description>keep counting when SoC halted by debugger</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>SCA</name>
               <description>alarm seconds register</description>
               <addressOffset>0x28</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">SCA</name>
                     <bitRange>[6:0]</bitRange>
                     <description>alarm seconds bits (BCD format,SCA[6:4] standing for 10 seconds,SCA[3:0] standing for seconds)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>MNA</name>
               <description>alarm minitues register</description>
               <addressOffset>0x2C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">MNA</name>
                     <bitRange>[6:0]</bitRange>
                     <description>alarm minitues bits (BCD format,MNA[6:4] standing for 10 minitues,MNA[3:0] standing for minitues)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>HRA</name>
               <description>alarm hours register</description>
               <addressOffset>0x30</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">HRA</name>
                     <bitRange>[5:0]</bitRange>
                     <description>alarm hours bits (BCD format,MNA[5:4] standing for 10 hours,MNA[3:0] standing for hours)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IE</name>
               <description>interrupt enable register</description>
               <addressOffset>0x34</addressOffset>
               <size>32</size>
               <fields>
                  <field enums="NO_ENUM">
                     <name>ALMIE</name>
                     <bitRange>[0:0]</bitRange>
                     <description>alarm interrupt enable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>enable</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>disable</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="ALMIE">
                     <name>CNT1IE</name>
                     <bitRange>[1:1]</bitRange>
                     <description>RTC counter1 interrupt enable bit</description>
                  </field>
                  <field derivedFrom="ALMIE">
                     <name>CNT2IE</name>
                     <bitRange>[2:2]</bitRange>
                     <description>RTC counter2 interrupt enable bit</description>
                  </field>
                  <field derivedFrom="ALMIE">
                     <name>SCIE</name>
                     <bitRange>[3:3]</bitRange>
                     <description>sencond interrupt enable bit</description>
                  </field>
                  <field derivedFrom="ALMIE">
                     <name>MNIE</name>
                     <bitRange>[4:4]</bitRange>
                     <description>minute interrupt enable bit</description>
                  </field>
                  <field derivedFrom="ALMIE">
                     <name>HRIE</name>
                     <bitRange>[5:5]</bitRange>
                     <description>hour interrupt enable bit</description>
