                     <description>(Infrared Clock: RCL to LOSC) software switch to source clock</description>
                  </field>
                  <field>
                     <name>CLK6_SWH0</name>
                     <access>write-only</access>
                     <bitRange>[14:14]</bitRange>
                     <description>(System clock: RCL to LOSC) software switch to source clock</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CLKSEL</name>
               <description>Clock selected register, indicate the selected clock</description>
               <addressOffset>0x24</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CLKSEL0</name>
                     <access>read-only</access>
                     <bitRange>[0:0]</bitRange>
                     <description>(System clock: PLL to RCH) Indicate the current clock selection, source clock or backup clock</description>
                  </field>
                  <field>
                     <name>CLKSEL1</name>
                     <access>read-only</access>
                     <bitRange>[1:1]</bitRange>
                     <description>(PLL source: LOSC to RCL) Indicate the current clock selection, source clock or backup clock</description>
                  </field>
                  <field>
                     <name>CLKSEL2</name>
                     <access>read-only</access>
                     <bitRange>[2:2]</bitRange>
                     <description>(KBI Clock: LOSC to RCL) Indicate the current clock selection, source clock or backup clock</description>
                  </field>
                  <field>
                     <name>CLKSEL3</name>
                     <access>read-only</access>
                     <bitRange>[3:3]</bitRange>
                     <description>(LPUART Clock: LOSC to RCL) Indicate the current clock selection, source clock or backup clock</description>
                  </field>
                  <field>
                     <name>CLKSEL4</name>
                     <access>read-only</access>
                     <bitRange>[4:4]</bitRange>
                     <description>(LCD Clock: LOSC to RCL) Indicate the current clock selection, source clock or backup clock</description>
                  </field>
                  <field>
                     <name>CLKSEL5</name>
                     <access>read-only</access>
                     <bitRange>[5:5]</bitRange>
                     <description>(Infrared Clock: LOSC to RCL) Indicate the current clock selection, source clock or backup clock</description>
                  </field>
                  <field>
                     <name>CLKSEL6</name>
                     <access>read-only</access>
                     <bitRange>[6:6]</bitRange>
                     <description>(System clock: LOSC to RCL) Indicate the current clock selection, source clock or backup clock</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IE</name>
               <description>Interrupt enable register</description>
               <addressOffset>0x28</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>HFREQ_IE</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Clock high frequency abnormal interrupt enable</description>
                  </field>
                  <field>
                     <name>LFREQ_IE</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>Clock low frequency abnormal interrupt enable</description>
                  </field>
                  <field>
                     <name>LOSCOK_IE</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>LOSC clock is OK interrupt enable</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IF</name>
               <description>Status register</description>
               <addressOffset>0x2C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>HFREQ_IF</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>The flag for the high-frequency abnormal event of the clock</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>LFREQ_IF</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>The flag for the low-frequency abnormal event of the clock</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>FRCV_IF</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>The flag for the normal (recovery) frequency event of the clock</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>LOSC_OK</name>
                     <access>read-only</access>
                     <bitRange>[3:3]</bitRange>
                     <description>Indicates the current LOSC clock frequency status</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>HFREQ</name>
               <description>High frequency abnormal frequency register</description>
               <addressOffset>0x30</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">HFREQ</name>
                     <bitRange>[7:0]</bitRange>
                     <description>Set maximum high frequency abnormal frequency value</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>LFREQ</name>
               <description>Low frequency abnormal frequency register</description>
               <addressOffset>0x34</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">LFREQ</name>
                     <bitRange>[7:0]</bitRange>
                     <description>Set minimum low frequency abnormal frequency value</description>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral>
         <name>LPUART_CORE0</name>
         <description>LPUART Module core0</description>
         <groupName>LPUART_CORE0</groupName>
         <baseAddress>0x20020000</baseAddress>
         <addressBlock>
            <offset>0</offset>
