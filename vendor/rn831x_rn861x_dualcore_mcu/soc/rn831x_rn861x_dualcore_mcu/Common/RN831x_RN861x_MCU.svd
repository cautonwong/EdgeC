                  </field>
                  <field derivedFrom="ALMIF">
                     <name>MOIF</name>
                     <access>read-write</access>
                     <bitRange>[7:7]</bitRange>
                     <description>month event interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>TEMP</name>
               <description>current chip temperature register No.1.The bit field range depends on RTC_MODE1 (0xEA65: [15:0], others: [9:0]), and the field access depends on RTC_CTRL_TPS (0: invalid, 1: R, 2: RW, 3: W).</description>
               <addressOffset>0x3C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">TEMP</name>
                     <bitRange>[15:0]</bitRange>
                     <description>current chip temperature bits.[9:0]([15:0]):TEMP[9]([15]) for sign, TEMP[8:2]([15:6]) for integer part,TEMP[1:0]([5:0]) for decimal part)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>PS</name>
               <description>RTC compensation curve config registers(0x44-0x60/0x130-0x148) password register</description>
               <addressOffset>0x40</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>PS</name>
                     <bitRange>[7:0]</bitRange>
                     <description>Password bits for competition registers(44H~54H,130H~148H)</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ENWT</name>
                           <description>enable write of RTC competition registers</description>
                           <value>0x8E</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DISWT</name>
                           <description>RTC competition registers write disable</description>
                           <value>0x00</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
