      <peripheral>
         <name>SEA_CORE0</name>
         <groupName>Cryptographic module</groupName>
         <baseAddress>0x30008000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x3E4</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>START</name>
               <description>SEA Start Register.</description>
               <addressOffset>0x100</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>EN</name>
                     <bitRange>[0:0]</bitRange>
                     <description>Start SEA running</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CTRL</name>
               <description>SEA Control Register.</description>
               <addressOffset>0x104</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>IR</name>
                     <access>read-write</access>
                     <bitRange>[7:0]</bitRange>
                     <description>Set different calculation methods.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ECC_H</name>
                           <description>Start calculating H in ECC</description>
                           <value>0x01</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ECC_MODMULT</name>
                           <description>Start Modular Exponentiation in ECC</description>
                           <value>0x02</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ECC_ADD_I2M</name>
                           <description>ADD I2M</description>
                           <value>0x03</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ECC_DBL_I2M</name>
                           <description>DBL I2M</description>
                           <value>0x04</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ECC_POINT_ADD</name>
                           <description>Point Addition</description>
                           <value>0x05</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ECC_POINT_DBL</name>
                           <description>Point Double</description>
                           <value>0x06</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ECC_M2I</name>
                           <description>M2I</description>
                           <value>0x07</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ECC_MODINV</name>
                           <description>Modular Inversion</description>
                           <value>0x08</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ECC_MODADD</name>
                           <description>Modular Addition</description>
                           <value>0x09</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ECC_MODSUB</name>
                           <description>Moduar Subtraction</description>
                           <value>0x0A</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RSA_H</name>
                           <description>Get H</description>
                           <value>0x11</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RSA_MODMULT</name>
                           <description>Modular Multiplication</description>
                           <value>0x12</value>
