                           <name>COUNT</name>
                           <description>Continue to count after read</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FLT_BYPASS0</name>
                     <access>read-write</access>
                     <bitRange>[17:17]</bitRange>
                     <description>Filter bypass of IOCNT0</description>
                  </field>
                  <field>
                     <name>FLT_BYPASS1</name>
                     <access>read-write</access>
                     <bitRange>[18:18]</bitRange>
                     <description>Filter bypass of IOCNT1</description>
                  </field>
                  <field>
                     <name>FLT_BYPASS2</name>
                     <access>read-write</access>
                     <bitRange>[19:19]</bitRange>
                     <description>Filter bypass of IOCNT2</description>
                  </field>
                  <field>
                     <name>FLT_BYPASS3</name>
                     <access>read-write</access>
                     <bitRange>[20:20]</bitRange>
                     <description>Filter bypass of IOCNT3</description>
                  </field>
                  <field>
                     <name>FLT_BYPASS4</name>
                     <access>read-write</access>
                     <bitRange>[21:21]</bitRange>
                     <description>Filter bypass of IOCNT4</description>
                  </field>
                  <field>
                     <name>FLT_CFG</name>
                     <access>read-write</access>
                     <bitRange>[31:25]</bitRange>
                     <description>IOCNT4~IOCNT0 filter cycle configuration</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>COPL</name>
               <description>IOCNTx output pulse configuration register</description>
               <addressOffset>0x4C</addressOffset>
               <size>32</size>
               <resetValue>0x0</resetValue>
               <fields>
                  <field enums="ALL_ENUM">
                     <name>COPL0</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>IOCNT0 output pulse confige bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>Output the (n+1)th pulse at the (n*CNT+1)th input pulse</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>Output the (n)th pulse at the (n*CNT)th input pulse</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="COPL0">
                     <name>COPL1</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>IOCNT1 output pulse confige bit</description>
                  </field>
                  <field derivedFrom="COPL0">
                     <name>COPL2</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>IOCNT2 output pulse confige bit</description>
                  </field>
                  <field derivedFrom="COPL0">
                     <name>COPL3</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>IOCNT3 output pulse confige bit</description>
                  </field>
                  <field derivedFrom="COPL0">
                     <name>COPL4</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>IOCNT4 output pulse confige bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CMD</name>
               <description>IOCNTx input command register</description>
               <addressOffset>0x50</addressOffset>
               <size>32</size>
               <resetValue>0x0</resetValue>
               <fields>
                  <field>
                     <name>IOCNT0_KICK</name>
                     <access>write-only</access>
                     <bitRange>[0:0]</bitRange>
                     <description>IOCNT8 software pulse trigger bit</description>
                  </field>
                  <field>
                     <name>IOCNT1_KICK</name>
                     <access>write-only</access>
                     <bitRange>[1:1]</bitRange>
                     <description>IOCNT7 software pulse trigger bit</description>
                  </field>
                  <field>
                     <name>IOCNT2_KICK</name>
                     <access>write-only</access>
                     <bitRange>[2:2]</bitRange>
                     <description>IOCNT6 software pulse trigger bit</description>
                  </field>
                  <field>
                     <name>IOCNT3_KICK</name>
                     <access>write-only</access>
                     <bitRange>[3:3]</bitRange>
                     <description>IOCNT5 software pulse trigger bit</description>
                  </field>
                  <field>
                     <name>IOCNT4_KICK</name>
                     <access>write-only</access>
                     <bitRange>[4:4]</bitRange>
                     <description>IOCNT4 software pulse trigger bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>REMD0</name>
               <description>IOCNT0 input pulse remainder register</description>
               <addressOffset>0x60</addressOffset>
               <size>32</size>
               <resetValue>0x0</resetValue>
               <fields>
                  <field>
                     <name>REMD0</name>
                     <bitRange>[10:0]</bitRange>
                     <description>IOCNT0 input pulse remainder bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>REMD1</name>
               <description>IOCNT1 input pulse remainder register</description>
               <addressOffset>0x64</addressOffset>
               <size>32</size>
               <resetValue>0x0</resetValue>
               <fields>
                  <field>
                     <name>REMD1</name>
                     <bitRange>[10:0]</bitRange>
                     <description>IOCNT1 input pulse remainder bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>REMD2</name>
               <description>IOCNT2 input pulse remainder register</description>
               <addressOffset>0x68</addressOffset>
               <size>32</size>
               <resetValue>0x0</resetValue>
               <fields>
                  <field>
                     <name>REMD2</name>
                     <bitRange>[10:0]</bitRange>
                     <description>IOCNT2 input pulse remainder bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>REMD3</name>
               <description>IOCNT3 input pulse remainder register</description>
               <addressOffset>0x6C</addressOffset>
               <size>32</size>
               <resetValue>0x0</resetValue>
               <fields>
                  <field>
                     <name>REMD3</name>
                     <bitRange>[10:0]</bitRange>
