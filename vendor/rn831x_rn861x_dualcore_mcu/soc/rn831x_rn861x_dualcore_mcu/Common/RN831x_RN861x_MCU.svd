                        <enumeratedValue>
                           <name>4800</name>
                           <description>Baud Rate is 4800bps</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2400</name>
                           <description>Baud Rate is 2400bps</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1200</name>
                           <description>Baud Rate is 1200bps</description>
                           <value>0x3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>600</name>
                           <description>Baud Rate is 600bps</description>
                           <value>0x4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>300</name>
                           <description>Baud Rate is 300bps</description>
                           <value>0x5</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MCTL</name>
                     <access>read-write</access>
                     <bitRange>[27:16]</bitRange>
                     <description>Baud Rate Select</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>9600</name>
                           <description>Baud Rate is 9600bps, set MCTL</description>
                           <value>0x4A5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4800</name>
                           <description>Baud Rate is 4800bps, set MCTL</description>
                           <value>0xF7D</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2400</name>
                           <description>Baud Rate is 2400bps, set MCTL</description>
                           <value>0x6DB</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1200</name>
                           <description>Baud Rate is 1200bps, set MCTL</description>
                           <value>0x407</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>600</name>
                           <description>Baud Rate is 600bps, set MCTL</description>
                           <value>0x7F</value>
