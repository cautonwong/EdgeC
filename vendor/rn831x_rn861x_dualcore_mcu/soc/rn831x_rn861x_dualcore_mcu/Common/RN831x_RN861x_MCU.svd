<?xml version="1.0" encoding="utf-8"?>
<device xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="v0.0.1" xsi:noNamespaceSchemaLocation="CMSIS-SVD_Schema_1_1.xsd">
   <name>RN831X_RN861X_MCU</name>
   <version>v0.0.1</version>
   <description>RN831X_RN861X_MCU RISC-V Microcontroller based device</description>
   <cpu>
      <name>RN831X_RN861X_MCU</name>
      <revision>r1p0</revision>
      <endian>little</endian>
      <mpuPresent>1</mpuPresent>
      <fpuPresent>0</fpuPresent>
      <vendorSystickConfig>0</vendorSystickConfig>
   </cpu>
   <addressUnitBits>8</addressUnitBits>
   <width>32</width>
   <size>32</size>
   <resetValue>0x0</resetValue>
   <resetMask>0xFFFFFFFF</resetMask>
   <peripherals>
      <peripheral>
         <name>ADC0_CORE0</name>
         <description>ADC</description>
         <baseAddress>0x20094000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x98</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>CFG</name>
               <description>Configuration Register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>RESC</name>
                     <bitRange>[1:0]</bitRange>
                     <description>ADC resolution selection bits (Only can be configured when ADC0_STARTA=0 and ADC0_STARTB =0.)</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>12BIT</name>
                           <description>select as 12-bit</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>10BIT</name>
                           <description>select as 10-bit</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>8BIT</name>
                           <description>select as 8-bit</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>6BIT</name>
                           <description>select as 6-bit</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DFMT</name>
                     <bitRange>[2:2]</bitRange>
                     <description>Data format selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>RA</name>
                           <description>Right-aligned data</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LA</name>
                           <description>Left-aligned data</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DCLREN</name>
                     <bitRange>[3:3]</bitRange>
                     <description>Data register auto-clear enable bit</description>
                  </field>
                  <field>
                     <name>BUFF_EN</name>
                     <bitRange>[4:4]</bitRange>
                     <description>channel input signal connects to ADC0 after amplification through BUFFER,function enable bit. (disable for  signal connects directly to ADC)(Only can be configured when ADC0_STARTA=0 and ADC0_STARTB =0.)</description>
                  </field>
                  <field>
                     <name>HALT_2DAC</name>
                     <bitRange>[5:5]</bitRange>
                     <description>DAC linkage configuration bit（ADC state select when DAC coverting）</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CONTINUE</name>
                           <description>ADC0 operates normally regardless of DAC status</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PAUSE</name>
                           <description>ADC0 pauses conversion when DAC is in conversion state</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BUFF_PWRUPT</name>
                     <bitRange>[15:08]</bitRange>
                     <description>BUFFER power-up stabilization time bits (Time=BUFF_PWRUPT+32)(refer to reference manual for detail)</description>
                  </field>
                  <field>
                     <name>ADC0_PWRUPT</name>
                     <bitRange>[17:16]</bitRange>
                     <description>power-up stabilization time bits (Time=ADC0_PWRUPT+32)(refer to reference manual for detail)</description>
                  </field>
                  <field>
                     <name>INTV_TIME</name>
                     <bitRange>[22:18]</bitRange>
                     <description>Conversion interval wait cycles configuration bits.</description>
                  </field>
                  <field>
                     <name>CLKDIV</name>
                     <bitRange>[29:23]</bitRange>
                     <description>ADC0 module working clock is bus clock divided by (CLKDIV+1)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>OVSCFG</name>
               <description>Oversampling Configuration Register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>OVSEN</name>
                     <bitRange>[0:0]</bitRange>
                     <description>Oversampling enable bit.(Only can be configured when ADC0_STARTA=0 and ADC0_STARTB =0.)</description>
                  </field>
                  <field>
                     <name>OVSR</name>
                     <bitRange>[3:1]</bitRange>
                     <description>Oversampling accumulation times</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ACC2</name>
                           <description>Accumulate 2 times</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ACC4</name>
                           <description>Accumulate 4 times</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ACC8</name>
                           <description>Accumulate 8 times</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ACC16</name>
                           <description>Accumulate 16 times</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ACC32</name>
                           <description>Accumulate 32 times</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ACC64</name>
                           <description>Accumulate 64 times</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ACC128</name>
                           <description>Accumulate 128 times</description>
                           <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ACC256</name>
                           <description>Accumulate 256 times</description>
                           <value>7</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OVSS</name>
                     <bitRange>[7:4]</bitRange>
                     <description>Oversampling shift bits(Right Shift)</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SHLNUL</name>
                           <description>No shift</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SHL1</name>
                           <description>Shift 1 bit</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SHL2</name>
                           <description>Shift 2 bits</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SHL3</name>
                           <description>Shift 3 bits</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SHL4</name>
                           <description>Shift 4 bits</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SHL5</name>
                           <description>Shift 5 bits</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SHL6</name>
                           <description>Shift 6 bits</description>
                           <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SHL7</name>
                           <description>Shift 7 bits</description>
                           <value>7</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SHL8</name>
                           <description>Shift 8 bits</description>
                           <value>8</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>OVSCHSEL</name>
               <description>Oversampling Channel Configuration Register.Select whether each channel is oversampled.(Only can be configured when ADC0_STARTA=0 and ADC0_STARTB =0.)</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field enums="NO_ENUM">
                     <name>CH0</name>
                     <bitRange>[0:0]</bitRange>
                     <description>CH0 Oversampling enable bit.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>disable channel oversampling</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>enable channel oversampling</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH1</name>
                     <bitRange>[1:1]</bitRange>
                     <description>CH1 Oversampling enable bit.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH2</name>
                     <bitRange>[2:2]</bitRange>
                     <description>CH2 Oversampling enable bit.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH3</name>
                     <bitRange>[3:3]</bitRange>
                     <description>CH3 Oversampling enable bit.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH4</name>
                     <bitRange>[4:4]</bitRange>
                     <description>CH4 Oversampling enable bit.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH5</name>
                     <bitRange>[5:5]</bitRange>
                     <description>CH5 Oversampling enable bit.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH6</name>
                     <bitRange>[6:6]</bitRange>
                     <description>CH6 Oversampling enable bit.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH7</name>
                     <bitRange>[7:7]</bitRange>
                     <description>CH7 Oversampling enable bit.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH8</name>
                     <bitRange>[8:8]</bitRange>
                     <description>CH8 Oversampling enable bit.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH9</name>
                     <bitRange>[9:9]</bitRange>
                     <description>CH9 Oversampling enable bit.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH10</name>
                     <bitRange>[10:10]</bitRange>
                     <description>CH10 Oversampling enable bit.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH11</name>
                     <bitRange>[11:11]</bitRange>
                     <description>CH11 Oversampling enable bit.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH12</name>
                     <bitRange>[12:12]</bitRange>
                     <description>CH12 Oversampling enable bit.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH13</name>
                     <bitRange>[13:13]</bitRange>
                     <description>CH13 Oversampling enable bit.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>PWDCTRL</name>
               <description>Power Switch Control Register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>BUFF_AON</name>
                     <bitRange>[7:0]</bitRange>
                     <description>ADC0 BUFFER's analog circuit switch configuration bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ALWAYSON</name>
                           <description>BUFFER analog circuit always on</description>
                           <value>0xAC</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DEMANDON</name>
                           <description>BUFFER analog circuit only turns on when working</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ADC0_AON</name>
                     <bitRange>[15:8]</bitRange>
                     <description>ADC0's analog circuit switch configuration bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ALWAYSON</name>
                           <description>ADC0 analog circuit always on</description>
                           <value>0xA5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DEMANDON</name>
                           <description>ADC0 analog circuit only turns on when working</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>SAMPT0</name>
               <description>Sampling Time Configuration Register for Input Channels 0~3</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CH0_SMPT</name>
                     <bitRange>[7:0]</bitRange>
                     <description>channel 0 sampling clock cycles configuration bits. Cycles = (CHN0_SMPT+1).</description>
                  </field>
                  <field>
                     <name>CH1_SMPT</name>
                     <bitRange>[15:8]</bitRange>
                     <description>channel 1 sampling clock cycles configuration bits. Cycles = (CHN1_SMPT+1).</description>
                  </field>
                  <field>
                     <name>CH2_SMPT</name>
                     <bitRange>[23:16]</bitRange>
                     <description>channel 2 sampling clock cycles configuration bits. Cycles = (CHN2_SMPT+1).</description>
                  </field>
                  <field>
                     <name>CH3_SMPT</name>
                     <bitRange>[31:24]</bitRange>
                     <description>channel 3 sampling clock cycles configuration bits. Cycles = (CHN3_SMPT+1).</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>SAMPT1</name>
               <description>Sampling Time Configuration Register for Input Channels 4~7</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CH4_SMPT</name>
                     <bitRange>[7:0]</bitRange>
                     <description>channel 4 sampling clock cycles configuration bits. Cycles = (CH4_SMPT+1).</description>
                  </field>
                  <field>
                     <name>CH5_SMPT</name>
                     <bitRange>[15:8]</bitRange>
                     <description>channel 5 sampling clock cycles configuration bits. Cycles = (CH5_SMPT+1).</description>
                  </field>
                  <field>
                     <name>CH6_SMPT</name>
                     <bitRange>[23:16]</bitRange>
                     <description>channel 6 sampling clock cycles configuration bits. Cycles = (CH6_SMPT+1).</description>
                  </field>
                  <field>
                     <name>CH7_SMPT</name>
                     <bitRange>[31:24]</bitRange>
                     <description>channel 7 sampling clock cycles configuration bits. Cycles = (CH7_SMPT+1).</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>SAMPT2</name>
               <description>Sampling Time Configuration Register for Input Channels 8~11</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CH8_SMPT</name>
                     <bitRange>[7:0]</bitRange>
                     <description>channel 8 sampling clock cycles configuration bits. Cycles = (CH8_SMPT+1).</description>
                  </field>
                  <field>
                     <name>CH9_SMPT</name>
                     <bitRange>[15:8]</bitRange>
                     <description>channel 9 sampling clock cycles configuration bits. Cycles = (CH9_SMPT+1).</description>
                  </field>
                  <field>
                     <name>CH10_SMPT</name>
                     <bitRange>[23:16]</bitRange>
                     <description>channel 10 sampling clock cycles configuration bits. Cycles = (CH10_SMPT+1).</description>
                  </field>
                  <field>
                     <name>CH11_SMPT</name>
                     <bitRange>[31:24]</bitRange>
                     <description>channel 11 sampling clock cycles configuration bits. Cycles = (CH11_SMPT+1).</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>SAMPT3</name>
               <description>Sampling Time Configuration Register for Input Channels 12~13</description>
               <addressOffset>0x1C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CH12_SMPT</name>
                     <bitRange>[7:0]</bitRange>
                     <description>channel 12 sampling clock cycles configuration bits. Cycles = (CH12_SMPT+1).</description>
                  </field>
                  <field>
                     <name>CH13_SMPT</name>
                     <bitRange>[15:8]</bitRange>
                     <description>channel 13 sampling clock cycles configuration bits. Cycles = (CH13_SMPT+1).</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CTRLA</name>
               <description>Sequence A Control Register</description>
               <addressOffset>0x20</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CHMOD</name>
                     <bitRange>[0:0]</bitRange>
                     <description>Sequence A channel mode selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DATCH</name>
                           <description>Sequence AChannel configuration depend on ADC0_DATA_CHN</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CHSEL</name>
                           <description>Sequence AChannel configuration depend on ADC0_CHSELA</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CONT</name>
                     <bitRange>[1:1]</bitRange>
                     <description>Sequence A continuous conversion enable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ONCE</name>
                           <description>ADC0 converts the specified channel(s) once</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CONTIUE</name>
                           <description>ADC0 continuously converts the specified channel(s) until software writes 0 to ADC0_STARTA</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DSICEN</name>
                     <bitRange>[2:2]</bitRange>
                     <description>ADC0 discontinuous scan enable bit</description>
                  </field>
                  <field>
                     <name>DSICNUM</name>
                     <bitRange>[6:3]</bitRange>
                     <description>ADC0 discontinuous scan count configuration bits. count=(DSICNUM+1)</description>
                  </field>
                  <field>
                     <name>DMAEN</name>
                     <bitRange>[8:8]</bitRange>
                     <description>Start DMA data transfer(only supports 16bit transfer)</description>
                  </field>
                  <field>
                     <name>DMA_MODE</name>
                     <bitRange>[9:9]</bitRange>
                     <description>DMA mode configuration bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ONCE</name>
                           <description>select DMA convert mode as convert once</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CONTIUE</name>
                           <description>select DMA convert mode as continuous convert</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OVRMOD</name>
                     <bitRange>[10:10]</bitRange>
                     <description>Data overflow handling method seletion bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>Do not recover data when overflow</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RECOVER</name>
                           <description>recover data when overflow</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>AWDEN</name>
                     <bitRange>[11:11]</bitRange>
                     <description>Sequence A Analog Watchdog enable bit</description>
                  </field>
                  <field>
                     <name>AWDMOD</name>
                     <bitRange>[13:12]</bitRange>
                     <description>Sequence A Analog Watchdog mode selection(Watchdog protection range,when data not in protection range AWD flag will be set)</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PHL</name>
                           <description>Protection range: AWD Low threshold&lt; DATA &lt; AWD High threshold</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PL</name>
                           <description>Protection range: AWD Low threshold&lt; DATA</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PH</name>
                           <description>Protection range: DATA &gt; AWD High threshold</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CHSELA</name>
               <description>Sequence A Channel Selection Register</description>
               <addressOffset>0x24</addressOffset>
               <size>32</size>
               <fields>
                  <field enums="NO_ENUM">
                     <name>CH0</name>
                     <bitRange>[0:0]</bitRange>
                     <description>Channel 0 enable bit for Sequence A.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>disable channel for Sequence A</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>enable channel for Sequence A</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH1</name>
                     <bitRange>[1:1]</bitRange>
                     <description>Channel 1 enable bit for Sequence A.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH2</name>
                     <bitRange>[2:2]</bitRange>
                     <description>Channel 2 enable bit for Sequence A.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH3</name>
                     <bitRange>[3:3]</bitRange>
                     <description>Channel 3 enable bit for Sequence A.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH4</name>
                     <bitRange>[4:4]</bitRange>
                     <description>Channel 4 enable bit for Sequence A.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH5</name>
                     <bitRange>[5:5]</bitRange>
                     <description>Channel 5 enable bit for Sequence A.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH6</name>
                     <bitRange>[6:6]</bitRange>
                     <description>Channel 6 enable bit for Sequence A.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH7</name>
                     <bitRange>[7:7]</bitRange>
                     <description>Channel 7 enable bit for Sequence A.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH8</name>
                     <bitRange>[8:8]</bitRange>
                     <description>Channel 8 enable bit for Sequence A.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH9</name>
                     <bitRange>[9:9]</bitRange>
                     <description>Channel 9 enable bit for Sequence A.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH10</name>
                     <bitRange>[10:10]</bitRange>
                     <description>Channel 10 enable bit for Sequence A.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH11</name>
                     <bitRange>[11:11]</bitRange>
                     <description>Channel 11 enable bit for Sequence A.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH12</name>
                     <bitRange>[12:12]</bitRange>
                     <description>Channel 12 enable bit for Sequence A.</description>
                  </field>
                  <field derivedFrom="CH0">
                     <name>CH13</name>
                     <bitRange>[13:13]</bitRange>
                     <description>Channel 13 enable bit for Sequence A.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>STARTA</name>
               <description>Sequence A Start Register</description>
               <addressOffset>0x28</addressOffset>
               <size>32</size>
