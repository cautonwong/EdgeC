      <peripheral>
         <name>LCSS_VBAT_CORE0</name>
         <description>LCSS_VBAT Module core0</description>
         <groupName>LCSS_VBAT_CORE0</groupName>
         <baseAddress>0x200B8200</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x0020</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>PSW0</name>
               <description>Security key register 0</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">PSW0</name>
                     <bitRange>[15:0]</bitRange>
                     <description>Managed registers include LCSS_VBAT_EN/LCSS_CTRL/LCSS_IE</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>PSW1</name>
               <description>Security key register 1</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">PSW1</name>
                     <bitRange>[15:0]</bitRange>
                     <description>Managed registers include LCSS_CLKSWH</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>EN</name>
               <description>Enable register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">EN</name>
                     <bitRange>[0:0]</bitRange>
                     <description>LCSS VBAT enable</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CTRL</name>
               <description>Control register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>STOP_TH</name>
                     <access>read-write</access>
                     <bitRange>[4:0]</bitRange>
                     <description>Clock stop threshold configuration</description>
                  </field>
                  <field>
                     <name>RCV_CYC</name>
                     <access>read-write</access>
                     <bitRange>[11:5]</bitRange>
                     <description>LOSC recovery cycles configuration</description>
                  </field>
                  <field>
                     <name>STOP_ASWH</name>
                     <access>read-write</access>
                     <bitRange>[12:12]</bitRange>
                     <description>Auto switch when clock stopped</description>
                  </field>
                  <field>
                     <name>RCV_ASWH</name>
                     <access>read-write</access>
                     <bitRange>[13:13]</bitRange>
                     <description>Auto switch when clock recovery</description>
                  </field>
                  <field>
                     <name>TC_CFG</name>
                     <access>read-write</access>
                     <bitRange>[15:14]</bitRange>
                     <description>Timing detection function configuration</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>TIMING_NONE</name>
                           <description>No timing detection</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TIMING_10MS</name>
                           <description>10ms timing detection, start detection every 10ms</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TIMING_20MS</name>
                           <description>20ms timing detection, start detection every 20ms</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TIMING_40MS</name>
                           <description>40ms timing detection, start detection every 40ms</description>
                           <value>0x3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CLKSWH</name>
               <description>Clock configuration register for software switch</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <resetValue>1</resetValue>
               <fields>
                  <field>
                     <name>RTC_CLK_SWH</name>
                     <access>write-only</access>
                     <bitRange>[2:0]</bitRange>
                     <description>Clock source selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>LOSC</name>
                           <description>Selected LOSC clock</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RCL</name>
                           <description>Selected RCL32k clock</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RCO</name>
                           <description>Selected RCO clock</description>
                           <value>0x4</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CLKSEL</name>
               <description>Clock selected register, indicate the selected clock</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <resetValue>1</resetValue>
               <fields>
                  <field>
                     <name>RTC_CLK_SEL</name>
                     <access>write-only</access>
                     <bitRange>[2:0]</bitRange>
                     <description>Clock source selection, this register must be written to 0 before reading to read the latest value.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>LOSC</name>
                           <description>Selected LOSC clock</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RCL</name>
                           <description>Selected RCL32k clock</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RCO</name>
                           <description>Selected RCO clock</description>
                           <value>0x4</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>IE</name>
               <description>Interrupt enable register</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>LOSC_STOP_IE</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>LOSC stopped interrupt enable</description>
                  </field>
                  <field>
                     <name>LOSC_OK_IE</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>LOSC is ok interrupt enable</description>
                  </field>
                  <field>
                     <name>RCL_STOP_IE</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>RCL stopped interrupt enable</description>
                  </field>
                  <field>
                     <name>RCL_OK_IE</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>RCL is ok interrupt enable</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IF</name>
               <description>Status register</description>
               <addressOffset>0x1C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>LOSC_STOP_IF</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>LOSC stopped status, when LCSS_VBAT_EN=0, the state will not be automatically updated (this bit must be written 1 twice to clear)</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>LOSC_OK</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>LOSC is ok status, when LCSS_VBAT_EN=0, the state will not be automatically updated (this bit must be written 1 twice to clear)</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RCL_STOP_IF</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>RCL stopped status, when LCSS_VBAT_EN=0, the state will not be automatically updated (this bit must be written 1 twice to clear)</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RCL_OK</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>RCL is ok status, when LCSS_VBAT_EN=0, the state will not be automatically updated (this bit must be written 1 twice to clear)</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
