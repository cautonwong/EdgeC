      </peripheral>
      <peripheral derivedFrom="ISO78160_CORE0">
         <name>ISO78161_CORE1</name>
         <description>ISO78161 Module core1</description>
         <groupName>ISO7816_CORE1</groupName>
         <baseAddress>0xA0034000</baseAddress>
      </peripheral>
      <peripheral>
         <name>KBI0_CORE0</name>
         <description>KBI0 Module core0</description>
         <groupName>KBI_CORE0</groupName>
         <baseAddress>0x20064000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x0054</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>CTRL</name>
               <description>Control Register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>EN</name>
                     <bitRange>[15:0]</bitRange>
                     <description>Enable/Disable KBI channel</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>MODE</name>
               <description>Mode Register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>MODE0</name>
                     <access>read-write</access>
                     <bitRange>[1:0]</bitRange>
                     <description>KBI channel 0 interrupt input valid mode selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>RISING</name>
                           <description>Trigger Rising Edge Mode</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FALLING</name>
                           <description>Trigger Falling Edge Mode</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RISING_FALLING</name>
                           <description>Trigger Rising &amp; Falling Edge Mode</description>
                           <value>0x2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MODE1</name>
                     <access>read-write</access>
                     <bitRange>[3:2]</bitRange>
                     <description>KBI channel 1 interrupt input valid mode selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
