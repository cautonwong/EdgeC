                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>COUNTINUE</name>
                           <description>keep counting when SoC halted by debugger</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CM0</name>
               <description>capture(compare) channel No.0 mode register</description>
               <addressOffset>0x24</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>ENABLE</name>
                     <bitRange>[0:0]</bitRange>
                     <description>channel enable bit</description>
                  </field>
                  <field>
                     <name>CCM</name>
                     <bitRange>[1:1]</bitRange>
                     <description>capture(compare) selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>IC</name>
                           <description>select as input capture</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OC</name>
                           <description>select as output compare</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DIEN</name>
                     <bitRange>[2:2]</bitRange>
                     <description>compare dead zone insertion enable bit (only for PWM1/PWM2)</description>
                  </field>
                  <field>
                     <name>DL</name>
                     <bitRange>[8:3]</bitRange>
                     <description>compare dead zone length configuration bits (only for PWM1/PWM2)</description>
                  </field>
                  <field>
                     <name>CPOL</name>
                     <bitRange>[10:9]</bitRange>
                     <description>capture polarity selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PE</name>
                           <description>capture on posedge</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NE</name>
                           <description>capture on negedge</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BE</name>
                           <description>capture on both posedge and negedge</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FLTOPT</name>
                     <bitRange>[18:11]</bitRange>
                     <description>capture filter parameter set bits</description>
                  </field>
                  <field>
                     <name>FLTEN</name>
                     <bitRange>[20:20]</bitRange>
                     <description>capture filter enable bit</description>
                  </field>
                  <field>
                     <name>OM</name>
                     <bitRange>[23:21]</bitRange>
                     <description>compare output mode cfg bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NUL</name>
                           <description>no output generated</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VL</name>
                           <description>set as valid level</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>INVL</name>
                           <description>set as invalid level</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TOG</name>
                           <description>toggle output</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FVL</name>
                           <description>force as valid level</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FINVL</name>
                           <description>force as invalid level</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PWM1</name>
                           <description>when tc_cnt less than tc_ccdx, set output as valid level</description>
                           <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PWM2</name>
                           <description>when tc_cnt greater than tc_ccdx, set output as valid level</description>
                           <value>7</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EFELVL</name>
                     <bitRange>[24:24]</bitRange>
                     <description>compare valid output level set bit</description>
                  </field>
                  <field>
                     <name>DFTLVL</name>
                     <bitRange>[25:25]</bitRange>
                     <description>compare valid default level set bit</description>
                  </field>
               </fields>
            </register>
