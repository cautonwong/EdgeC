      </peripheral>
      <peripheral derivedFrom="TC0_CORE0">
         <name>TC1_CORE1</name>
         <groupName>TIMER</groupName>
         <baseAddress>0xA00A0000</baseAddress>
      </peripheral>
      <peripheral>
         <name>TIMER</name>
         <description>Timer Unit</description>
         <baseAddress>0xE0030000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0xFFF</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>MTIME_LO</name>
               <description>Reflect the lower 32-bit value of mtime.</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">MTIME_LO</name>
                     <bitRange>[31:0]</bitRange>
                     <description>None</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>MTIME_HI</name>
               <description>Reflect the upper 32-bit value of mtime.</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">MTIME_HI</name>
                     <bitRange>[31:0]</bitRange>
                     <description>None</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>MTIMECMP_LO</name>
               <description>Set the lower 32-bit value of mtimecmp.</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">MTIMECMP_LO</name>
                     <bitRange>[31:0]</bitRange>
                     <description>None</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>MTIMECMP_HI</name>
               <description>Set the upper 32-bit value of mtimecmp.</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">MTIMECMP_HI</name>
                     <bitRange>[31:0]</bitRange>
                     <description>None</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>MTIME_SRW_CTRL</name>
               <description>Control S-mode can access this timer or not.</description>
               <addressOffset>0xFEC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">MTIME_SRW_CTRL</name>
                     <bitRange>[0:0]</bitRange>
                     <description>None</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>MSFTRST</name>
               <description>Generate soft-reset request.</description>
               <addressOffset>0xFF0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">MSFTRST</name>
                     <bitRange>[31:31]</bitRange>
                     <description>None</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>SSIP</name>
               <description>Generate the Software Interrupt in S-mode.</description>
               <addressOffset>0xFF4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">SSIP</name>
                     <bitRange>[2:0]</bitRange>
                     <description>None</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>MTIMECTL</name>
               <description>Control some features of the time counter.</description>
               <addressOffset>0xFF8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TIMESTOP</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Control the timer count or pause.</description>
                  </field>
                  <field>
                     <name>CMPCLREN</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>Control the timer count to clear-to-zero or not.</description>
                  </field>
                  <field>
                     <name>CLKSRC</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>Select the source of increment frequency.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>MSIP</name>
               <description>Generate the Software Interrupt.</description>
               <addressOffset>0xFFC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">MSIP</name>
                     <bitRange>[0:0]</bitRange>
                     <description>None</description>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral>
         <name>UART0_CORE0</name>
         <description>UART0 Module core0</description>
         <groupName>UART0_5_CORE0</groupName>
         <baseAddress>0x20000000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x0044</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>CTRL</name>
               <description>Control Register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>EN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Module Enable</description>
                  </field>
                  <field>
                     <name>TXIE</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>Transmit Data Interrupt Enable</description>
                  </field>
                  <field>
                     <name>RXIE</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>Receive Data Interrupt Enable</description>
                  </field>
                  <field>
                     <name>ERRIE</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>Error Interrupt Enable</description>
                  </field>
                  <field>
                     <name>STOPS</name>
                     <access>read-write</access>
