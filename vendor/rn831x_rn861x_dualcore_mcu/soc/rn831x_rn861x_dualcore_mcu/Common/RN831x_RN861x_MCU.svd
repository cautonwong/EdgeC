      <peripheral derivedFrom="D2F_CORE0">
         <name>D2F_CORE1</name>
         <description>D2F Module core1</description>
         <groupName>D2F</groupName>
         <baseAddress>0xA007C000</baseAddress>
      </peripheral>
      <peripheral>
         <name>DAC_CORE0</name>
         <description>DAC</description>
         <baseAddress>0x20098000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x28</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>CFG</name>
               <description>DAC Control Register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>DAC_EN</name>
                     <bitRange>[0:0]</bitRange>
                     <description>DAC channel conversion enable bit.</description>
                  </field>
                  <field>
                     <name>BUFF_EN</name>
                     <bitRange>[1:1]</bitRange>
                     <description>Output buffer enable bit.</description>
                  </field>
                  <field>
                     <name>SEL_BUFF</name>
                     <bitRange>[2:2]</bitRange>
                     <description>Output buffer selection enable bit.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>BUFF</name>
                           <description>Output not through buffer;</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NO_BUFF</name>
                           <description>Output through buffer;</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>INIT_MODE</name>
                     <bitRange>[3:3]</bitRange>
                     <description>Initial output state selection bit.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>HIGHZ</name>
                           <description>Analog output in high-Z state when channel disabled;</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>GND</name>
                           <description>Analog output connected to ground when channel disabled;</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DMA_EN</name>
                     <bitRange>[4:4]</bitRange>
                     <description>DMA enable bit (when DMA enable,must config TRIG_CTRL as External trigger).</description>
                  </field>
                  <field>
                     <name>TRIG_CTRL</name>
                     <bitRange>[6:5]</bitRange>
                     <description>DAC trigger mode configuration bits.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>COUTINUE</name>
                           <description>Continuous output mode;</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SWT</name>
                           <description>Software trigger, writing to DAC_SWT register triggers one conversion;</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EXT</name>
                           <description>External trigger, external trigger source configured by AOS module;</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SH_MODE</name>
                     <bitRange>[7:7]</bitRange>
                     <description>Sample and hold mode enable bit.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NORM</name>
                           <description>Sample and hold mode disabled, Normal mode;</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SPHD</name>
                           <description>Sample and hold mode enabled;</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DPSEL</name>
                     <bitRange>[8:8]</bitRange>
                     <description>Data alignment format configuration bit.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>RA</name>
                           <description>Right-aligned data</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LA</name>
                           <description>Left-aligned data</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ADPEN</name>
                     <bitRange>[9:9]</bitRange>
                     <description>A/D conversion priority function enable bit.</description>
                  </field>
                  <field>
                     <name>ADP_CTRL</name>
                     <bitRange>[10:10]</bitRange>
                     <description>Timeout handling method seletion bit, when A/D conversion priority function is enabled</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>WAITAD_DONE</name>
                           <description>After timeout ADPOV Flag set as 1, continue waiting until A/D conversion completes, then proceed to next D/A conversion;</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ONLYTIMEOUT</name>
                           <description>After timeout ADPOV Flag set as 1, do not wait for A/D conversion completion, immediately proceed to next D/A conversion;</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TBUFF</name>
                     <bitRange>[12:11]</bitRange>
                     <description>Configuration bits for output buffer power-up stabilization wait time(in conversion clock cycles Toclk).</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>1TOCLK</name>
                           <description>1Toclk</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2TOCLK</name>
                           <description>2Toclk (default)</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3TOCLK</name>
                           <description>3Toclk</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4TOCLK</name>
                           <description>4Toclk</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OCH_EN</name>
                     <bitRange>[13:13]</bitRange>
                     <description>Analog output channel enable bit.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>All output channels are closed;</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>Select DAC output to PAD or ADC0  by OCH_SEL;</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OCH_SEL</name>
                     <bitRange>[15:14]</bitRange>
                     <description>Analog output channel selection bits.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PAD0</name>
                           <description>Output to PAD0 (P104)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PAD1</name>
                           <description>Output to PAD1 (P140)</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ADC0</name>
                           <description>Output to ADC0</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CONV_DIV</name>
                     <bitRange>[31:16]</bitRange>
                     <description>Output conversion clock division configuration bits.Toclk=Tsys_clk/(CONV_DIV+1) (refer to user mannual for recommend value )</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>ADPOT</name>
               <description>DAC A/D Conversion Priority Timeout Register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>ADP_OVT</name>
                     <bitRange>[15:0]</bitRange>
                     <description>A/D conversion priority function timeout configuration bits.(in conversion clock cycles Toclk)</description>
                  </field>
                  <field>
                     <name>DAC_BUSYT</name>
                     <bitRange>[19:16]</bitRange>
                     <description>DAC busy flag assertion time setting bits (in system clock cycles Tsys_clk)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>SHT</name>
               <description>DAC Sample Hold Time Register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TSMPL</name>
                     <bitRange>[15:0]</bitRange>
                     <description>Sampling time configuration bits, for sample and hold mode. Sample Time = (TSMPL+1)*Toclk</description>
                  </field>
                  <field>
                     <name>THOLD</name>
                     <bitRange>[31:16]</bitRange>
                     <description>Hold time configuration bits, for sample and hold mode. Hold Time = (THOLD+1)*Toclk</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>OTRIM</name>
               <description>DAC Buffer Calibration Register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">OTRIM</name>
                     <bitRange>[7:0]</bitRange>
                     <description>(two's complement)When output buffer is enabled, the compensation value for output voltage.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>SWT</name>
               <description>DAC Software Trigger Register</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <access>write-only</access>
               <fields>
                  <field>
                     <name fieldName="None">SWT</name>
                     <bitRange>[0:0]</bitRange>
                     <description>D/A conversion software trigger bit.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IE</name>
               <description>DAC Interrupt Enable Register</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>DOUT_IE</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Data output register update interrupt enable bit.</description>
                  </field>
                  <field>
                     <name>DERR_IE</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>DMA error interrupt enable bit.</description>
                  </field>
                  <field>
                     <name>ADPOV_IE</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>A/D conversion wait timeout interrupt enable bit.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IF</name>
               <description>DAC Interrupt Flag Register</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>DOUT_IF</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Data output register update interrupt flag.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>DERR_IF</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>DMA error interrupt flag.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>ADPOV_IF</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>A/D conversion wait timeout interrupt flag.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>DHOLD</name>
               <description>DAC Data Hold Register</description>
               <addressOffset>0x20</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">DHOLD</name>
                     <bitRange>[15:0]</bitRange>
                     <description>When DAC_CFG.DPSEL=0 (data right-aligned), write the data to be converted to DHOLD[11:0];When DAC_CFG.DPSEL=1 (data left-aligned), write the data to be converted to DHOLD[15:4].</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DOUT</name>
               <description>DAC Data Output Register</description>
               <addressOffset>0x24</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">DOUT</name>
                     <bitRange>[11:0]</bitRange>
                     <description>DAC Data Output bits</description>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral derivedFrom="DAC_CORE0">
         <name>DAC_CORE1</name>
         <description>DAC</description>
         <baseAddress>0xA0098000</baseAddress>
      </peripheral>
      <peripheral>
         <name>DMA00</name>
         <description>General Driect Memory Access module</description>
         <groupName>DMA</groupName>
         <baseAddress>0x20104000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x210</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>CTRL_CH0</name>
               <description>DMA Control Register for channel 0.</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>EN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Enable DMA to start data migration.</description>
                  </field>
                  <field>
                     <name>CIRC</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>Enable DMA circle mode.</description>
                  </field>
                  <field>
                     <name>PL</name>
                     <access>read-write</access>
                     <bitRange>[3:2]</bitRange>
                     <description>Configure the DMA channel priority.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>LOW</name>
                           <description>Set the channel priority to the lowest.</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MEDIUM</name>
                           <description>Set the channel priority to medium.</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HIGH</name>
