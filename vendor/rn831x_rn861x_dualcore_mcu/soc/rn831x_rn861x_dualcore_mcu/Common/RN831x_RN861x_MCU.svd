                  </field>
                  <field>
                     <name>DMA_CH1</name>
                     <access>read-write</access>
                     <bitRange>[3:2]</bitRange>
                     <description>Channel 1: SPI1 channel access SRAM priority configuration.</description>
                  </field>
                  <field>
                     <name>DMA_CH2</name>
                     <access>read-write</access>
                     <bitRange>[5:4]</bitRange>
