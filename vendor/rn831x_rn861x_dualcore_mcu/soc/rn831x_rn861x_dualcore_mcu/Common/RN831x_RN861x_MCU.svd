                  </field>
                  <field>
                     <name>IRSEL</name>
                     <access>read-write</access>
                     <bitRange>[12:12]</bitRange>
                     <description>Infrared modulation polarity selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>POSITIVE</name>
                           <description>Positive polarity (default driven level is high, low level is modulated).</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NEGATIVE</name>
                           <description>Negative polarity (default driven level is low, high level is modulated).</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LMSB</name>
                     <access>read-write</access>
                     <bitRange>[13:13]</bitRange>
