                        <enumeratedValue>
                           <name>STARTBIT</name>
                           <description>Start bit detection</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RXFALLINGEDGE</name>
                           <description>RX falling edge detection</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RXCOMPLETE</name>
                           <description>Data reception complete</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FRAMEMATCH</name>
                           <description>Frame data match successful</description>
                           <value>0x3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
