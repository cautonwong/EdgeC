         <baseAddress>0x20050000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x0014</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>CTRL</name>
               <description>Control Register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>EN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Mode selection bit</description>
                  </field>
                  <field>
                     <name>BUSCON</name>
                     <access>read-write</access>
                     <bitRange>[2:1]</bitRange>
                     <description>ACK Signal reception and transmission</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NONE</name>
                           <description>No Action</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>START</name>
                           <description>Start Generation</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>STOP</name>
                           <description>Stop Generation</description>
                           <value>0x2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>IRQE</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>Enable/disable interrupt</description>
                  </field>
                  <field>
                     <name>ACK</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>Bus control generate, start/stop condition generate</description>
                  </field>
                  <field>
                     <name>MODE</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>Enable module</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CLK</name>
               <description>Clock Configuration Register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <resetValue>0x1</resetValue>
               <fields>
                  <field>
                     <name>CLKDIV</name>
                     <access>read-write</access>
                     <bitRange>[2:0]</bitRange>
                     <description>Clock division parameter selection, set speed mode</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>1M8_STANDARD_MODE</name>
                           <description>Standard mode in system clock 1.8432MHz, fast mode is not supported in this clock</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3M6_STANDARD_MODE</name>
                           <description>Standard mode in system clock 3.6864MHz, fast mode is not supported in this clock</description>
                           <value>0x3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>7M3_STANDARD_MODE</name>
                           <description>Standard mode in system clock 7.3728MHz</description>
                           <value>0x4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>7M3_FAST_MODE</name>
                           <description>Fast mode in system clock 7.3728MHz</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>14M7_STANDARD_MODE</name>
                           <description>Standard mode in system clock 14.7456MHz</description>
                           <value>0x5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>14M7_FAST_MODE</name>
                           <description>Fast mode in system clock 14.7456MHz</description>
                           <value>0x3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>29M4_STANDARD_MODE</name>
                           <description>Standard mode in system clock 29.4912MHz</description>
                           <value>0x6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>29M4_FAST_MODE</name>
                           <description>Fast mode in system clock 29.4912MHz</description>
                           <value>0x4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>58M9_STANDARD_MODE</name>
                           <description>Standard mode in system clock 58.9824MHz</description>
                           <value>0x7</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>58M9_FAST_MODE</name>
                           <description>Fast mode in system clock 58.9824MHz</description>
                           <value>0x5</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>STA</name>
               <description>Status Indicator Register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>STPD</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Stop signal detection interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RX_NACK</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>Received NACK interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TRANC</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>Transmission completion interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TXEMPT</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>Transmit data register empty error flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>OVF</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>Receive overflow interrupt identifier bit  (slave mode)</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>COL</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>Transmi/receive conflict interrupt identifier bit (slave mode)</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>BUSY</name>
                     <access>read-only</access>
                     <bitRange>[6:6]</bitRange>
                     <description>Communication status flag</description>
                  </field>
                  <field>
                     <name>MATCH</name>
                     <access>read-only</access>
                     <bitRange>[7:7]</bitRange>
                     <description>Address matching bit, will clear after detecting start/stop singal</description>
                  </field>
                  <field>
                     <name>DIR</name>
                     <access>read-only</access>
                     <bitRange>[8:8]</bitRange>
                     <description>Read/Write direction</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>ADDR</name>
               <description>Device Address Register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>RW</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Master read/write direction control bit</description>
                  </field>
                  <field>
                     <name>SADR</name>
                     <access>read-write</access>
                     <bitRange>[7:1]</bitRange>
                     <description>Device address, can not write during address transmission. Master mode, represents the slave device. Slave mode, use this address to compare with the address sent by master.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DATA</name>
               <description>Transceiver Register</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TRDATA</name>
                     <bitRange>[7:0]</bitRange>
                     <description>Receive/send data. When host sends data, the cache should be empty before the data can be written</description>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
