                        <enumeratedValue>
                           <name>NORM</name>
                           <description>LOSC run normally</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FAIL</name>
                           <description>LOSC power down occured</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>VCC_BOI_FLAG</name>
                     <bitRange>[10:10]</bitRange>
