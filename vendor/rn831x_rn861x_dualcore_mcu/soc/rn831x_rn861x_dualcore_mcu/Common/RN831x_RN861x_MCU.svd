               </fields>
            </register>
            <register>
               <name>TAMPER1P1_TIME0</name>
               <description>TAMPER1 2st posedge freeze time register No.0 (seconds minute)</description>
               <addressOffset>0xB4</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>SEC</name>
                     <bitRange>[7:0]</bitRange>
                     <description>2nd posedge seconds timestamp</description>
                  </field>
                  <field>
                     <name>MIN</name>
                     <bitRange>[15:8]</bitRange>
                     <description>2nd posedge minute timestamp</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TAMPER1P1_TIME1</name>
               <description>TAMPER1 2st posedge freeze time register No.1 (hours date)</description>
               <addressOffset>0xB8</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>HOUR</name>
                     <bitRange>[7:0]</bitRange>
                     <description>2nd posedge hours timestamp</description>
                  </field>
                  <field>
                     <name>DAY</name>
                     <bitRange>[15:8]</bitRange>
                     <description>2nd posedge day timestamp</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TAMPER1P1_TIME2</name>
               <description>TAMPER1 2st posedge freeze time register No.2 (month year)</description>
               <addressOffset>0xBC</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>MT</name>
                     <bitRange>[7:0]</bitRange>
                     <description>2nd posedge month timestamp</description>
                  </field>
                  <field>
                     <name>YR</name>
                     <bitRange>[15:8]</bitRange>
                     <description>2nd posedge year timestamp</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TEMPOS</name>
               <description>auto compensation mode temperature offset register</description>
               <addressOffset>0xC4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">TEMPOS</name>
                     <bitRange>[5:0]</bitRange>
                     <description>auto compensation mode temperature offset bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TPSIN</name>
               <description>RTC auto temperature compensation ADC measure value input register</description>
               <addressOffset>0xC8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">TPSIN</name>
                     <bitRange>[12:0]</bitRange>
                     <description>RTC auto temperature compensation ADC measure value input bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CALPS</name>
               <description>Password register for RTC calibration registers(T0-T9)</description>
               <addressOffset>0xCC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CALPS</name>
                     <bitRange>[7:0]</bitRange>
                     <description>Enable RTC secondary calibration registers</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ENABLE</name>
                           <description>enable RTC secondary calibration</description>
                           <value>0xA8</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DISABLE</name>
                           <description>RTC secondary calibration disable</description>
                           <value>0x00</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CAL_T0</name>
               <description>RTC calibration register T0</description>
               <addressOffset>0xD0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CAL_T0</name>
                     <bitRange>[7:0]</bitRange>
                     <description>RTC calibration register T0 bits (to calibrate RTC for 0.25ppm per bit when temprature is lower than -30 degree)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CAL_T1</name>
               <description>RTC calibration register T1</description>
               <addressOffset>0xD4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CAL_T1</name>
                     <bitRange>[7:0]</bitRange>
                     <description>RTC calibration register T1 bits (to calibrate RTC for 0.25ppm per bit when temprature is between -30 and -20 degree)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CAL_T2</name>
               <description>RTC calibration register T2</description>
               <addressOffset>0xD8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CAL_T2</name>
                     <bitRange>[7:0]</bitRange>
                     <description>RTC calibration register T2 bits (to calibrate RTC for 0.25ppm per bit when temprature is between -20 and -10 degree)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CAL_T3</name>
               <description>RTC calibration register T3</description>
               <addressOffset>0xDC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CAL_T3</name>
                     <bitRange>[7:0]</bitRange>
                     <description>RTC calibration register T3 bits (to calibrate RTC for 0.25ppm per bit when temprature is between -10 and 0 degree)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CAL_T4</name>
               <description>RTC calibration register T4</description>
               <addressOffset>0xE0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CAL_T4</name>
                     <bitRange>[7:0]</bitRange>
                     <description>RTC calibration register T4 bits (to calibrate RTC for 0.25ppm per bit when temprature is between 0 and 10 degree)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CAL_T5</name>
               <description>RTC calibration register T5</description>
               <addressOffset>0xE4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CAL_T5</name>
                     <bitRange>[7:0]</bitRange>
                     <description>RTC calibration register T5 bits (to calibrate RTC for 0.25ppm per bit when temprature is between 35 and 45 degree)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CAL_T6</name>
               <description>RTC calibration register T6</description>
               <addressOffset>0xE8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CAL_T6</name>
                     <bitRange>[7:0]</bitRange>
                     <description>RTC calibration register T6 bits (to calibrate RTC for 0.25ppm per bit when temprature is between 45 and 55 degree)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CAL_T7</name>
               <description>RTC calibration register T7</description>
               <addressOffset>0xEC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CAL_T7</name>
                     <bitRange>[7:0]</bitRange>
                     <description>RTC calibration register T7 bits (to calibrate RTC for 0.25ppm per bit when temprature is between 55 and 65 degree)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CAL_T8</name>
               <description>RTC calibration register T8</description>
               <addressOffset>0xF0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CAL_T8</name>
                     <bitRange>[7:0]</bitRange>
                     <description>RTC calibration register T8 bits (to calibrate RTC for 0.25ppm per bit when temprature is between 65 and 75 degree)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CAL_T9</name>
               <description>RTC calibration register T9</description>
               <addressOffset>0xF4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CAL_T9</name>
                     <bitRange>[7:0]</bitRange>
                     <description>RTC calibration register T9 bits (to calibrate RTC for 0.25ppm per bit when temprature is higher than 75 degree)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TEMP2</name>
               <description>current chip temperature register No.2</description>
               <addressOffset>0xF8</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">TEMP2</name>
                     <bitRange>[11:0]</bitRange>
                     <description>current chipte mperature bits(TEMP[11] for sign, TEMP[10:4] for integer part,TEMP[3:0] for decimal part)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TAMPER2N0_TIME0</name>
               <description>TAMPER2 1st negedge freeze time register No.0 (seconds minute)</description>
               <addressOffset>0x100</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>SEC</name>
                     <bitRange>[7:0]</bitRange>
                     <description>1st negedge seconds timestamp</description>
                  </field>
                  <field>
                     <name>MIN</name>
                     <bitRange>[15:8]</bitRange>
                     <description>1st negedge minute timestamp</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TAMPER2N0_TIME1</name>
               <description>TAMPER2 1st negedge freeze time register No.1 (hours date)</description>
               <addressOffset>0x104</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>HOUR</name>
                     <bitRange>[7:0]</bitRange>
                     <description>1st negedge hours timestamp</description>
                  </field>
                  <field>
                     <name>DAY</name>
                     <bitRange>[15:8]</bitRange>
                     <description>1st negedge day timestamp</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TAMPER2N0_TIME2</name>
               <description>TAMPER2 1st negedge freeze time register No.2 (month year)</description>
               <addressOffset>0x108</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>MT</name>
                     <bitRange>[7:0]</bitRange>
                     <description>1st negedge month timestamp</description>
                  </field>
                  <field>
                     <name>YR</name>
                     <bitRange>[15:8]</bitRange>
                     <description>1st negedge year timestamp</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TAMPER2P0_TIME0</name>
               <description>TAMPER2 1st posedge freeze time register No.0 (seconds minute)</description>
               <addressOffset>0x10C</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>SEC</name>
                     <bitRange>[7:0]</bitRange>
                     <description>1st posedge seconds timestamp</description>
                  </field>
                  <field>
                     <name>MIN</name>
                     <bitRange>[15:8]</bitRange>
                     <description>1st posedge minute timestamp</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TAMPER2P0_TIME1</name>
               <description>TAMPER2 1st posedge freeze time register No.1 (hours date)</description>
               <addressOffset>0x110</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>HOUR</name>
                     <bitRange>[7:0]</bitRange>
                     <description>1st posedge hours timestamp</description>
                  </field>
                  <field>
                     <name>DAY</name>
                     <bitRange>[15:8]</bitRange>
                     <description>1st posedge day timestamp</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TAMPER2P0_TIME2</name>
               <description>TAMPER2 1st posedge freeze time register No.2 (month year)</description>
               <addressOffset>0x114</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>MT</name>
                     <bitRange>[7:0]</bitRange>
                     <description>1st posedge month timestamp</description>
                  </field>
                  <field>
                     <name>YR</name>
                     <bitRange>[15:8]</bitRange>
                     <description>1st posedge year timestamp</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TAMPER2N1_TIME0</name>
               <description>TAMPER2 2st negedge freeze time register No.0 (seconds minute)</description>
               <addressOffset>0x118</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>SEC</name>
                     <bitRange>[7:0]</bitRange>
                     <description>2nd negedge seconds timestamp</description>
                  </field>
                  <field>
                     <name>MIN</name>
                     <bitRange>[15:8]</bitRange>
                     <description>2nd negedge minute timestamp</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TAMPER2N1_TIME1</name>
               <description>TAMPER2 2st negedge freeze time register No.1 (hours date)</description>
               <addressOffset>0x11C</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>HOUR</name>
                     <bitRange>[7:0]</bitRange>
                     <description>2nd negedge hours timestamp</description>
                  </field>
                  <field>
                     <name>DAY</name>
                     <bitRange>[15:8]</bitRange>
                     <description>2nd negedge day timestamp</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TAMPER2N1_TIME2</name>
               <description>TAMPER2 2st negedge freeze time register No.2 (month year).When TAMPER_IF[4] = 1, the software-triggered time freeze(sub-seconds)</description>
               <addressOffset>0x120</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>MT</name>
                     <bitRange>[7:0]</bitRange>
                     <description>2nd negedge month timestamp</description>
                  </field>
                  <field>
                     <name>YR</name>
                     <bitRange>[15:8]</bitRange>
                     <description>2nd negedge year timestamp</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TAMPER2P1_TIME0</name>
               <description>TAMPER2 2st posedge freeze time register No.0 (seconds minute). When TAMPER_IF[4] = 1, the software-triggered time freeze (seconds minute).</description>
               <addressOffset>0x124</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>SEC</name>
                     <bitRange>[7:0]</bitRange>
                     <description>2nd posedge(or software) freeze seconds timestamp</description>
                  </field>
                  <field>
                     <name>MIN</name>
                     <bitRange>[15:8]</bitRange>
                     <description>2nd posedge(or software) freeze minute timestamp</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TAMPER2P1_TIME1</name>
               <description>TAMPER2 2st posedge freeze time register No.1 (hours date). When TAMPER_IF[4] = 1, the software-triggered time freeze (hours date).</description>
               <addressOffset>0x128</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>HOUR</name>
                     <bitRange>[7:0]</bitRange>
                     <description>2nd posedge(or software) freeze hours timestamp</description>
                  </field>
                  <field>
                     <name>DAY</name>
                     <bitRange>[15:8]</bitRange>
                     <description>2nd posedge(or software) freeze day timestamp</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TAMPER2P1_TIME2</name>
               <description>TAMPER2 2st posedge freeze time register No.2 (month year). When TAMPER_IF[4] = 1, the software-triggered time freeze (month year).</description>
               <addressOffset>0x12C</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>MT</name>
                     <bitRange>[7:0]</bitRange>
                     <description>2nd posedge(or software) freeze month timestamp</description>
                  </field>
                  <field>
                     <name>YR</name>
                     <bitRange>[15:8]</bitRange>
                     <description>2nd posedge(or software) freeze year timestamp</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>MODE1</name>
               <description>temperature compensation mode seletion register No.1</description>
               <addressOffset>0x130</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CURVE_SEL</name>
                     <bitRange>[15:0]</bitRange>
                     <description>temperature compensation mode seletion bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>XT1</name>
               <description>RTC temperature curve vertex temperature XT1 register</description>
               <addressOffset>0x134</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">XT1</name>
                     <bitRange>[12:0]</bitRange>
                     <description>RTC temperature curve vertex temperature bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>ALPHA</name>
               <description>temperature coefficient ALPHA config register(Coefficient of x^1)</description>
               <addressOffset>0x138</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">ALPHA</name>
                     <bitRange>[15:0]</bitRange>
                     <description>temperature coefficient ALPHA config bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>BETA</name>
               <description>temperature coefficient BETA config register(Coefficient of x^2)</description>
               <addressOffset>0x13C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">BETA</name>
                     <bitRange>[14:0]</bitRange>
                     <description>temperature coefficient BETA config bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>GAMMA</name>
               <description>temperature coefficient GAMMA config register(Coefficient of x^3)</description>
               <addressOffset>0x140</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">GAMMA</name>
                     <bitRange>[15:0]</bitRange>
                     <description>temperature coefficient GAMMA config bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>ZETA</name>
               <description>temperature coefficient ZETA config register(part1)(Coefficient of x^4 part1)</description>
               <addressOffset>0x144</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">ZETA</name>
                     <bitRange>[15:0]</bitRange>
                     <description>temperature coefficient ZETA config bits(part1)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>ZETAH</name>
               <description>temperature coefficient ZETA config register(part2)(Coefficient of x^4 part2)</description>
               <addressOffset>0x148</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">ZETAH</name>
                     <bitRange>[1:0]</bitRange>
                     <description>temperature coefficient ZETA config bits(part2)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TPS_START</name>
               <description>RTC temperature measure start register</description>
               <addressOffset>0x150</addressOffset>
               <size>32</size>
               <access>write-only</access>
               <fields>
                  <field>
                     <name fieldName="None">TPS_START</name>
                     <bitRange>[0:0]</bitRange>
                     <description>RTC temperature measure start bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TEMP_CAL</name>
               <description>RTC temperature register No.3(when config as RTC_CTRL_TSE=2,the register is temperature measure result after setted RTC_TPS_START and got flag of RTC_CTRL_CAL_BUSY=0 )</description>
               <addressOffset>0x154</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">TEMP_CAL</name>
                     <bitRange>[11:0]</bitRange>
                     <description>RTC temperature register No.3 bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>SSC</name>
               <description>Sub second value register</description>
               <addressOffset>0x158</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">SSC</name>
                     <bitRange>[15:0]</bitRange>
                     <description>Sub second value bits(1LSB=30.518us=1/32768s)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TAMPERIE</name>
               <description>Cover Detection Mechanism(tamper detection) interrupt enable register</description>
               <addressOffset>0x160</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TAMPER1PIE</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>TAMPER1 Positive edge interrupt enable bit</description>
                  </field>
                  <field>
                     <name>TAMPER1NIE</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>TAMPER1 Negative edge  interrupt enable bit</description>
                  </field>
                  <field>
                     <name>TAMPER2PIE</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>TAMPER2 Positive edge interrupt enable bit</description>
                  </field>
                  <field>
                     <name>TAMPER2NIE</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>TAMPER2 Negative edge  interrupt enable bit</description>
                  </field>
                  <field>
                     <name>STFIE</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>Software time freeze interrupt enable bit</description>
                  </field>
                  <field>
                     <name>KEYOTKIE</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>KEYOUT timed trigger interrupt enable bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TAMPERIF</name>
               <description>Cover Detection Mechanism(tamper detection) interrupt flag register</description>
               <addressOffset>0x164</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TAMPER1PIF</name>
                     <bitRange>[0:0]</bitRange>
                     <description>TAMPER1 Positive edge interrupt flag bit(when get flag, wait &gt;35us write to clear)</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TAMPER1NIF</name>
                     <bitRange>[1:1]</bitRange>
                     <description>TAMPER1 Negative edge  interrupt flag bit(when get flag, wait &gt;35us write to clear)</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TAMPER2PIF</name>
                     <bitRange>[2:2]</bitRange>
                     <description>TAMPER2 Positive edge interrupt flag bit(when get flag, wait &gt;35us write to clear)</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TAMPER2NIF</name>
                     <bitRange>[3:3]</bitRange>
                     <description>TAMPER2 Negative edge  interrupt flag bit(when get flag, wait &gt;35us write to clear)</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>STFIF</name>
                     <bitRange>[4:4]</bitRange>
                     <description>Software time freeze interrupt flag bit</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>KEYOTKIF</name>
                     <bitRange>[5:5]</bitRange>
                     <description>KEYOUT timed trigger interrupt flag bit(when get flag, wait &gt;35us write to clear)</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
               </fields>
            </register>
            <register>
