                        <enumeratedValue>
                           <name>1</name>
                           <description>1 stop bit.</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2</name>
                           <description>2 stop bits.</description>
                           <value>0x1</value>
