                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_PRI2_CTRL</name>
               <description>DMA Access SRAM Priority Configuration Register 2</description>
               <addressOffset>0x510</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>DMA_CH0</name>
                     <access>read-write</access>
                     <bitRange>[1:0]</bitRange>
                     <description>Channel 0: First level arbitration result channel access SRAM priority configuration.</description>
                  </field>
                  <field>
                     <name>DMA_CH1</name>
                     <access>read-write</access>
                     <bitRange>[3:2]</bitRange>
                     <description>Channel 1: General DMA read channel (MDMA0x_RD/MDMA1x_RD) access SRAM priority configuration.</description>
                  </field>
                  <field>
                     <name>DMA_CH2</name>
                     <access>read-write</access>
                     <bitRange>[5:4]</bitRange>
                     <description>Channel 2: General DMA write channel (MDMA0x_WR/MDMA1x_WR) access SRAM priority configuration.</description>
                  </field>
                  <field>
                     <name>DMA_CH3</name>
                     <access>read-write</access>
                     <bitRange>[7:6]</bitRange>
                     <description>Channel 3: DSP channel access SRAM priority configuration.</description>
                  </field>
                  <field>
                     <name>DMA_CH4</name>
                     <access>read-write</access>
                     <bitRange>[9:8]</bitRange>
                     <description>Channel 4: CORE0/CORE1 channel access SRAM priority configuration.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CORE1_STA</name>
               <description>Core1 STOP status registers</description>
               <addressOffset>0x51C</addressOffset>
               <size>33</size>
               <fields>
                  <field>
                     <name>CORE1_STOP_FLAG</name>
                     <bitRange>[0:0]</bitRange>
                     <description>Core1 STOP State Indication</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CHIP_ID</name>
               <description>CHIP ID Register</description>
               <addressOffset>0x800</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CHIP_ID</name>
                     <bitRange>[15:0]</bitRange>
                     <description>CHIP_ID: C248</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DIE_VER</name>
               <description>Chip Version Register</description>
               <addressOffset>0x804</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>VERSION</name>
                     <access>read-only</access>
                     <bitRange>[3:0]</bitRange>
                     <description>Version Number</description>
                  </field>
                  <field>
                     <name>CHIP_MODEL</name>
                     <access>read-only</access>
                     <bitRange>[31:4]</bitRange>
                     <description>Chip Model: A9701C, Encoded in ASCII</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>FAB_UID0</name>
               <description>Chip Unique ID 0 Register</description>
               <addressOffset>0x808</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>LOT_NUM</name>
                     <bitRange>[31:0]</bitRange>
                     <description>This register is configured by the bootloader</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>FAB_UID1</name>
               <description>Chip Unique ID 1 Register</description>
               <addressOffset>0x80C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>WAFER_ID</name>
                     <access>read-only</access>
                     <bitRange>[7:0]</bitRange>
                     <description>the wafer WAFER ID information</description>
                  </field>
                  <field>
                     <name>X_LABEL</name>
                     <access>read-only</access>
                     <bitRange>[19:8]</bitRange>
                     <description>DIE X-coordinate</description>
                  </field>
                  <field>
                     <name>Y_LABEL</name>
                     <access>read-only</access>
                     <bitRange>[31:20]</bitRange>
                     <description>DIE Y-coordinate</description>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral>
         <name>TC0_CORE0</name>
         <description>A 32-bit timer</description>
         <groupName>TIMER</groupName>
         <baseAddress>0x2009C000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x50</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>CNT</name>
               <description>current counting value register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">CNT</name>
                     <bitRange>[31:0]</bitRange>
                     <description>current Timer counter value bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>PS</name>
               <description>prescaler value register of the counter clock</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">PS</name>
                     <bitRange>[15:0]</bitRange>
                     <description>prescaler value bits of the counter clock</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DN</name>
               <description>target counting value register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">DN</name>
                     <bitRange>[31:0]</bitRange>
                     <description>target counting value bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CCD0</name>
               <description>capture(compare) channel No.0 data register</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CCD0</name>
                     <bitRange>[31:0]</bitRange>
                     <description>capture(compare) channel No.0 data bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CCD1</name>
               <description>capture(compare) channel No.1 data register</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">CCD1</name>
                     <bitRange>[31:0]</bitRange>
                     <description>capture(compare) channel No.1 data bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CCFG</name>
               <description>clock config register</description>
               <addressOffset>0x1C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CM</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>clock mode selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>INT</name>
                           <description>using on-chip system clock as input counting clock</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EXT</name>
                           <description>using external clock(to the timer) as input counting clock(refer to bitfield CS of register TC_CCFG for clock selection)</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FLTEN</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>external clock source filter enable bit</description>
                  </field>
                  <field>
                     <name>ECLKMODE</name>
                     <access>read-write</access>
                     <bitRange>[3:2]</bitRange>
                     <description>external clock mode selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PE</name>
                           <description>every posedge found on input recognized as a couting event</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NE</name>
                           <description>every negedge found on input recognized as a couting event</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BE</name>
                           <description>both posedge and negedge found on input recognized as a as a couting event</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FLTOPT</name>
                     <access>read-write</access>
                     <bitRange>[11:4]</bitRange>
                     <description>external clock source filter clock cycles set bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CTRL</name>
               <description>control register</description>
               <addressOffset>0x20</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>START</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>timer start bit</description>
                  </field>
                  <field>
                     <name>SLVEN</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>slave mode enable</description>
                  </field>
                  <field>
                     <name>SLVFLTEN</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>slave mode input filter enable</description>
                  </field>
                  <field>
                     <name>OPS</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>one pulse mode selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>one pulse mode disabled(timer continue counting when overflow)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>one pulse mode enabled(timer stop counting when overflow)</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SLVTRGMODE</name>
                     <access>read-write</access>
                     <bitRange>[6:5]</bitRange>
                     <description>slave mode polarity control selection bits</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PE</name>
                           <description>clean internal counter at posedge</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NE</name>
                           <description>clean internal counter at negedge</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BE</name>
                           <description>clean internal counter at both posedge and negedge</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>GM</name>
                           <description>level sensitive gate control</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SLVFLTOPT</name>
                     <access>read-write</access>
                     <bitRange>[14:7]</bitRange>
                     <description>slave mode input filter parameter configuration bits</description>
                  </field>
                  <field>
                     <name>SLVGATELVL</name>
                     <access>read-write</access>
                     <bitRange>[16:16]</bitRange>
                     <description>slave mode gating level control bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>LOW</name>
                           <description>select low level sensitive gate</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HIGH</name>
                           <description>select high level sensitive gate</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DBGSTBDIS</name>
                     <access>read-write</access>
                     <bitRange>[17:17]</bitRange>
                     <description>debugger halt standby enable/disable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PAUSE</name>
