                     <name>BUSY</name>
                     <access>read-only</access>
                     <bitRange>[6:6]</bitRange>
                     <description>LCD busy bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CLKDIV</name>
               <description>LCD clock control register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <resetValue>0x0</resetValue>
               <fields>
