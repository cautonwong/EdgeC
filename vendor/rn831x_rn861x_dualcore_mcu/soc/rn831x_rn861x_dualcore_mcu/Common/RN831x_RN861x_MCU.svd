      <peripheral derivedFrom="AOS_CORE0">
         <name>AOS_CORE1</name>
         <description>AOS Module core1</description>
         <groupName>AOS_CORE1</groupName>
         <baseAddress>0xA0088000</baseAddress>
      </peripheral>
      <peripheral>
         <name>CAN_CORE0</name>
         <description>Controller Area Network Module</description>
         <groupName>CAN</groupName>
         <baseAddress>0x20058000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x321C</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>MCR</name>
               <description>CAN Module Configuration Register.</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <resetValue>0xD890000F</resetValue>
               <fields>
                  <field>
                     <name>MAXMB</name>
                     <access>read-write</access>
                     <bitRange>[6:0]</bitRange>
                     <description>The number of the last MB that will take part in the matching and arbitration processes.</description>
                  </field>
                  <field>
                     <name>IDAM</name>
                     <access>read-write</access>
                     <bitRange>[9:8]</bitRange>
                     <description>The format of the Rx FIFO ID Filter Table elements.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>One full ID (standard and extended) per ID Filter Table element.</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>Two full standard IDs or two partial 14-bit extended IDs per ID 
Filter Table element.</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2</name>
                           <description>Four partial 8-bit standard IDs per ID Filter Table element.</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3</name>
                           <description>All frames rejected.</description>
                           <value>0x3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>AEN</name>
                     <access>read-write</access>
                     <bitRange>[12:12]</bitRange>
                     <description>Enable abort.</description>
                  </field>
                  <field>
                     <name>LPRIOEN</name>
                     <access>read-write</access>
                     <bitRange>[13:13]</bitRange>
                     <description>Enable Local Priority.</description>
                  </field>
                  <field>
                     <name>PNETEN</name>
                     <access>read-write</access>
                     <bitRange>[14:14]</bitRange>
                     <description>Enable Pretended Network.</description>
                  </field>
                  <field>
                     <name>DMA</name>
                     <access>read-write</access>
                     <bitRange>[15:15]</bitRange>
                     <description>Enable DMA feature for Rx FIFO.</description>
                  </field>
                  <field>
                     <name>IRMQ</name>
                     <access>read-write</access>
                     <bitRange>[16:16]</bitRange>
                     <description>Enable individual Rx masking and queue feature.</description>
                  </field>
                  <field>
                     <name>SRXDIS</name>
                     <access>read-write</access>
                     <bitRange>[17:17]</bitRange>
                     <description>Disable self reception.</description>
                  </field>
                  <field>
                     <name>DOZE</name>
                     <access>read-write</access>
                     <bitRange>[18:18]</bitRange>
                     <description>Enable sleep mode.</description>
                  </field>
                  <field>
                     <name>WAKSRC</name>
                     <access>read-write</access>
                     <bitRange>[19:19]</bitRange>
                     <description>...</description>
                  </field>
                  <field>
                     <name>LPMACK</name>
                     <access>read-write</access>
                     <bitRange>[20:20]</bitRange>
                     <description>Low-Power Mode Acknowledge.</description>
                  </field>
                  <field>
                     <name>WRNEN</name>
                     <access>read-write</access>
                     <bitRange>[21:21]</bitRange>
                     <description>Warning Interrupt Enable.</description>
                  </field>
                  <field>
                     <name>SLFWAK</name>
                     <access>read-write</access>
                     <bitRange>[22:22]</bitRange>
                     <description>Wake-up byself Enable.</description>
                  </field>
                  <field>
                     <name>FRZACK</name>
                     <access>read-write</access>
                     <bitRange>[24:24]</bitRange>
                     <description>Freeze Mode Acknowledge.</description>
                  </field>
                  <field>
                     <name>SOFTRST</name>
                     <access>read-write</access>
                     <bitRange>[25:25]</bitRange>
                     <description>Soft reset.</description>
                  </field>
                  <field>
                     <name>WAKMSK</name>
                     <access>read-write</access>
                     <bitRange>[26:26]</bitRange>
                     <description>Enable Wake-up Interrupt.</description>
                  </field>
                  <field>
                     <name>NOTRDY</name>
                     <access>read-write</access>
                     <bitRange>[27:27]</bitRange>
                     <description>CAN is either in Disable or Freeze mode.</description>
                  </field>
                  <field>
                     <name>HALT</name>
                     <access>read-write</access>
                     <bitRange>[28:28]</bitRange>
                     <description>Enter Freeze mode if the FRZ bit is asserted.</description>
                  </field>
                  <field>
                     <name>RFEN</name>
                     <access>read-write</access>
                     <bitRange>[29:29]</bitRange>
                     <description>Enable Rx FIFO.</description>
                  </field>
                  <field>
                     <name>FRZ</name>
                     <access>read-write</access>
                     <bitRange>[30:30]</bitRange>
                     <description>Enabled to enter Freeze mode.</description>
                  </field>
                  <field>
                     <name>MDIS</name>
                     <access>read-write</access>
                     <bitRange>[31:31]</bitRange>
                     <description>Disable the CAN module as well as the clocks to the PE and CHI submodules.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CTRL1</name>
               <description>CAN Control Register 1.</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <resetValue>0x0</resetValue>
               <fields>
                  <field>
                     <name>PROPSEG</name>
                     <access>read-write</access>
                     <bitRange>[2:0]</bitRange>
                     <description>Propagation Segment - Defines the length of the Propagation Segment in the bit time.</description>
                  </field>
                  <field>
                     <name>LOM</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>Configures the CAN to operate in Listen-Only mode.</description>
                  </field>
                  <field>
                     <name>LBUF</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>The ordering mechanism for message buffer transmission.</description>
                  </field>
                  <field>
                     <name>TSYN</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>Timer Sync - a mechanism that resets the free-running timer each time a message is received in MB0.</description>
                  </field>
                  <field>
                     <name>BOFFRREC</name>
                     <access>read-write</access>
                     <bitRange>[6:6]</bitRange>
                     <description>Defines how the CAN recovers from Bus Off state.</description>
                  </field>
                  <field>
                     <name>SMP</name>
                     <access>read-write</access>
                     <bitRange>[7:7]</bitRange>
                     <description>The sampling mode of CAN bits at the Rx input.</description>
                  </field>
                  <field>
                     <name>RWRNMSK</name>
                     <access>read-write</access>
                     <bitRange>[10:10]</bitRange>
                     <description>Rx Warning Interrupt (CAN_ESR1.RWRNINT) Mask.</description>
                  </field>
                  <field>
                     <name>TWRNMSK</name>
                     <access>read-write</access>
                     <bitRange>[11:11]</bitRange>
                     <description>Tx Warning Interrupt (CAN_ESR1.TWRNINT) Mask.</description>
                  </field>
                  <field>
                     <name>LPB</name>
                     <access>read-write</access>
                     <bitRange>[12:12]</bitRange>
                     <description>Loop-Back enabled.</description>
                  </field>
                  <field>
                     <name>ERRMSK</name>
                     <access>read-write</access>
                     <bitRange>[14:14]</bitRange>
                     <description>Error Interrupt (CAN_ESR1.ERRINT) Mask.</description>
                  </field>
                  <field>
                     <name>BOFFMSK</name>
                     <access>read-write</access>
                     <bitRange>[15:15]</bitRange>
                     <description>Bus Off Interrupt (CAN_ESR1.BOFFINT) Mask.</description>
                  </field>
                  <field>
                     <name>PSEG2</name>
                     <access>read-write</access>
                     <bitRange>[18:16]</bitRange>
                     <description>Phase Segment 2 - Defines the length of Phase Segment 2 in the bit time.</description>
                  </field>
                  <field>
                     <name>PSEG1</name>
                     <access>read-write</access>
                     <bitRange>[21:19]</bitRange>
                     <description>Phase Segment 1 - Defines the length of Phase Segment 1 in the bit time.</description>
                  </field>
                  <field>
                     <name>RJW</name>
                     <access>read-write</access>
                     <bitRange>[23:22]</bitRange>
                     <description>Resync Jump Width - Defines the maximum number of Tq that a bit time can be changed by one re-synchronization.</description>
                  </field>
                  <field>
                     <name>PRESDIV</name>
                     <access>read-write</access>
                     <bitRange>[31:24]</bitRange>
                     <description>Prescaler Division Factor - Defines the ratio between the PE clock frequency and the Serial Clock (Sclock) frequency.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TIMER</name>
               <description>CAN Free Running Timer Register.</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <resetValue>0x0</resetValue>
               <fields>
                  <field>
                     <name>TIMER</name>
                     <access>read-write</access>
                     <bitRange>[15:0]</bitRange>
                     <description>Timer Value: Contains the free-running counter value.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>RXMGMASK</name>
               <description>CAN Rx Mailboxes Global Mask Register.</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>MG</name>
                     <access>read-write</access>
                     <bitRange>[31:0]</bitRange>
                     <description>Rx Mailboxes Global Mask Bit.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>RX14MASK</name>
               <description>CAN Rx14 Mask Register.</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>RX14M</name>
                     <access>read-write</access>
                     <bitRange>[31:0]</bitRange>
                     <description>Rx MB14 Mask Bits.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>RX15MASK</name>
               <description>CAN Rx15 Mask Register.</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>RX15M</name>
                     <access>read-write</access>
                     <bitRange>[31:0]</bitRange>
                     <description>Rx MB15 Mask Bits.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>ECR</name>
               <description>CAN Error Counter Register.</description>
               <addressOffset>0x1C</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <resetValue>0x0</resetValue>
               <fields>
                  <field>
                     <name>TXERRCNT</name>
                     <access>read-write</access>
                     <bitRange>[7:0]</bitRange>
                     <description>Transmit Error Counter - Calculate all errors detected in transmitted messages.</description>
                  </field>
                  <field>
                     <name>RXERRCNT</name>
                     <access>read-write</access>
                     <bitRange>[15:8]</bitRange>
                     <description>Receive Error Counter - Calculate all errors detected in received messages.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>ESR1</name>
               <description>CAN Error and Status Register 1.</description>
               <addressOffset>0x20</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <resetValue>0x0</resetValue>
               <fields>
                  <field>
                     <name>WAKINT</name>
                     <access>write-only</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Wake-up Interrupt.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>ERRINT</name>
                     <access>write-only</access>
                     <bitRange>[1:1]</bitRange>
                     <description>Error Interrupt.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>BOFFINT</name>
                     <access>write-only</access>
                     <bitRange>[2:2]</bitRange>
                     <description>Bus Off Interrupt.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RX</name>
                     <access>read-only</access>
                     <bitRange>[3:3]</bitRange>
                     <description>CAN is receiving a message.</description>
                  </field>
                  <field>
                     <name>FLTCONF</name>
                     <access>read-only</access>
                     <bitRange>[5:4]</bitRange>
                     <description>Fault State of the CAN module.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ERR_ACTIVE</name>
                           <description>Error Active.</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ERR_PASSIVE</name>
                           <description>Error passive.</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BUF_OFF</name>
                           <description>Buf off.</description>
                           <value>0x2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TX</name>
                     <access>read-only</access>
                     <bitRange>[6:6]</bitRange>
                     <description>CAN is transmitting a message.</description>
                  </field>
                  <field>
                     <name>IDLE</name>
                     <access>read-only</access>
                     <bitRange>[7:7]</bitRange>
                     <description>CAN bus is in IDLE state.</description>
                  </field>
                  <field>
                     <name>RXWRN</name>
                     <access>read-only</access>
                     <bitRange>[8:8]</bitRange>
                     <description>Rx Error Warning - Indicates when repetitive errors are occurring during message reception.</description>
                  </field>
                  <field>
                     <name>TXWRN</name>
                     <access>read-only</access>
                     <bitRange>[9:9]</bitRange>
                     <description>TX Error Warning - Indicates when repetitive errors are occurring during message transmission.</description>
                  </field>
                  <field>
                     <name>STFERR</name>
                     <access>read-only</access>
                     <bitRange>[10:10]</bitRange>
                     <description>Stuffing Error - Indicates that a Stuffing Error in a non-FD message or in the arbitration or data phase of a CAN FD message or in the arbitration or data phase of a CAN FD message was detected by the receiver node.</description>
                  </field>
                  <field>
                     <name>FRMERR</name>
                     <access>read-only</access>
                     <bitRange>[11:11]</bitRange>
                     <description>Form Error - Indicates that a Form Error was detected by the receiver node (that is, a fixed-form bit field contains at least one illegal bit).</description>
                  </field>
                  <field>
                     <name>CRCERR</name>
                     <access>read-only</access>
                     <bitRange>[12:12]</bitRange>
                     <description>Cyclic Redundancy Check Error - Indicates that a CRC Error was detected by the receiver node (that is, the calculated CRC is different from the received CRC).</description>
                  </field>
                  <field>
                     <name>ACKERR</name>
                     <access>read-only</access>
                     <bitRange>[13:13]</bitRange>
                     <description>Acknowledge Error - Indicates that an Acknowledge Error was detected by the transmitter node (that is, a dominant bit wasn't detected during the ACK SLOT).</description>
                  </field>
                  <field>
                     <name>BIT0ERR</name>
                     <access>read-only</access>
                     <bitRange>[14:14]</bitRange>
                     <description>Bit0 Error - Indicates when an inconsistency occurs between the transmitted and the received bit in a message.</description>
                  </field>
                  <field>
                     <name>BIT1ERR</name>
                     <access>read-only</access>
                     <bitRange>[15:15]</bitRange>
                     <description>Bit1 Error - Indicates when an inconsistency occurs between the transmitted and the received bit in a message.</description>
                  </field>
                  <field>
                     <name>RWRNINT</name>
                     <access>write-only</access>
                     <bitRange>[16:16]</bitRange>
                     <description>Rx Warning Interrupt Flag.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TWRNINT</name>
                     <access>write-only</access>
                     <bitRange>[17:17]</bitRange>
                     <description>Tx Warning Interrupt Flag.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>SYNCH</name>
                     <access>read-only</access>
                     <bitRange>[18:18]</bitRange>
                     <description>CAN Synchronization Status.</description>
                  </field>
                  <field>
                     <name>BOFFDONEINT</name>
                     <access>write-only</access>
                     <bitRange>[19:19]</bitRange>
                     <description>Bus Off Done Interrupt.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>ERROVR</name>
                     <access>write-only</access>
                     <bitRange>[21:21]</bitRange>
                     <description>Error Overrun - Indicates that an error condition occurred when any error flag is already set.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>IMASK1</name>
               <description>CAN Interrupt Mask Register 1.</description>
               <addressOffset>0x28</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <resetValue>0x0</resetValue>
               <fields>
                  <field>
                     <name>BUF15TO0M</name>
                     <access>read-write</access>
                     <bitRange>[15:0]</bitRange>
                     <description>MBi Mask Bits - Each bit enables or disables the corresponding interrupt for MB31 to MB0.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IFLAG1</name>
               <description>CAN Interrupt Flag Register 1.</description>
               <addressOffset>0x30</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <resetValue>0x0</resetValue>
               <fields>
                  <field>
                     <name>BUF0I</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>MB0 Interrupt or Clear FIFO bit.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>BUF1I</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>MB1 Interrupt or Reserved.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>BUF2I</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>MB2 Interrupt or Reserved.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>BUF3I</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>MB3 Interrupt or Reserved.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>BUF4I</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>MB4 Interrupt or Reserved.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>BUF5I</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>MB5 Interrupt or Frames Available in Rx FIFO.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>BUF6I</name>
                     <access>read-write</access>
                     <bitRange>[6:6]</bitRange>
                     <description>MB6 Interrupt or Rx FIFO Warning.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>BUF7I</name>
                     <access>read-write</access>
                     <bitRange>[7:7]</bitRange>
                     <description>MB7 Interrupt or Rx FIFO Overflow.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>BUF15TO8I</name>
                     <access>read-write</access>
                     <bitRange>[15:8]</bitRange>
                     <description>MBi Interrupt Flag Bits - Each bit flags the corresponding Message Buffer Interrupt for MB15 to MB8.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CTRL2</name>
               <description>CAN Control Register 2.</description>
               <addressOffset>0x34</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>BTEEN</name>
                     <access>read-write</access>
                     <bitRange>[13:13]</bitRange>
                     <description>Baudrate Config Type.</description>
                  </field>
                  <field>
                     <name>TIMERSRC</name>
                     <access>read-write</access>
                     <bitRange>[15:15]</bitRange>
                     <description>Timer Source choice.</description>
                  </field>
                  <field>
                     <name>EACEN</name>
                     <access>read-write</access>
                     <bitRange>[16:16]</bitRange>
                     <description>Entire Frame Arbitration Field Comparison Enable For Rx Mailboxes.</description>
                  </field>
                  <field>
                     <name>RRS</name>
                     <access>read-write</access>
                     <bitRange>[17:17]</bitRange>
                     <description>Remote Request Storing.</description>
                  </field>
                  <field>
                     <name>MRP</name>
                     <access>read-write</access>
                     <bitRange>[18:18]</bitRange>
                     <description>Mailboxes Reception Priority.</description>
                  </field>
                  <field>
                     <name>TASD</name>
                     <access>read-write</access>
                     <bitRange>[23:19]</bitRange>
                     <description>Tx Arbitration Start Delay - Indicates how many CAN bits the Tx arbitration process start point can be delayed from the first bit of CRC field on CAN bus. See "23.3.10.6 Tx Arbitration start delay".</description>
                  </field>
                  <field>
                     <name>RFFN</name>
                     <access>read-write</access>
                     <bitRange>[27:24]</bitRange>
                     <description>The number of Rx FIFO filters, as shown in Table 23-12 RFFN must not be programmed with values that make the number of MBs occupied by Rx FIFO and ID Filter exceed the number of mailboxes defined by CAN_MCR.MAXMB.</description>
                  </field>
                  <field>
                     <name>BOFFDONEMSK</name>
                     <access>read-write</access>
                     <bitRange>[30:30]</bitRange>
                     <description>Bus Off Done Interrupt (CAN_ESR1.BOFFDONEINT) Mask.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>ESR2</name>
               <description>CAN Error and Status Register 2.</description>
               <addressOffset>0x38</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <resetValue>0x0</resetValue>
               <fields>
                  <field>
                     <name>IMB</name>
                     <access>read-only</access>
                     <bitRange>[13:13]</bitRange>
                     <description>Inactive Mailbox.</description>
                  </field>
                  <field>
                     <name>VPS</name>
                     <access>read-only</access>
                     <bitRange>[14:14]</bitRange>
                     <description>Indicates whether CAN_ESR2.IMB and CAN_ESR2.LPTM contents are currently valid or 
not.</description>
                  </field>
                  <field>
                     <name>TWAMSK</name>
                     <access>read-write</access>
                     <bitRange>[15:15]</bitRange>
                     <description>Time Overflow Interrupt Enable.</description>
                  </field>
                  <field>
                     <name>LPTM</name>
                     <access>read-only</access>
                     <bitRange>[22:16]</bitRange>
                     <description>Lowest Priority Tx Mailbox.</description>
                  </field>
                  <field>
                     <name>TWAINT</name>
                     <access>write-only</access>
                     <bitRange>[31:31]</bitRange>
                     <description>Time Overflow Interrupt Flag.</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CRCR</name>
               <description>CAN CRC Register.</description>
               <addressOffset>0x44</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <resetValue>0x0</resetValue>
               <fields>
                  <field>
                     <name>TXCRC</name>
                     <access>read-only</access>
                     <bitRange>[14:0]</bitRange>
                     <description>Transmitted CRC Value - Indicates the CRC value of the last transmitted message.</description>
                  </field>
                  <field>
                     <name>MBCRC</name>
                     <access>read-only</access>
                     <bitRange>[22:16]</bitRange>
                     <description>CRC Mailbox - Indicates the number of the mailbox corresponding to the value in the CAN_CRCR.TXCRC field.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>RXFGMASK</name>
               <description>CAN Rx FIFO Global Mask Register.</description>
               <addressOffset>0x48</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>FGM</name>
                     <access>read-write</access>
                     <bitRange>[31:0]</bitRange>
                     <description>Rx FIFO Global Mask Bits - Mask the ID Filter Table elements bits.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>RXFIR</name>
               <description>CAN Rx FIFO Infomation Register.</description>
               <addressOffset>0x4C</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>IDHIT</name>
                     <access>read-write</access>
                     <bitRange>[8:0]</bitRange>
                     <description>ID Acceptance Filter Hit Indicator - Indicates which ID Acceptance Filter (IDAF) was hit by the received message in the Rx FIFO.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CBT</name>
               <description>CAN Bit Timing Register.</description>
               <addressOffset>0x50</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <resetValue>0x0</resetValue>
               <fields>
                  <field>
                     <name>EPSEG2</name>
                     <access>read-write</access>
                     <bitRange>[4:0]</bitRange>
                     <description>Extended Phase Segment 2.</description>
                  </field>
                  <field>
                     <name>EPSEG1</name>
                     <access>read-write</access>
                     <bitRange>[9:5]</bitRange>
                     <description>Extended Phase Segment 1.</description>
                  </field>
                  <field>
                     <name>EPROPSEG</name>
                     <access>read-write</access>
                     <bitRange>[15:10]</bitRange>
                     <description>Extended Propagation Segment.</description>
                  </field>
                  <field>
                     <name>ERJW</name>
                     <access>read-write</access>
                     <bitRange>[20:16]</bitRange>
                     <description>Extended Resync Jump Width.</description>
                  </field>
                  <field>
                     <name>ERPRSDIV</name>
                     <access>read-write</access>
                     <bitRange>[30:21]</bitRange>
                     <description>Extended Prescaler Division Factor.</description>
                  </field>
                  <field>
                     <name>BTF</name>
                     <access>read-write</access>
                     <bitRange>[31:31]</bitRange>
                     <description>Bit Timing Format - Enables the use of extended CAN bit timing fields EPRESDIV, EPROPSEG, EPSEG1, EPSEG2 and ERJW, replacing the CAN bit timing variables defined in CAN_CTRL1.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>MB0_CS</name>
               <description>CAN Mailbox 0 CS Register.</description>
               <addressOffset>0x80</addressOffset>
               <size>32</size>
               <access>read-write</access>
               <fields>
                  <field>
                     <name>TIME_STAMP</name>
                     <access>read-write</access>
                     <bitRange>[15:0]</bitRange>
                     <description>Time Stamp Field.</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>...</description>
                           <value>0x0001</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>...</description>
                           <value>0x0002</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2</name>
                           <description>...</description>
                           <value>0x0004</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3</name>
                           <description>...</description>
                           <value>0x0008</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4</name>
                           <description>...</description>
                           <value>0x0010</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>5</name>
                           <description>...</description>
                           <value>0x0020</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>6</name>
                           <description>...</description>
                           <value>0x0040</value>
