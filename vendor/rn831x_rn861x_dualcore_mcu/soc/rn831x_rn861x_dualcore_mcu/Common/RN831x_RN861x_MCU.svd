                           <name>ON</name>
                           <description>enable LOSC</description>
                           <value>0x00</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OFF</name>
                           <description>disable LOSC</description>
                           <value>0xA8</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LOSC_WEN</name>
                     <bitRange>[8:8]</bitRange>
