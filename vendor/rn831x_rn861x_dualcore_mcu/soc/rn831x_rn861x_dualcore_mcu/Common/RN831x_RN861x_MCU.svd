                     <description>Receive Data Interrupt Enable</description>
                  </field>
                  <field>
                     <name>ERRIE</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>Error Interrupt Enable</description>
                  </field>
                  <field>
                     <name>STOPS</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>Stop Bit Length</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>1</name>
                           <description>1 stop bit.</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2</name>
                           <description>2 stop bits.</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DATLEN</name>
                     <access>read-write</access>
                     <bitRange>[6:5]</bitRange>
                     <description>Data Length</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>5B</name>
                           <description>5 data bits</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>6B</name>
                           <description>6 data bits</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>7B</name>
                           <description>7 data bits</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>8B</name>
                           <description>8 data bits</description>
                           <value>0x3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PARS</name>
                     <access>read-write</access>
                     <bitRange>[9:7]</bitRange>
                     <description>Parity Selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NONE</name>
                           <description>No parity</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ODD</name>
                           <description>Odd parity</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EVEN</name>
                           <description>Even parity</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ZERO</name>
                           <description>Fixed to 0 parity</description>
                           <value>0x3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ONE</name>
                           <description>Fixed to 1 parity</description>
                           <value>0x4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>USER_DEFINED</name>
                           <description>User-defined parity</description>
                           <value>0x5</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>IRE</name>
                     <access>read-write</access>
                     <bitRange>[10:10]</bitRange>
                     <description>Infrared Modulation Enable</description>
                  </field>
                  <field>
                     <name>ILBE</name>
                     <access>read-write</access>
                     <bitRange>[11:11]</bitRange>
                     <description>Internal Loopback Enable</description>
                  </field>
                  <field>
                     <name>IRSEL</name>
                     <access>read-write</access>
                     <bitRange>[12:12]</bitRange>
                     <description>Infrared modulation polarity selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>POSITIVE</name>
                           <description>Positive polarity (default driven level is high, low level is modulated).</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NEGATIVE</name>
                           <description>Negative polarity (default driven level is low, high level is modulated).</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LMSB</name>
                     <access>read-write</access>
                     <bitRange>[13:13]</bitRange>
                     <description>LSB/MSB transmission order</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>LSB_FIRST</name>
                           <description>LSB first</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MSB_FIRST</name>
                           <description>MSB first</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NEG</name>
                     <access>read-write</access>
                     <bitRange>[14:14]</bitRange>
                     <description>Data polarity selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>POSITIVE</name>
                           <description>Positive polarity (default driven level is high, data is not inverted).</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NEGATIVE</name>
                           <description>Negative polarity (default driven level is low, data is inverted).</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PF_IE</name>
                     <access>read-write</access>
                     <bitRange>[15:15]</bitRange>
                     <description>Interrupt Enable for receiving PF pulse</description>
                  </field>
                  <field>
                     <name>QF_IE</name>
                     <access>read-write</access>
                     <bitRange>[16:16]</bitRange>
                     <description>Interrupt Enable for receiving QF pulse</description>
                  </field>
                  <field>
                     <name>FPF_IE</name>
                     <access>read-write</access>
                     <bitRange>[17:17]</bitRange>
                     <description>Interrupt Enable for receiving FPF pulse</description>
                  </field>
                  <field>
                     <name>CF_ERR_IE</name>
                     <access>read-write</access>
                     <bitRange>[18:18]</bitRange>
                     <description>Interrupt Enable for UART_CF mode timeout error</description>
                  </field>
                  <field>
                     <name>TW_IE</name>
                     <access>read-write</access>
                     <bitRange>[19:19]</bitRange>
                     <description>Interrupt Enable for low-level signal transmission completion</description>
                  </field>
                  <field>
                     <name>CAL_IE</name>
                     <access>read-write</access>
                     <bitRange>[20:20]</bitRange>
                     <description>Interrupt Enable for signal measurement completion</description>
                  </field>
                  <field>
                     <name>RX_IRQ_IE</name>
                     <access>read-write</access>
                     <bitRange>[21:21]</bitRange>
                     <description>Interrupt Enable for receiving interrupt data (IRQ)</description>
                  </field>
                  <field>
                     <name>RX_TO_IE</name>
                     <access>read-write</access>
                     <bitRange>[22:22]</bitRange>
                     <description>Receive Timeout Interrupt Enable</description>
                  </field>
                  <field>
                     <name>PAR_MEM</name>
                     <access>read-write</access>
                     <bitRange>[23:23]</bitRange>
                     <description>Memory storage configuration on parity error</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>STORE_MEMORY</name>
                           <description>Data is stored in memory regardless of parity error.</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOT_STORE_MEMORY</name>
                           <description>When parity error occurs, the current frame is not stored in memory.</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>BAUD</name>
               <description>Baud Rate Register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CLKDIV</name>
                     <bitRange>[13:0]</bitRange>
                     <description>Clock divider value for UARTx.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>STA</name>
               <description>Status Register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>RX</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Reception Complete Flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TX</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>Transmission Complete Flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>PE</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>Parity Error Flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>OE</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>Overrun Error Flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>FE</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>Frame Error Flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>DE</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>Data Error Flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RB</name>
                     <access>read-only</access>
                     <bitRange>[6:6]</bitRange>
                     <description>Reception Busy Flag</description>
                  </field>
                  <field>
                     <name>TB</name>
                     <access>read-only</access>
                     <bitRange>[7:7]</bitRange>
                     <description>Transmission Busy Flag</description>
                  </field>
                  <field>
                     <name>TX_FIFO_EMPTY</name>
                     <access>read-only</access>
                     <bitRange>[8:8]</bitRange>
                     <description>Transmit FIFO Empty</description>
                  </field>
                  <field>
                     <name>TX_FIFO_FULL</name>
                     <access>read-only</access>
                     <bitRange>[9:9]</bitRange>
                     <description>Transmit FIFO Full</description>
                  </field>
                  <field>
                     <name>RX_TO</name>
                     <access>read-write</access>
                     <bitRange>[10:10]</bitRange>
                     <description>Receive Timeout Flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>PF_IF</name>
                     <access>read-write</access>
                     <bitRange>[15:15]</bitRange>
                     <description>Interrupt Flag for receiving PF pulse</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>QF_IF</name>
                     <access>read-write</access>
                     <bitRange>[16:16]</bitRange>
                     <description>Interrupt Flag for receiving QF pulse</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>FPF_IF</name>
                     <access>read-write</access>
                     <bitRange>[17:17]</bitRange>
                     <description>Interrupt Flag for receiving FPF pulse</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>CF_ERR_IF</name>
                     <access>read-write</access>
                     <bitRange>[18:18]</bitRange>
                     <description>Interrupt Flag for UART_CF mode timeout error</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TW_IF</name>
                     <access>read-write</access>
                     <bitRange>[19:19]</bitRange>
                     <description>Interrupt Flag for low-level signal transmission completion (TW)</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>CAL_IF</name>
                     <access>read-write</access>
                     <bitRange>[20:20]</bitRange>
                     <description>Interrupt Flag for signal measurement completion</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RX_IRQ_IF</name>
                     <access>read-write</access>
                     <bitRange>[21:21]</bitRange>
                     <description>Interrupt Flag for receiving interrupt data (IRQ)</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>TXDATA</name>
               <description>Transmit Data Register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TXDATA</name>
                     <access>read-write</access>
                     <bitRange>[7:0]</bitRange>
                     <description>Transmit Data</description>
                  </field>
                  <field>
                     <name>UP</name>
                     <access>read-write</access>
                     <bitRange>[8:8]</bitRange>
                     <description>User-defined Parity Bit (used when parity is set to user-defined)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>RXDATA</name>
               <description>Receive Data Register</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>RXDATA</name>
                     <access>read-write</access>
                     <bitRange>[7:0]</bitRange>
                     <description>Receive Data</description>
                  </field>
                  <field>
                     <name>UP</name>
                     <access>read-write</access>
                     <bitRange>[8:8]</bitRange>
                     <description>Parity Bit (received).User-defined Parity Bit (used when parity is set to user-defined)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>FDIV</name>
               <description>Fractional Divider Register</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">FDIV</name>
                     <bitRange>[13:0]</bitRange>
                     <description>Fractional divider coefficient.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_CTRL</name>
               <description>DMA Control Register</description>
               <addressOffset>0x18</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TX_DMA_EN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Transmit DMA Enable</description>
                  </field>
                  <field>
                     <name>RX_DMA_EN</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>Receive DMA Enable</description>
                  </field>
                  <field>
                     <name>TX_CYC_MODE</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>Transmit Cycle Mode Enable</description>
                  </field>
                  <field>
                     <name>RX_CYC_MODE</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>Receive Cycle Mode Enable</description>
                  </field>
                  <field>
                     <name>DMA_PASS</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>DMA Parity Check Bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ZERO</name>
                           <description>DMA Transmit Fixed to 0 parity</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ONE</name>
                           <description>DMA Transmit Fixed to 1 parity</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_TBADR</name>
               <description>DMA Transmit Base Address Register</description>
               <addressOffset>0x1C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">DMA_TBADR</name>
                     <bitRange>[17:0]</bitRange>
                     <description>DMA Transmit Base Address (byte address). The lower two bits must be configured according to the data width.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_RBADR</name>
               <description>Receive Base Address Register</description>
               <addressOffset>0x20</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">DMA_RBADR</name>
                     <bitRange>[17:0]</bitRange>
                     <description>DMA Receive Base Address (byte address). The lower two bits must be configured according to the data width.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_TLEN</name>
               <description>DMA Transmit Length Register</description>
               <addressOffset>0x24</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">DMA_TLEN</name>
                     <bitRange>[17:0]</bitRange>
                     <description>DMA Transmit Length (in bytes). The lower two bits must be configured according to the data width.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_RLEN</name>
               <description>DMA Receive Length Register</description>
               <addressOffset>0x28</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">DMA_RLEN</name>
                     <bitRange>[17:0]</bitRange>
                     <description>DMA Receive Length (in bytes). The lower two bits must be configured according to the data width.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_TADR</name>
               <description>DMA Current Transmit Address Register</description>
               <addressOffset>0x2C</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">DMA_TADR</name>
                     <bitRange>[17:0]</bitRange>
                     <description>Current DMA Transmit Address (byte address).</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_RADR</name>
               <description>DMA Current Receive Address Register</description>
               <addressOffset>0x30</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">DMA_RADR</name>
                     <bitRange>[17:0]</bitRange>
                     <description>Current DMA Receive Address (byte address).</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_IE</name>
               <description>DMA Interrupt Enable Register</description>
               <addressOffset>0x34</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TX_HIE</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>DMA Transmit Half Empty Interrupt Enable</description>
                  </field>
                  <field>
                     <name>TX_FIE</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>DMA Transmit Empty (Full) Interrupt Enable</description>
                  </field>
                  <field>
                     <name>RX_HIE</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>DMA Receive Half Full Interrupt Enable</description>
                  </field>
                  <field>
                     <name>RX_FIE</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>DMA Receive Full Interrupt Enable</description>
                  </field>
                  <field>
                     <name>TX_ERR_IE</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>Transmit Data Error Interrupt Enable</description>
                  </field>
                  <field>
                     <name>RX_ERR_IE</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>Receive Data Error Interrupt Enable</description>
                  </field>
                  <field>
                     <name>RX_DONE_IE</name>
                     <access>read-write</access>
                     <bitRange>[6:6]</bitRange>
                     <description>DMA Receive Timeout Interrupt Enable</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMA_IF</name>
               <description>DMA Interrupt Flag Register</description>
               <addressOffset>0x38</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TX_HDONE</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>DMA Transmit Half Empty Interrupt Flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TX_FDONE</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>DMA Transmit Full Empty Interrupt Flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RX_HDONE</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>DMA Receive Half Full Interrupt Flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RX_FDONE</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>DMA Receive Full Interrupt Flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RX_ERR</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>Receive Data Error Flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RX_DONE</name>
                     <access>read-write</access>
                     <bitRange>[6:6]</bitRange>
                     <description>DMA Receive Complete Flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>RX_TO</name>
               <description>Receive Timeout Configuration Register</description>
               <addressOffset>0x3C</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TIMEOUT_CNT</name>
                     <bitRange>[7:0]</bitRange>
                     <description>Timeout value in terms of UART data bit widths. After the start bit is received, if no data is received for this duration, a timeout occurs.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CF_CTRL</name>
               <description>UART_CF CF Control Register</description>
               <addressOffset>0x40</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>UART_CF_EN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>UART_CF Mode Enable</description>
                  </field>
                  <field>
                     <name>IRQ_WR_EN</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>Interrupt Data Write to SRAM Enable in UART_CF mode (configurable when UART_CF_EN=0)</description>
                  </field>
                  <field>
                     <name>PULSE_OE</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>Pulse Output Enable in UART_CF mode (configurable when UART_CF_EN=0)</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>PFDAT</name>
               <description>UART_CF PF Pulse Data Register</description>
               <addressOffset>0x44</addressOffset>
               <size>32</size>
               <resetValue>0x800A20AA</resetValue>
               <fields>
                  <field>
                     <name fieldName="None">PFDAT</name>
                     <bitRange>[31:0]</bitRange>
                     <description>PF pulse sequence value for UART to recognize.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>QFDAT</name>
               <description>UART_CF QF Pulse Data Register</description>
               <addressOffset>0x48</addressOffset>
               <size>32</size>
               <resetValue>0x800C40CC</resetValue>
               <fields>
                  <field>
                     <name fieldName="None">QFDAT</name>
                     <bitRange>[31:0]</bitRange>
                     <description>QF pulse sequence value for UART to recognize.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>FPFDAT</name>
               <description>UART_CF FPF Pulse Data Register</description>
               <addressOffset>0x4C</addressOffset>
               <size>32</size>
               <resetValue>0x800E60EE</resetValue>
               <fields>
                  <field>
                     <name fieldName="None">FPFDAT</name>
                     <bitRange>[31:0]</bitRange>
                     <description>FPF pulse sequence value for UART to recognize.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IRQDAT</name>
               <description>UART_CF Interrupt Data Register</description>
               <addressOffset>0x50</addressOffset>
               <size>32</size>
               <resetValue>0x800820A8</resetValue>
               <fields>
                  <field>
                     <name fieldName="None">IRQDAT</name>
                     <bitRange>[31:0]</bitRange>
                     <description>Interrupt data value for UART to recognize.</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CF_OV</name>
               <description>UART_CF Timeout Control Register, Configurable only when UART_CF_EN=0.</description>
               <addressOffset>0x54</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CF_OV_TIME</name>
                     <access>read-write</access>
                     <bitRange>[1:0]</bitRange>
                     <description>UART_CF Timeout Configuration (calculated at 894k baud)</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>TIMEOUT_NONE</name>
                           <description>Timeout mechanism disabled</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TIMEOUT_22B</name>
                           <description>Timeout after 22 bits</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TIMEOUT_44B</name>
                           <description>Timeout after 44 bits</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TIMEOUT_88B</name>
                           <description>Timeout after 88 bits</description>
                           <value>0x3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OV_BUF_CLR</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>Timeout Buffer Clear Enable</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TW_CTRL</name>
               <description>UART_TW Control Register</description>
               <addressOffset>0x58</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>UART_TW_MODE</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>UART_TW Mode Enable</description>
                  </field>
                  <field>
                     <name>TW_NUM</name>
                     <access>read-write</access>
                     <bitRange>[4:1]</bitRange>
