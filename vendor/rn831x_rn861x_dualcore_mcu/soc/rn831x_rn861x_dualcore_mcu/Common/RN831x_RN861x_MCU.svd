      </peripheral>
      <peripheral derivedFrom="IOCNT_CORE0">
         <name>IOCNT_CORE1</name>
         <description>IOCNT Module core1</description>
         <groupName>IOCNT</groupName>
         <baseAddress>0xA005C000</baseAddress>
      </peripheral>
      <peripheral>
         <name>ISO78160_CORE0</name>
         <description>ISO78160 Module core0</description>
         <groupName>ISO7816_CORE0</groupName>
         <baseAddress>0x20030000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x0014</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>CTRL</name>
               <description>Control Register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>EN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Controller enable</description>
                  </field>
                  <field>
                     <name>DIRSEL</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>Data encoding method selection</description>
                  </field>
                  <field>
                     <name>TX_EN</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>Transmit data enable</description>
                  </field>
                  <field>
                     <name>RX_EN</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>Receive data enable</description>
                  </field>
                  <field>
                     <name>TX_IRQ_EN</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>Transmit interrupt enable</description>
                  </field>
                  <field>
                     <name>RX_IRQ_EN</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>Receive interrupt enable</description>
                  </field>
                  <field>
                     <name>ERR_IRQ_EN</name>
                     <access>read-write</access>
                     <bitRange>[6:6]</bitRange>
                     <description>Transfer error interrupt enable</description>
                  </field>
                  <field>
                     <name>BGT_EN</name>
                     <access>read-write</access>
                     <bitRange>[7:7]</bitRange>
                     <description>Data received and sent BGT control</description>
                  </field>
                  <field>
                     <name>PARSEL</name>
                     <access>read-write</access>
                     <bitRange>[10:8]</bitRange>
                     <description>Parity selection, configure Parity</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PARITY_NONE</name>
                           <description>No parity</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PARITY_ODD</name>
                           <description>Odd parity is selected</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PARITY_EVEN</name>
                           <description>Even parity is selected</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PARITY_ZERO</name>
                           <description>Fixed zero parity is selected</description>
                           <value>0x3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PARITY_ONE</name>
                           <description>Fixed one parity is selected</description>
                           <value>0x4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PARITY_USER_DEFINED</name>
                           <description>User defined parity is selected,</description>
                           <value>0x5</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ERRWTH</name>
                     <access>read-write</access>
                     <bitRange>[12:11]</bitRange>
                     <description>Error signal width selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>2</name>
                           <description>Error signal width 2 ETU selected</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>Error signal width 1 ETU selected</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1_5</name>
                           <description>Error signal width 1.5 ETU selected</description>
                           <value>0x2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RXPAR_ESEL</name>
                     <access>read-write</access>
                     <bitRange>[13:13]</bitRange>
                     <description>Receive data parity check error handling methods selection, enable error signal (NACK) transmission when data check error</description>
                  </field>
                  <field>
                     <name>REP_CNT</name>
                     <access>read-write</access>
                     <bitRange>[16:14]</bitRange>
                     <description>Automatic retransmission times when data parity check error occurs</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NONE</name>
                           <description>No automatic retransmission</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>Automatic retransmission count is 1</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2</name>
                           <description>Automatic retransmission count is 2</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>3</name>
                           <description>Automatic retransmission count is 3</description>
                           <value>0x3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4</name>
                           <description>Automatic retransmission count is 4</description>
                           <value>0x4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>5</name>
                           <description>Automatic retransmission count is 5</description>
                           <value>0x5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>6</name>
                           <description>Automatic retransmission count is 6</description>
                           <value>0x6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>7</name>
                           <description>Automatic retransmission count is 7</description>
                           <value>0x7</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EGT</name>
                     <access>read-write</access>
                     <bitRange>[24:17]</bitRange>
                     <description>EGT width selection value (0~255), additional protection time N</description>
                  </field>
                  <field>
                     <name>IO_EN</name>
                     <access>read-write</access>
                     <bitRange>[25:25]</bitRange>
                     <description>Data bidirectional enable</description>
                  </field>
                  <field>
                     <name>TX_GT</name>
                     <access>read-write</access>
                     <bitRange>[27:27]</bitRange>
                     <description>Send data GT width selection</description>
                  </field>
                  <field>
                     <name>RX_GT</name>
                     <access>read-write</access>
                     <bitRange>[28:28]</bitRange>
                     <description>Receive data GT width selection</description>
                  </field>
                  <field>
                     <name>OLD_EN</name>
                     <access>read-write</access>
                     <bitRange>[29:29]</bitRange>
                     <description>OLD detection function enable</description>
                  </field>
                  <field>
                     <name>OLD_IRQ_EN</name>
                     <access>read-write</access>
                     <bitRange>[30:30]</bitRange>
                     <description>OLD Detection interrupt enable</description>
                  </field>
                  <field>
                     <name>CARD_CHECK_EN</name>
                     <access>read-write</access>
                     <bitRange>[31:31]</bitRange>
                     <description>Card pull-out detection enable, Only valid when OLD detection function is enabled</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>CLK</name>
               <description>Clock Configuration Register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <resetValue>0x1</resetValue>
               <fields>
                  <field>
                     <name>CLKDIV</name>
                     <access>read-write</access>
                     <bitRange>[2:0]</bitRange>
                     <description>Clock output division coefficient selection</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0</name>
                           <description>Frequency division coefficient is 0</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2</name>
                           <description>Frequency division coefficient is 2</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4</name>
                           <description>Frequency division coefficient is 4</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>8</name>
                           <description>Frequency division coefficient is 8</description>
                           <value>0x3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>16</name>
                           <description>Frequency division coefficient is 16</description>
                           <value>0x4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>32</name>
                           <description>Frequency division coefficient is 32</description>
                           <value>0x5</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CLKO_EN</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>Card clock output enable</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>BDDIV</name>
               <description>Baudrate coefficients Register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>FD</name>
                     <access>read-write</access>
                     <bitRange>[7:0]</bitRange>
                     <description>This 8 bits FI(b4-b7) and DI(b0-b3) transmitted by Answer To Resest (ATR), the configuration information is shown in table</description>
                  </field>
                  <field>
                     <name>FDS</name>
                     <access>read-write</access>
                     <bitRange>[21:8]</bitRange>
                     <description>Configured by software, can only be written when FDS_EN = 1, in other cases, it is 14d'372</description>
                  </field>
                  <field>
                     <name>FDS_EN</name>
                     <access>read-write</access>
                     <bitRange>[22:22]</bitRange>
                     <description>Software configuration of F/D</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>STA</name>
               <description>Status Indicator Register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TXIF</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Data transmit interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RXIF</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>Data received interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>OVL_IF</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>Receive data overflow interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>COL_IF</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>Transmit data conflict error interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RXPAR_ERRIF</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>Receive data parity error flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TXPAR_ERRIF</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>Transmit data parity error flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>TXBUSY</name>
                     <access>read-only</access>
                     <bitRange>[6:6]</bitRange>
                     <description>Data sending busy flag, read only</description>
                  </field>
                  <field>
                     <name>RXBUSY</name>
                     <access>read-only</access>
                     <bitRange>[7:7]</bitRange>
                     <description>Data receiving busy flag, read only</description>
                  </field>
                  <field>
                     <name>RX_FLAG</name>
                     <access>read-only</access>
                     <bitRange>[8:8]</bitRange>
                     <description>Data receiving complete flag, read only</description>
                  </field>
                  <field>
                     <name>TX_FLAG</name>
                     <access>read-only</access>
                     <bitRange>[9:9]</bitRange>
                     <description>Send buffer empty flag, read only</description>
                  </field>
                  <field>
                     <name>BDDIV_R</name>
                     <access>read-only</access>
                     <bitRange>[10:10]</bitRange>
                     <description>Baud rate match indication bit, read only</description>
                  </field>
                  <field>
                     <name>FRAME_ERR</name>
                     <access>read-write</access>
                     <bitRange>[11:11]</bitRange>
                     <description>Receive data frame format error interrupt flag</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>OLD_FLAG</name>
                     <access>read-write</access>
                     <bitRange>[12:12]</bitRange>
                     <description>Receive OLD signal interrupt flag, it is valid after OLD_EN is enabled</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>CARD_OUT_FLAG</name>
                     <access>read-write</access>
                     <bitRange>[13:13]</bitRange>
                     <description>Card pull-out detect flag, it is valid after CARD_CHECK_EN is enabled</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>DATA</name>
               <description>Transceiver Register</description>
               <addressOffset>0x10</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>DAT</name>
                     <access>read-write</access>
                     <bitRange>[7:0]</bitRange>
                     <description>Data register</description>
                  </field>
                  <field>
                     <name>DAT_BIT8</name>
                     <access>read-write</access>
                     <bitRange>[8:8]</bitRange>
                     <description>When parsel is in user defined mode, this data bit is parity</description>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
