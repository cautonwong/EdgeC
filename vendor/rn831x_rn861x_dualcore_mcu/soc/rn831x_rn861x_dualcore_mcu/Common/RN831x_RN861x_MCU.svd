         </addressBlock>
         <registers>
            <register>
               <name>MODE</name>
               <description>Mode Configuration Register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TE</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Transmitter Enable</description>
                  </field>
                  <field>
                     <name>RE</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>Receiver Enable</description>
                  </field>
                  <field>
                     <name>IRE</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>Infrared Enable</description>
                  </field>
                  <field>
                     <name>NEG</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>Clear TX channel and stop &amp; clear transmission</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>POSITIVE</name>
                           <description>Positive polarity (Idle level = High)</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NEGATIVE</name>
                           <description>Negative polarity (Idle level = Low)</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>IRPOL</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
