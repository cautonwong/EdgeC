         <baseAddress>0x20024000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x0060</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>TXDATA</name>
               <description>Transmit Data Register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">TXDATA</name>
                     <bitRange>[8:0]</bitRange>
                     <description>Data to transmit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>RXDATA</name>
               <description>Receive Data Register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <access>read-only</access>
               <fields>
                  <field>
                     <name fieldName="None">RXDATA</name>
                     <bitRange>[8:0]</bitRange>
                     <description>Received data</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>TXCTRL</name>
               <description>Transmit Control Register</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>TXEN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Transmit enable</description>
                  </field>
                  <field>
                     <name>CFG_STOP_BIT</name>
                     <access>read-write</access>
                     <bitRange>[2:1]</bitRange>
                     <description>Stop bit length</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>0_5</name>
                           <description>0.5 stop bit</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1</name>
                           <description>1 stop bit</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>1_5</name>
                           <description>1.5 stop bits</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2</name>
                           <description>2 stop bits</description>
                           <value>0x3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CONTINUOUS</name>
                     <access>read-write</access>
                     <bitRange>[3:3]</bitRange>
                     <description>GDMA reload mode</description>
                  </field>
                  <field>
                     <name>CLR</name>
                     <access>write-only</access>
                     <bitRange>[4:4]</bitRange>
                     <description>Clear TX channel and stop &amp; clear transmission</description>
                  </field>
                  <field>
                     <name>TXCNT</name>
                     <access>read-write</access>
                     <bitRange>[20:16]</bitRange>
                     <description>Transmit watermark level</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>RXCTRL</name>
               <description>Receive Control Register</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>RXEN</name>
                     <access>read-write</access>
                     <bitRange>[0:0]</bitRange>
                     <description>Receive enable</description>
                  </field>
                  <field>
                     <name>CONTINUOUS</name>
                     <access>read-write</access>
                     <bitRange>[1:1]</bitRange>
                     <description>GDMA reload mode</description>
                  </field>
                  <field>
                     <name>CLR</name>
                     <access>read-write</access>
                     <bitRange>[2:2]</bitRange>
                     <description>Clear RX channel</description>
                  </field>
                  <field>
                     <name>RXCNT</name>
                     <access>read-write</access>
                     <bitRange>[20:16]</bitRange>
                     <description>Receive watermark level</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IE</name>
               <description>Interrupt Enable Register</description>
               <addressOffset>0x10</addressOffset>
