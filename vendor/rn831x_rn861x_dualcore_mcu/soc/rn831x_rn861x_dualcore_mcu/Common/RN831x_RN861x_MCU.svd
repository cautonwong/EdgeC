                  <field>
                     <name>RX_ERROR_FLOW</name>
                     <access>read-write</access>
                     <bitRange>[4:4]</bitRange>
                     <description>RX overflow error</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>RX_ERROR_PARITY</name>
                     <access>read-write</access>
                     <bitRange>[5:5]</bitRange>
                     <description>RX parity error</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>CTS_RISE_FLAG</name>
                     <access>read-write</access>
                     <bitRange>[6:6]</bitRange>
                     <description>CTS rising edge detected</description>
                     <modifiedWriteValues>oneToClear</modifiedWriteValues>
                  </field>
                  <field>
                     <name>CTS_FALL_FLAG</name>
                     <access>read-write</access>
                     <bitRange>[7:7]</bitRange>
