      <peripheral>
         <name>SIMPTC0_0_CORE0</name>
         <description>simple time counter</description>
         <groupName>SIMPTC</groupName>
         <baseAddress>0x200A4000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x10</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>CTRL</name>
               <description>SIMPTC control register</description>
               <addressOffset>0x0</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>CNT_SFT_EN</name>
                     <bitRange>[0:0]</bitRange>
                     <description>SIMP_TCx_x counter soft enable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>enable</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>disable</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CNT_SEL</name>
                     <bitRange>[1:1]</bitRange>
                     <description>SIMP_TCx_x counter enable source select</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SFT</name>
                           <description>enable counter source select as soft config</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>AOS</name>
                           <description>enable counter source select as AOS</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DBGSTBDIS</name>
                     <bitRange>[2:2]</bitRange>
                     <description>SIMP_TCx_x debug standby disable bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PAUSE</name>
                           <description>halt counting when SoC halted by debugger</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>COUNTINUE</name>
                           <description>keep counting when SoC halted by debugger</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MODE</name>
                     <bitRange>[3:3]</bitRange>
                     <description>SIMP_TCx_x count mode selection bit</description>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SINGLE</name>
                           <description>SIMP_TCx_x select as Single Count</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CONTINUE</name>
                           <description>SIMP_TCx_x  select as Continuous Count</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>IRQEN</name>
                     <bitRange>[4:4]</bitRange>
                     <description>SIMP_TCx_x interrupt enable bit</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>DN</name>
               <description>SIMPTC target counter register</description>
               <addressOffset>0x4</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">DN</name>
                     <bitRange>[31:0]</bitRange>
                     <description>SIMPTC target counting value setting bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>VAL</name>
               <description>SIMPTC counter register bits</description>
               <addressOffset>0x8</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name fieldName="None">VAL</name>
                     <bitRange>[31:0]</bitRange>
                     <description>SIMPTC current count register bits</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>IF</name>
               <description>SIMPTC interrupt flag bits</description>
               <addressOffset>0xC</addressOffset>
               <size>32</size>
               <fields>
                  <field>
                     <name>OV</name>
                     <bitRange>[0:0]</bitRange>
                     <description>SIMPTC counter overflow interrrupt flag</description>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
