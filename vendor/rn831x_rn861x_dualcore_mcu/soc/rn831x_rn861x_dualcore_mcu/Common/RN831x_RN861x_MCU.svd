                  <field>
                     <name>RX_EOT_IE</name>
                     <access>read-write</access>
                     <bitRange>[13:13]</bitRange>
                     <description>RX transfer complete interrupt enable</description>
                  </field>
               </fields>
            </register>
            <register>
               <name>STA</name>
               <description>Status Register</description>
               <addressOffset>0x14</addressOffset>
               <size>32</size>
               <fields>
