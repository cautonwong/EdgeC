                     <enumeratedValues>
                        <enumeratedValue>
                           <name>LSB_FIRST</name>
                           <description>LSB first</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MSB_FIRST</name>
                           <description>MSB first</description>
                           <value>0x1</value>
                        </enumeratedValue>
