SDK_CONFIG: 
   Debug: 
      core: N200
      extra_asmflags: 
      archext: 
      extra_cxxflags: 
      cmodel: medlow
      extra_commonflags: 
      abi: ilp32
      arch: rv32im_zba_zbb_zbc_zbs_zca_zcb_zcmp_zcmt
      toolchain: gnu
      extra_cflags: -DCORE0 -DUSE_FULL_LL_DRIVER
      extra_ldflags: -Wl,--check-sections -Wl,--no-warn-rwx-segments  -u errno
NPK_PACKS: 
-  owner: nuclei
   name: sdk-nuclei_sdk
   version: 0.8.1
