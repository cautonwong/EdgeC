/**
 * @file contracts_slave.h
 * @brief 自动生成的从设备 (Slave/Sub-device) 专用契约头文件
 * 
 * 逻辑：Physical Address -> TagID (O(1) 完美哈希)
 */

#ifndef EDGE_CONTRACTS_SLAVE_H
#define EDGE_CONTRACTS_SLAVE_H

#include <stdint.h>
#include <stdbool.h>

#ifdef __cplusplus
extern "C" {
#endif

/**
 * @brief 逻辑点位 ID 定义 (与主站完全同步)
 */
typedef enum {
    TAG_INVALID = 0,
{{- range .AllTags }}
    TAG_{{ .Name }} = {{ .ID }},
{{- end }}
    TAG_MAX_ID
} edge_tag_id_t;

/* --- 物理地址到 TagID 的映射函数 --- */

/**
 * @brief Modbus 寄存器地址转 TagID
 * @param reg_addr 接收到的 Modbus 寄存器物理地址
 * @return 对应的逻辑 TagID，若未定义则返回 TAG_INVALID
 */
edge_tag_id_t edge_slave_get_tag_by_modbus_addr(uint16_t reg_addr);

/**
 * @brief DLT645 数据标识 (DI) 转 TagID
 * @param di 数据标识 (如 0x02010100)
 * @return 对应的逻辑 TagID
 */
edge_tag_id_t edge_slave_get_tag_by_dlt645_di(uint32_t di);

/**
 * @brief IEC104 信息对象地址 (IOA) 转 TagID
 */
edge_tag_id_t edge_slave_get_tag_by_iec104_ioa(int ioa);

#ifdef __cplusplus
}
#endif

#endif // EDGE_CONTRACTS_SLAVE_H
