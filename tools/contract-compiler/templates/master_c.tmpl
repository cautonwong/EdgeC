// --- DLT645 ---
{{- $dlt := index .Hashes "DLT645" }}
{{- if $dlt.Keys }}
static const dlt645_map_t s_dlt645_table[] = {
{{- range $dlt.Keys }}
    { "{{ .StrKey }}", (uint32_t){{ .RawKey }}, {{ if ne .TagName "" }}TAG_{{ .TagName }}{{ else }}TAG_INVALID{{ end }}, {{ printf "%.6f" .Scale }}f },
{{- end }}
};
edge_tag_id_t edge_lookup_dlt645(const char* di_str, float *s) {
    if (!di_str) return TAG_INVALID;
    for (int i = 0; i < {{ len $dlt.Keys }}; i++) {
        if (s_dlt645_table[i].id != TAG_INVALID && strcmp(s_dlt645_table[i].di, di_str) == 0) {
            if (s) *s = s_dlt645_table[i].scaler;
            return s_dlt645_table[i].id;
        }
    }
    return TAG_INVALID;
}
edge_tag_id_t edge_lookup_dlt645_num(uint32_t di, float *s) {
    {{- if $dlt.IsPerfect }}
    uint32_t h = _contract_hash_mix(di, {{ $dlt.Seed }}, {{ $dlt.TableSize }} - 1);
    const dlt645_map_t *e = &s_dlt645_table[h];
    if (e->id != TAG_INVALID && e->di_num == di) {
        if (s) *s = e->scaler;
        return e->id;
    }
    {{- else }}
    for (int i=0; i<{{ len $dlt.Keys }}; i++) {
        if (s_dlt645_table[i].id != TAG_INVALID && s_dlt645_table[i].di_num == di) {
            if (s) *s = s_dlt645_table[i].scaler;
            return s_dlt645_table[i].id;
        }
    }
    {{- end }}
    return TAG_INVALID;
}
edge_tag_id_t edge_slave_get_tag_by_dlt645_di(uint32_t d) { return edge_lookup_dlt645_num(d, NULL); }
{{- else }}
edge_tag_id_t edge_lookup_dlt645(const char* d, float *s) { (void)d; (void)s; return TAG_INVALID; }
edge_tag_id_t edge_lookup_dlt645_num(uint32_t di, float *s) { (void)di; (void)s; return TAG_INVALID; }
edge_tag_id_t edge_slave_get_tag_by_dlt645_di(uint32_t d) { (void)d; return TAG_INVALID; }
{{- end }}

