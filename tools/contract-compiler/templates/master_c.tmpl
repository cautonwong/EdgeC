#include "contracts.h"
#include <string.h>
#include <stdio.h>
#include <stdlib.h>

/**
 * @brief 核心哈希混淆函数 (MurmurHash3 fmix32 变体)
 * 必须置于文件顶端，确证所有查找函数可见。
 */
static inline uint32_t _contract_hash_mix(uint32_t key, uint32_t seed, uint32_t mask) {
    uint32_t h = key ^ seed;
    h ^= h >> 16; h *= 0x85ebca6b; h ^= h >> 13; h *= 0xc2b2ae35; h ^= h >> 16;
    return h & mask;
}

/**
 * @brief [Table A] Dense Meta Table (Compact)
 */
static const tag_meta_t s_active_tag_meta[] = {
{{- range .ActiveTags }}
    { .name = "{{ .Name }}", .unit = "{{ .Unit }}", .upload = true },
{{- end }}
};

/**
 * @brief [Table B] Perfect Hash Index Table
 */
typedef struct {
    uint32_t original_id;
    uint32_t dense_index;
} tag_hash_entry_t;

static const tag_hash_entry_t s_tag_hash_table[] = {
{{- range .TagHash.Keys }}
    { (uint32_t){{ .RawKey }}, {{ .TagID }} }, // {{ .TagName }}
{{- end }}
};

const tag_meta_t* edge_get_meta(edge_tag_id_t id) {
    if (id == TAG_INVALID) return NULL;
    uint32_t h = _contract_hash_mix((uint32_t)id, {{ .TagHash.Seed }}, {{ .TagHash.TableSize }} - 1);
    const tag_hash_entry_t *e = &s_tag_hash_table[h];
    if (e->original_id == id) {
        return &s_active_tag_meta[e->dense_index];
    }
    return NULL;
}

