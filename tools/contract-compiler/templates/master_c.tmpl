{{- if (index .Hashes "DLMS").Keys }}
{{- $dlms := index .Hashes "DLMS" }}
edge_tag_id_t edge_lookup_dlms(uint16_t classId, const char* obis, uint8_t attrId, float *s) {
    (void)classId; (void)attrId;
    uint64_t key = _edge_dlms_parse_obis(obis);
    uint32_t h = _contract_hash_mix((uint32_t)key, {{ $dlms.Seed }}, {{ $dlms.TableSize }} - 1);
    const dlms_map_t *e = &s_dlms_table[h];
    if (e->id != TAG_INVALID && e->raw_key == key) {
        if(s) *s = e->scaler;
        return e->id;
    }
    return TAG_INVALID;
}
edge_tag_id_t edge_lookup_dlms_by_string(const char *str, float *s) {
    return edge_lookup_dlms(0, str, 0, s);
}
edge_tag_id_t edge_slave_get_tag_by_dlms_addr(uint32_t addr) { (void)addr; return TAG_INVALID; }
const dlms_map_t* edge_get_reverse_map_dlms(edge_tag_id_t id) {
    if (id >= TAG_MAX_ID) return NULL;
    return s_dlms_reverse_table[id];
}
{{- else }}
edge_tag_id_t edge_lookup_dlms(uint16_t c, const char* o, uint8_t a, float *s) { (void)c; (void)o; (void)a; (void)s; return TAG_INVALID; }
edge_tag_id_t edge_lookup_dlms_by_string(const char *t, float *s) { (void)t; (void)s; return TAG_INVALID; }
edge_tag_id_t edge_slave_get_tag_by_dlms_addr(uint32_t a) { (void)a; return TAG_INVALID; }
const dlms_map_t* edge_get_reverse_map_dlms(edge_tag_id_t i) { (void)i; return NULL; }
{{- end }}

