// --- DLMS ---
{{- $dlms := index .PMap "DLMS" }}
{{- if $dlms }}
static const dlms_map_t s_dlms_table[] = {
{{- range $dlms }}
    { {{ .ClassID }}, "{{ .OBIS }}", {{ .AttrID }}, TAG_{{ .TagName }}, {{ printf "%.6f" .Scale }}f, {{ .ByteLen }}, {{ printf "0x%08X" .Access }} },
{{- end }}
};
edge_tag_id_t edge_lookup_dlms(uint16_t classId, const char* obis, uint8_t attrId, float *s) {
    for (int i=0; i<{{ len $dlms }}; i++) {
        if (s_dlms_table[i].class_id == classId && s_dlms_table[i].attr_id == attrId && strcmp(s_dlms_table[i].obis, obis) == 0) {
            if (s) *s = s_dlms_table[i].scaler;
            return s_dlms_table[i].id;
        }
    }
    return TAG_INVALID;
}
edge_tag_id_t edge_lookup_dlms_by_string(const char *str, float *s) {
    if(!str) return TAG_INVALID;
    return TAG_INVALID;
}
{{- else }}
edge_tag_id_t edge_lookup_dlms(uint16_t c, const char* o, uint8_t a, float *s) { (void)c; (void)o; (void)a; (void)s; return TAG_INVALID; }
edge_tag_id_t edge_lookup_dlms_by_string(const char *t, float *s) { (void)t; (void)s; return TAG_INVALID; }
{{- end }}

// --- [核心自检] ---
int edge_contract_self_test(void) {
    printf("[Contract] Finalizing self-test for: %s\n", "{{ .Product }}");
    int failed = 0;
    float s = 0;
    {{- range .ActiveTags }}
    {{- $tname := .Name }}
    {{- range .Bindings }}
    {{- if equalFold .ProtocolType "MODBUS" }}
    if (edge_lookup_modbus((uint16_t){{ index .Attributes "addr" | default 0 }}, &s) != TAG_{{ $tname }}) failed++;
    {{- end }}
    {{- if equalFold .ProtocolType "DLT645" }}
    if (edge_lookup_dlt645((uint32_t){{ parseKey "DLT645" (index .Attributes "di") }}, &s) != TAG_{{ $tname }}) failed++;
    {{- end }}
    {{- end }}
    {{- end }}
    return failed;
}
