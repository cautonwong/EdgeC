int edge_contract_self_test(void) {
    printf("[Contract] Finalizing self-test for: %s\n", "{{ .Product }}");
    int failed = 0;
    float s = 0;

    {{- range .ActiveTags }}
    {{- $tname := .Name }}
    {{- range .Bindings }}
    {{- if equalFold .ProtocolType "MODBUS" }}
    {
        uint16_t addr = (uint16_t){{ index .Attributes "addr" | default (index .Attributes "address" | default 0) }};
        edge_tag_id_t res = edge_lookup_modbus(addr, &s);
        if (res != TAG_{{ $tname }}) {
            printf("  [FAIL] MODBUS Tag %s (Addr %d): Hash returned %d, Expected %d\n", "{{ $tname }}", addr, res, TAG_{{ $tname }});
            failed++;
        }
    }
    {{- end }}
    {{- if equalFold .ProtocolType "DLT645" }}
    {
        uint32_t di_num = (uint32_t){{ parseKey "DLT645" (index .Attributes "di") }};
        edge_tag_id_t res = edge_lookup_dlt645_num(di_num, &s);
        if (res != TAG_{{ $tname }}) {
            printf("  [FAIL] DLT645 Tag %s (DI_NUM 0x%08X): Hash returned %d, Expected %d\n", "{{ $tname }}", di_num, res, TAG_{{ $tname }});
            failed++;
        }
    }
    {{- end }}
    {{- if equalFold .ProtocolType "IEC104" }}
    {
        int ioa = (int){{ index .Attributes "ioa" }};
        edge_tag_id_t res = edge_lookup_iec104(ioa);
        if (res != TAG_{{ $tname }}) {
            printf("  [FAIL] IEC104 Tag %s (IOA %d): Hash returned %d, Expected %d\n", "{{ $tname }}", ioa, res, TAG_{{ $tname }});
            failed++;
        }
    }
    {{- end }}
    {{- end }}
    {{- end }}

    if (failed == 0) {
        printf("[Contract] Self-test PASSED (all tag-to-physical mappings verified).\n");
    } else {
        printf("[Contract] Self-test FAILED with %d errors!\n", failed);
    }
    return failed;
}
