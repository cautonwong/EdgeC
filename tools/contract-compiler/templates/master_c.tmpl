#include "contracts.h"
#include "contracts_slave.h"
#include <string.h>
#include <stdio.h>
#include <stdlib.h>

const tag_meta_t g_tag_meta_table[] = {
{{- range .AllTags }}
    [TAG_{{ .Name }}] = { 
        .name = "{{ .Name }}", 
        .unit = "{{ .Unit }}", 
        .category = "{{ index .Attributes "category" | default "" }}",
        .ui_group = "{{ $.GetUIAttr . "group" | default "" }}",
        .min_val = {{ printf "%.1f" ($.GetUIAttr . "min" | default 0.0) }}f,
        .max_val = {{ printf "%.1f" ($.GetUIAttr . "max" | default 0.0) }}f,
        .persist = {{ if index .Attributes "persist" }}true{{else}}false{{end}},
        .upload = {{ if index .Attributes "upload" }}true{{else}}false{{end}},
        .reserved = {0}
    },
{{- end }}
};

const tag_meta_t* edge_get_meta(edge_tag_id_t id) {
    if (id >= TAG_MAX_ID) return NULL;
    return &g_tag_meta_table[id];
}

static inline uint32_t _contract_hash_mix(uint32_t key, uint32_t seed, uint32_t mask) {
    uint32_t h = key ^ seed;
    h ^= h >> 16; h *= 0x85ebca6b; h ^= h >> 13; h *= 0xc2b2ae35; h ^= h >> 16;
    return h & mask;
}

__attribute__((unused)) static uint64_t _edge_dlms_parse_obis(const char* obis) {
    uint64_t res = 0;
    int i = 0;
    const char *p = obis;
    while (*p && i < 8) {
        res |= (uint64_t)((uint8_t)atoi(p)) << (i * 8);
        while (*p && *p != '.') p++;
        if (*p == '.') p++;
        i++;
    }
    return res;
}

// --- [Protocol Tables] ---

{{- range $proto, $hInfo := .Hashes }}
{{- if $hInfo.Keys }}
static const {{ lower $proto }}_map_t s_{{ lower $proto }}_table[] = {
{{- range $hInfo.Keys }}
    {{- if eq $proto "MODBUS" }}
    { {{ if ne .TagName "" }}TAG_{{ .TagName }}{{ else }}TAG_INVALID{{ end }}, {{ printf "%.6f" .Scale }}f, {{ printf "0x%08X" .Access }}, (uint16_t){{ .RawKey }}, (uint16_t){{ .ByteLen }} },
    {{- end }}
    {{- if eq $proto "DLT645" }}
    { "{{ .StrKey }}", {{ if ne .TagName "" }}TAG_{{ .TagName }}{{ else }}TAG_INVALID{{ end }}, (uint32_t){{ .RawKey }}, {{ printf "%.6f" .Scale }}f, {{ printf "0x%08X" .Access }}, (uint16_t){{ .ByteLen }}, 0 },
    {{- end }}
    {{- if eq $proto "IEC104" }}
    { {{ if ne .TagName "" }}TAG_{{ .TagName }}{{ else }}TAG_INVALID{{ end }}, (int){{ .RawKey }}, 0, {{ printf "0x%08X" .Access }}, (uint16_t){{ .ByteLen }}, 0 },
    {{- end }}
    {{- if eq $proto "DLMS" }}
    { "{{ .StrKey }}", {{ .RawKey }}ULL, {{ if ne .TagName "" }}TAG_{{ .TagName }}{{ else }}TAG_INVALID{{ end }}, {{ printf "%.6f" .Scale }}f, {{ printf "0x%08X" .Access }}, (uint16_t)0, (uint16_t){{ .ByteLen }}, (uint8_t)0, {0} },
    {{- end }}
{{- end }}
};

static const {{ lower $proto }}_map_t* const s_{{ lower $proto }}_reverse_table[] = {
{{- range $.ActiveTags }}
    {{- $tname := .Name }}
    {{- $found := false }}
    {{- range $hInfo.Keys }}
        {{- if eq .TagName $tname }}
            &s_{{ lower $proto }}_table[{{ .Index }}], // TAG_{{ $tname }}
            {{- $found = true }}
        {{- end }}
    {{- end }}
    {{- if not $found }}
        NULL, // TAG_{{ $tname }} (No binding)
    {{- end }}
{{- end }}
};
{{- end }}
{{- end }}

// --- [Lookup APIs] ---

{{- if (index .Hashes "MODBUS").Keys }}
{{- $mb := index .Hashes "MODBUS" }}
const modbus_map_t* edge_get_map_modbus(uint16_t reg) {
    uint32_t h = _contract_hash_mix((uint32_t)reg, {{ $mb.Seed }}, {{ $mb.TableSize }} - 1);
    const modbus_map_t *e = &s_modbus_table[h];
    if (e->id != TAG_INVALID && e->addr == reg) return e;
    return NULL;
}
edge_tag_id_t edge_lookup_modbus(uint16_t reg, float *s) {
    const modbus_map_t *m = edge_get_map_modbus(reg);
    if (m) { if(s) *s = m->scaler; return m->id; }
    return TAG_INVALID;
}
edge_tag_id_t edge_slave_get_tag_by_modbus_addr(uint32_t reg_addr) {
    const modbus_map_t *m = edge_get_map_modbus((uint16_t)reg_addr);
    return m ? m->id : TAG_INVALID;
}
const modbus_map_t* edge_get_reverse_map_modbus(edge_tag_id_t id) {
    if (id >= TAG_MAX_ID) return NULL;
    return s_modbus_reverse_table[id];
}
{{- else }}
const modbus_map_t* edge_get_map_modbus(uint16_t r) { (void)r; return NULL; }
edge_tag_id_t edge_lookup_modbus(uint16_t r, float *s) { (void)r; (void)s; return TAG_INVALID; }
edge_tag_id_t edge_slave_get_tag_by_modbus_addr(uint32_t a) { (void)a; return TAG_INVALID; }
const modbus_map_t* edge_get_reverse_map_modbus(edge_tag_id_t i) { (void)i; return NULL; }
{{- end }}

