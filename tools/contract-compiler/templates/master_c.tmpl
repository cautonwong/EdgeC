#include "contracts.h"
#include <string.h>
#include <stdio.h>
#include <stdlib.h>

const tag_meta_t g_tag_meta_table[] = {
{{- range .AllTags }}
    [TAG_{{ .Name }}] = { 
        .name = "{{ .Name }}", 
        .unit = "{{ .Unit }}", 
        .category = "{{ index .Attributes "category" | default "" }}",
        .ui_group = "{{ $.GetUIAttr . "group" | default "" }}",
        .min_val = {{ printf "%.1f" ($.GetUIAttr . "min" | default 0.0) }}f,
        .max_val = {{ printf "%.1f" ($.GetUIAttr . "max" | default 0.0) }}f,
        .persist = {{ if index .Attributes "persist" }}true{{else}}false{{end}},
        .upload = {{ if index .Attributes "upload" }}true{{else}}false{{end}}
    },
{{- end }}
};

const tag_meta_t* edge_get_meta(edge_tag_id_t id) {
    if (id >= TAG_MAX_ID) return NULL;
    return &g_tag_meta_table[id];
}

static inline uint32_t _contract_hash_mix(uint32_t key, uint32_t seed, uint32_t mask) {
    uint32_t h = key ^ seed;
    h ^= h >> 16; h *= 0x85ebca6b; h ^= h >> 13; h *= 0xc2b2ae35; h ^= h >> 16;
    return h & mask;
}

// --- Modbus ---
{{- $mb := index .Hashes "MODBUS" }}
{{- if $mb.Keys }}
static const modbus_map_t s_modbus_table[] = {
{{- range $mb.Keys }}
    { (uint16_t){{ .RawKey }}, {{ if ne .TagName "" }}TAG_{{ .TagName }}{{ else }}TAG_INVALID{{ end }}, {{ printf "%.6f" .Scale }}f, {{ .ByteLen }}, {{ printf "0x%08X" .Access }} },
{{- end }}
};
const modbus_map_t* edge_get_map_modbus(uint16_t reg) {
    uint32_t h = _contract_hash_mix((uint32_t)reg, {{ $mb.Seed }}, {{ $mb.TableSize }} - 1);
    const modbus_map_t *e = &s_modbus_table[h];
    if (e->id != TAG_INVALID && e->addr == reg) return e;
    return NULL;
}
edge_tag_id_t edge_lookup_modbus(uint16_t reg, float *s) {
    const modbus_map_t *m = edge_get_map_modbus(reg);
    if (m) { if(s) *s = m->scaler; return m->id; }
    return TAG_INVALID;
}
edge_tag_id_t edge_lookup_modbus_by_buf(const uint8_t *buf, float *s) {
    if(!buf) return TAG_INVALID;
    uint16_t reg = (uint16_t)((buf[0] << 8) | buf[1]);
    return edge_lookup_modbus(reg, s);
}
edge_tag_id_t edge_lookup_modbus_by_string(const char *str, float *s) {
    if(!str) return TAG_INVALID;
    return edge_lookup_modbus((uint16_t)strtoul(str, NULL, 0), s);
}
{{- else }}
edge_tag_id_t edge_lookup_modbus(uint16_t r, float *s) { (void)r; (void)s; return TAG_INVALID; }
edge_tag_id_t edge_lookup_modbus_by_buf(const uint8_t *b, float *s) { (void)b; (void)s; return TAG_INVALID; }
edge_tag_id_t edge_lookup_modbus_by_string(const char *t, float *s) { (void)t; (void)s; return TAG_INVALID; }
const modbus_map_t* edge_get_map_modbus(uint16_t r) { (void)r; return NULL; }
{{- end }}

// --- DLT645 ---
{{- $dlt := index .Hashes "DLT645" }}
{{- if $dlt.Keys }}
static const dlt645_map_t s_dlt645_table[] = {
{{- range $dlt.Keys }}
    { "{{ .StrKey }}", (uint32_t){{ .RawKey }}, {{ if ne .TagName "" }}TAG_{{ .TagName }}{{ else }}TAG_INVALID{{ end }}, {{ printf "%.6f" .Scale }}f, {{ .ByteLen }}, {{ printf "0x%08X" .Access }} },
{{- end }}
};
const dlt645_map_t* edge_get_map_dlt645(uint32_t di) {
    uint32_t h = _contract_hash_mix(di, {{ $dlt.Seed }}, {{ $dlt.TableSize }} - 1);
    const dlt645_map_t *e = &s_dlt645_table[h];
    if (e->id != TAG_INVALID && e->di_num == di) return e;
    return NULL;
}
edge_tag_id_t edge_lookup_dlt645(uint32_t di, float *s) {
    const dlt645_map_t *m = edge_get_map_dlt645(di);
    if (m) { if(s) *s = m->scaler; return m->id; }
    return TAG_INVALID;
}
edge_tag_id_t edge_lookup_dlt645_by_buf(const uint8_t *buf, float *s) {
    if(!buf) return TAG_INVALID;
    uint32_t di = (uint32_t)buf[0] | ((uint32_t)buf[1] << 8) | ((uint32_t)buf[2] << 16) | ((uint32_t)buf[3] << 24);
    return edge_lookup_dlt645(di, s);
}
edge_tag_id_t edge_lookup_dlt645_by_string(const char *str, float *s) {
    if(!str) return TAG_INVALID;
    return edge_lookup_dlt645((uint32_t)strtoul(str, NULL, 16), s);
}
{{- else }}
edge_tag_id_t edge_lookup_dlt645(uint32_t d, float *s) { (void)d; (void)s; return TAG_INVALID; }
edge_tag_id_t edge_lookup_dlt645_by_buf(const uint8_t *b, float *s) { (void)b; (void)s; return TAG_INVALID; }
edge_tag_id_t edge_lookup_dlt645_by_string(const char *t, float *s) { (void)t; (void)s; return TAG_INVALID; }
const dlt645_map_t* edge_get_map_dlt645(uint32_t d) { (void)d; return NULL; }
{{- end }}

