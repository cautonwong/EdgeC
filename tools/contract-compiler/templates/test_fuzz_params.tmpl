/**
 * @file test_fuzz_params.c
 * @brief Auto-generated Fuzzing Test for Product Parameters
 */

#include <stdarg.h>
#include <stddef.h>
#include <setjmp.h>
#include <cmocka.h>
#include <stdio.h>
#include "edge_params.h"
#include "contracts.h"

static void test_param_bounds_fuzz(void **state) {
    (void)state;
    
{{- range .Params}}
    // Testing Parameter: {{.Name}}
    {
        printf("Fuzzing {{.Name}} (min: {{.Min}}, max: {{.Max}})\\n");
        {{- if eq .Type "float"}}
        float val_min = {{.Min}};
        float val_max = {{.Max}};
        float val_out_low = val_min - 1.0f;
        float val_out_high = val_max + 1.0f;
        float val_ok = (val_min + val_max) / 2.0f;
        {{- else}}
        int val_min = {{.Min}};
        int val_max = {{.Max}};
        int val_out_low = val_min - 1;
        int val_out_high = val_max + 1;
        int val_ok = (val_min + val_max) / 2;
        {{- end}}

        // These should be validated by the logic or storage layer if integrated
        // Here we just ensure metadata reflects the YAML
        assert_true(val_min <= val_max);
    }
{{- end}}
}

int main(void) {
    const struct CMUnitTest tests[] = {
        cmocka_unit_test(test_param_bounds_fuzz),
    };
    return cmocka_run_group_tests(tests, NULL, NULL);
}

