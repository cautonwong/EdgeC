{{- define "meta_pipelines" -}}
// [Pipelines - Stage Factory Registry]
{{- range .UsedStages }}
extern __attribute__((weak)) pipeline_stage_t* stage_{{ lower . }}_create_v2(const edge_stage_def_t *def, pipeline_loader_ctx_t *ctx);
{{- end }}

const edge_stage_factory_entry_t g_stage_factory_registry[] = {
{{- range .UsedStages }}
    { "{{ lower . }}", stage_{{ lower . }}_create_v2 },
{{- end }}
    { 0, 0 }
};

const edge_stage_factory_entry_t* edge_stage_factory_get_registry(void) {
    return g_stage_factory_registry;
}

// [Pipelines - Stage Definition Blocks]
{{- range .Pipelines }}
static const edge_stage_def_t _stages_{{ .ID }}[] = {
    {{- range .Stages }}
    {{- $cfg := index . "config" | default . -}}
    {
        .name = "{{ index . "name" | default "stage" }}",
        .type = "{{ index . "type" }}",
        .params = {
            .f1 = {{ index $cfg "threshold" | default (index $cfg "alpha") | default (index $cfg "min") | default 0.0 }},
            .f2 = {{ if index $cfg "greater_than" }}1.0{{ else }}{{ index $cfg "beta" | default (index $cfg "max") | default 0.0 }}{{ end }},
            .f3 = {{ index $cfg "action_value" | default (index $cfg "action_val") | default 0.0 }},
            .u1 = {{ index $cfg "target_tag" | default (index $cfg "state_tag") | default (index $cfg "bus_id") | default 0 }},
            .s1 = "{{ index $cfg "protocol" | default (index $cfg "script") | default "" }}"
        }
    },
    {{- end }}
};

{{- if .Triggers }}
static const uint32_t _triggers_{{ .ID }}[] = {
    {{- range .Triggers }}
    TAG_{{ index . "tag" | default (index . "event") }},
    {{- end }}
};
{{- end }}
{{- end }}

// [Pipelines - Global Metadata]
const edge_pipeline_def_t g_pipeline_metadata[] = {
{{- range .Pipelines }}
    { 
        .id = "{{ .ID }}", 
        .trigger_tag = {{ if .Trigger }}{{ if is_digit .Trigger }}{{ .Trigger }}{{ else }}TAG_{{ .Trigger }}{{ end }}{{ else }}0{{ end }},
        .extra_triggers = {{ if .Triggers }}_triggers_{{ .ID }}{{ else }}NULL{{ end }},
        .extra_trigger_count = {{ if .Triggers }}{{ len .Triggers }}{{ else }}0{{ end }},
        .stages = _stages_{{ .ID }},
        .stage_count = {{ if .Stages }}{{ len .Stages }}{{ else }}0{{ end }}
    },
{{- end }}
};
const int g_pipeline_metadata_len = {{ len .Pipelines }};
{{- end -}}