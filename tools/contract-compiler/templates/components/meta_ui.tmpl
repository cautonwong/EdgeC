{{- define "meta_ui" -}}
// [UI & API Gateway Blueprint]
const ui_info_t g_ui_metadata = {
    .theme = "{{ .UI.Theme }}"
};

/**
 * Auto-generated API Routing Table
 * Maps Tags to REST resources for the API Gateway
 */
const api_route_t g_api_routes[] = {
{{- range .ActiveTags }}
    { "/api/v1/tags/{{ .Name | lower }}", TAG_{{ .Name }}, "{{ index .Attributes "category" | default "generic" }}" },
{{- end }}
};
const int g_api_routes_len = {{ len .ActiveTags }};
{{- end -}}
