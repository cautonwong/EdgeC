{{- define "h_enums" -}}
// [Section 2] Tag ID Enum
typedef enum {
    TAG_INVALID = 0,
{{- range .AllTags }}
    TAG_{{ .Name }} = {{ .ID }},
{{- end }}
    TAG_MAX_ID
} edge_tag_enum_t;

// [Section 2.5] Parameter Enum Values
enum {
    PARAM_INVALID = 0,
{{- range .Params }}
    PARAM_{{ .Name }},
{{- end }}
    PARAM_MAX_ID
};
{{- end -}}