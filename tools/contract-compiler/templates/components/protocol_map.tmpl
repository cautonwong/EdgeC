{{- define "protocol_map" -}}
{{- /* Input: .Proto (string), .Map (HashInfo) */ -}}
{{- $lowerProto := .Proto | lower -}}
// --- {{ .Proto }} Protocol Mapping ---
{{- if and .Map .Map.Keys }}
// 1. 查找表 (按照 Hash 桶排序)
static const {{ $lowerProto }}_map_t s_{{ $lowerProto }}_table[] = {
{{- range .Map.Keys }}
    {{- if ne .TagID 0 }}
    {{- if or (eq $.Proto "IEC104") (eq $.Proto "IEC101") }}
    { (uint32_t){{ .RawKey }}, TAG_{{ .TagName }}, {{ .Scale }}, {{ .IecType }}, {{ .Flags }}, {{ .DeadBand }}, {{ .GroupID }}, {{ .ByteLen }}, {{ .Access }} }, // {{ .StrKey }}
    {{- else }}
    { (uint32_t){{ .RawKey }}, TAG_{{ .TagName }}, {{ .Scale }}, {{ .ByteLen }}, {{ .Access }} }, // {{ .StrKey }}
    {{- end }}
    {{- else }}
    { 0 }, // Empty Slot
    {{- end }}
{{- end }}
};

{{- if or (eq .Proto "IEC104") (eq .Proto "IEC101") }}
// [GI 性能优化] 仅包含本协议点位的紧凑索引表
static const {{ $lowerProto }}_map_t* const g_{{ $lowerProto }}_gi_list[] = {
{{- range .Map.Keys }}
    {{- if ne .TagID 0 }}
    &s_{{ $lowerProto }}_table[{{ _contract_hash_mix (uint32 .RawKey) $.Map.Seed (uint32 (sub $.Map.TableSize 1)) }}],
    {{- end }}
{{- end }}
};

// [注入专供] 协议契约 Bundle
const {{ $lowerProto }}_contract_t g_{{ $lowerProto }}_contract = {
    .gi_list = g_{{ $lowerProto }}_gi_list,
    .gi_count = {{ len .Map.Keys }}
};
{{- end }}

// 2. 通用查找函数
const {{ $lowerProto }}_map_t* edge_get_map_{{ $lowerProto }}(uint32_t key) {
    if (sizeof(s_{{ $lowerProto }}_table) == 0) return NULL;
    uint32_t h = _contract_hash_mix(key, {{ .Map.Seed }}, {{ .Map.TableSize }} - 1);
    if (h >= {{ .Map.TableSize }}) return NULL; 
    const {{ $lowerProto }}_map_t* entry = &s_{{ $lowerProto }}_table[h];
    if (entry->key == key && entry->tag_id != 0) {
        return entry;
    }
    return NULL;
}

// 3. 简易查表接口 (兼容驱动层)
edge_tag_id_t edge_lookup_{{ $lowerProto }}(uint32_t key, float *scale) {
    const {{ $lowerProto }}_map_t* m = edge_get_map_{{ $lowerProto }}(key);
    if (m) {
        if (scale) *scale = m->scaler;
        return m->tag_id;
    }
    return 0;
}

// 4. 反向查找表 (按照 TagID 稠密索引排列)
static const {{ $lowerProto }}_map_t s_{{ $lowerProto }}_rev_table[] = {
{{- range $i, $tag := .AllTags }}
    {{- $binding := index $.PMap .Name }}
    {{- $found := false }}
    {{- range $binding }}
        {{- if eq .ProtocolType $.Proto }}
        {{- if eq $.Proto "DLMS" }}
        { { {{ range $j, $b := .OBIS }}{{ if $j }}, {{ end }}{{ $b }}{{ end }} }, {{ .ClassID }}, {{ .AttrID }}, TAG_{{ .TagName }}, {{ .Scale }}, {{ .Access }} }, // TagID {{ .TagID }}
        {{- else if or (eq $.Proto "IEC104") (eq $.Proto "IEC101") }}
        { (uint32_t){{ .IOA }}, TAG_{{ .TagName }}, {{ .Scale }}, {{ .IecType }}, {{ .Flags }}, {{ .DeadBand }}, {{ .GroupID }}, {{ .ByteLen }}, {{ .Access }} }, // TagID {{ .TagID }}
        {{- else }}
        { (uint32_t){{ .RawKey }}, TAG_{{ .TagName }}, {{ .Scale }}, {{ .ByteLen }}, {{ .Access }} }, // TagID {{ .TagID }}
        {{- end }}
        {{- $found = true }}
        {{- end }}
    {{- end }}
    {{- if not $found }}
    { 0 }, 
    {{- end }}
{{- end }}
};

const {{ $lowerProto }}_map_t* edge_get_map_{{ $lowerProto }}_by_tag(edge_tag_id_t tag_id) {
    int idx = edge_tag_get_compact_index(tag_id);
    if (idx < 0 || idx >= (int)(sizeof(s_{{ $lowerProto }}_rev_table)/sizeof(s_{{ $lowerProto }}_rev_table[0]))) return NULL;
    const {{ $lowerProto }}_map_t* m = &s_{{ $lowerProto }}_rev_table[idx];
    return (m->tag_id != 0) ? m : NULL;
}
{{- else }}
// Stub for {{ .Proto }}
const {{ $lowerProto }}_map_t* edge_get_map_{{ $lowerProto }}(uint32_t key) { (void)key; return NULL; }
edge_tag_id_t edge_lookup_{{ $lowerProto }}(uint32_t key, float *scale) { (void)key; (void)scale; return 0; }
{{- end }}
{{- end -}}
