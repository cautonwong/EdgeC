{{ define "protocol_map" }}
{{- $curProto := .Proto }}
{{- $hash := .Map }}
{{- $root := .Root }}
{{- $lowerProto := lower $curProto }}

{{- if $hash }}
// --- {{ $curProto }} Protocol Mapping ---

// 1. 查找表 (按照 Hash 桶排序)
static const {{ $lowerProto }}_map_t s_{{ $lowerProto }}_table[] = {
    {{- range $hash.Entries }}
    {{- if .IsEmpty }}
    { 0 }, // Empty Slot
    {{- else }}
    {{- if eq $curProto "DLMS" }}
    { { {{ range $i, $b := .OBIS }}{{ if $i }}, {{ end }}{{ $b }}{{ end }} }, {{ .ClassID }}, {{ .AttrID }}, {{ .TagID }}, (uint16_t){{ .LogicalIndex }}, {{ .Scale }}, {{ .Access }} }, // {{ .StrKey }}
    {{- else if or (eq $curProto "IEC104") (eq $curProto "IEC101") }}
    { (uint32_t){{ .RawKey }}, {{ .TagID }}, (uint16_t){{ .LogicalIndex }}, {{ .Scale }}, {{ .IecType }}, {{ .Flags }}, {{ .DeadBand }}, {{ .GroupID }}, {{ .ByteLen }}, {{ .Access }} }, // {{ .StrKey }}
    {{- else }}
    { (uint32_t){{ .RawKey }}, {{ .TagID }}, (uint16_t){{ .LogicalIndex }}, {{ .Scale }}, {{ .ByteLen }}, {{ .Access }} }, // {{ .StrKey }}
    {{- end }}
    {{- end }}
    {{- end }}
};

// 2. 哈希查找函数 (O(1))
edge_tag_id_t edge_lookup_{{ $lowerProto }}(uint32_t key, float* scale) {
    uint32_t h = _contract_hash_mix(key, {{ $hash.Seed }}, {{ $hash.TableSize }} - 1);
    const {{ $lowerProto }}_map_t* m = &s_{{ $lowerProto }}_table[h];
    if (m->tag_id == 0) return 0;
    {{- if eq $curProto "DLMS" }}
    {{- else }}
    if (m->key != key) return 0;
    {{- end }}
    if (scale) *scale = m->scaler;
    return m->tag_id;
}

// 3. 元数据访问 (By Key)
const {{ $lowerProto }}_map_t* edge_get_map_{{ $lowerProto }}(uint32_t key) {
    uint32_t h = _contract_hash_mix(key, {{ $hash.Seed }}, {{ $hash.TableSize }} - 1);
    const {{ $lowerProto }}_map_t* m = &s_{{ $lowerProto }}_table[h];
    if (m->tag_id == 0) return NULL;
    {{- if ne $curProto "DLMS" }}
    if (m->key != key) return NULL;
    {{- end }}
    return m;
}

// 4. 反向查找表 (按照 ActiveTags 稠密索引排列)
static const {{ $lowerProto }}_map_t s_{{ $lowerProto }}_rev_table[] = {
{{- range $i, $tag := $root.ActiveTags }}
    {{- $found := false }}
    {{- $bindingList := index $root.TagPMap $tag.Name }}
    {{- range $bindingList }}
        {{- if eq (upper .ProtocolType) (upper $curProto) }}
        {{- if eq $curProto "DLMS" }}
        { { {{ range $j, $b := .OBIS }}{{ if $j }}, {{ end }}{{ $b }}{{ end }} }, {{ .ClassID }}, {{ .AttrID }}, {{ .TagID }}, (uint16_t){{ .LogicalIndex }}, {{ .Scale }}, {{ .Access }} }, // {{ $tag.Name }}
        {{- else if or (eq $curProto "IEC104") (eq $curProto "IEC101") }}
        { (uint32_t){{ .IOA }}, {{ .TagID }}, (uint16_t){{ .LogicalIndex }}, {{ .Scale }}, {{ .IecType }}, {{ .Flags }}, {{ .DeadBand }}, {{ .GroupID }}, {{ .ByteLen }}, {{ .Access }} }, // {{ $tag.Name }}
        {{- else }}
        { (uint32_t){{ .Addr }}, {{ .TagID }}, (uint16_t){{ .LogicalIndex }}, {{ .Scale }}, {{ .ByteLen }}, {{ .Access }} }, // {{ $tag.Name }}
        {{- end }}
        {{- $found = true }}
        {{- end }}
    {{- end }}
    {{- if not $found }}
    { 0 }, 
    {{- end }}
{{- end }}
};

const {{ $lowerProto }}_map_t* edge_get_map_{{ $lowerProto }}_by_tag(edge_tag_id_t tag_id) {
    int idx = edge_tag_get_compact_index(tag_id);
    if (idx < 0 || idx >= (int)(sizeof(s_{{ $lowerProto }}_rev_table)/sizeof(s_{{ $lowerProto }}_rev_table[0]))) return NULL;
    const {{ $lowerProto }}_map_t* m = &s_{{ $lowerProto }}_rev_table[idx];
    return (m->tag_id != 0) ? m : NULL;
}
{{- end }}
{{ end }}