{
  "product": "{{ .Product }}",
  "signature": "{{ printf "0x%08X" .Signature }}",
  "tags": [
    {{- range $i, $tag := .ActiveTags }}
    {
      "id": {{ $tag.ID }},
      "name": "{{ $tag.Name }}",
      "type": "{{ $tag.Type }}",
      "bindings": [
        {{- range $j, $b := $tag.Bindings }}
        {
          "protocol": "{{ $b.ProtocolType }}",
          "attributes": {{ $b.Attributes | marshal }}
        }{{ if lt $j (sub (len $tag.Bindings) 1) }},{{ end }}
        {{- end }}
      ]
    }{{ if lt $i (sub (len $.ActiveTags) 1) }},{{ end }}
    {{- end }}
  ],
  "params": [
    {{- range $i, $param := .Params }}
    {
      "id": {{ $param.ID }},
      "name": "{{ $param.Name }}",
      "type": "{{ $param.Type }}",
      "default": {{ if eq $param.Type "string" }}"{{ $param.Default }}"{{ else }}{{ $param.Default }}{{ end }}
    }{{ if lt $i (sub (len $.Params) 1) }},{{ end }}
    {{- end }}
  ],
  "pipelines": [
    {{- range $i, $pipe := .Pipelines }}
    {
      "id": "{{ $pipe.ID }}",
      "trigger": "{{ $pipe.Trigger }}",
      "triggers": {{ $pipe.Triggers | marshal }}
    }{{ if lt $i (sub (len $.Pipelines) 1) }},{{ end }}
    {{- end }}
  ],
  "hardware": [
    {{- range $i, $hw := .Hardware }}
    {
      "id": {{ $hw.ID }},
      "type": "{{ $hw.Type }}",
      "label": "{{ $hw.Label }}",
      "profiles": {{ $hw.Profiles | marshal }},
      "topology": [
        {{- range $j, $dev := $hw.Topology }}
        {
          "dev_id": "{{ $dev.DeviceID }}",
          "address": {{ $dev.Address }},
          "protocol": "{{ $dev.Protocol }}",
          "simulation": {{ $dev.Simulation | marshal }}
        }{{ if lt $j (sub (len $hw.Topology) 1) }},{{ end }}
        {{- end }}
      ]
    }{{ if lt $i (sub (len $.Hardware) 1) }},{{ end }}
    {{- end }}
  ]
}