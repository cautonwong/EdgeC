{
  "product": "{{ .Product }}",
  "signature": "{{ printf "0x%08X" .Signature }}",
  "tags": [
    {{- range $i, $tag := .ActiveTags }}
    {
      "id": {{ $tag.ID }},
      "name": "{{ $tag.Name }}",
      "type": "{{ $tag.Type }}",
      "bindings": [
        {{- range $j, $b := $tag.Bindings }}
        {
          "protocol": "{{ $b.ProtocolType }}",
          "attributes": {{ $b.Attributes | marshal }}
        }{{ if lt $j (sub (len $tag.Bindings) 1) }},{{ end }}
        {{- end }}
      ]
    }{{ if lt $i (sub (len $.ActiveTags) 1) }},{{ end }}
    {{- end }}
  ],
  "connectivity": [
    {{- range $i, $conn := .Connectivity }}
    {
      "id": {{ $conn.ID }},
      "label": "{{ $conn.Label }}",
      "type": "{{ $conn.Type }}",
      "config": {{ $conn.Config | marshal }},
      "simulation": {{ $conn.Simulation | marshal }}
    }{{ if lt $i (sub (len $.Connectivity) 1) }},{{ end }}
    {{- end }}
  ],
  "devices": [
    {{- range $i, $dev := .Devices }}
    {
      "id": "{{ $dev.ID }}",
      "bus_id": {{ $dev.BusID }},
      "protocol": "{{ $dev.Protocol }}",
      "address": {{ $dev.Address | marshal }},
      "model": "{{ $dev.Model }}",
      "config": {{ $dev.Config | marshal }},
      "simulation": {{ $dev.Simulation | marshal }}
    }{{ if lt $i (sub (len $.Devices) 1) }},{{ end }}
    {{- end }}
  ],
  "pipelines": [
    {{- range $i, $pipe := .Pipelines }}
    {
      "id": "{{ $pipe.ID }}",
      "trigger": "{{ $pipe.Trigger }}",
      "triggers": {{ $pipe.Triggers | marshal }},
      "stages": [
        {{- range $j, $stage := $pipe.Stages }}
        {
          "name": "{{ index $stage "name" | default "stage" }}",
          "type": "{{ index $stage "type" }}",
          "config": {{ $stage | marshal }}
        }{{ if lt $j (sub (len $pipe.Stages) 1) }},{{ end }}
        {{- end }}
      ]
    }{{ if lt $i (sub (len $.Pipelines) 1) }},{{ end }}
    {{- end }}
  ]
}
