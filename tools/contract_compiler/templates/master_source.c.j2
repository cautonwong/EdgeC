#include "contracts.h"
#include <string.h>

// --- Metadata Table ---
const tag_meta_t g_tag_meta_table[] = {
{% for t in active_tags %}
    [TAG_{{ t.name }}] = { 
        "{{ t.name }}", 
        "{{ t.unit }}", 
        {{ 'true' if t.attributes.persist else 'false' }}, 
        {{ 'true' if t.attributes.upload else 'false' }} 
    },
{% endfor %}
};

const tag_meta_t* edge_get_meta(edge_tag_id_t id) {
    if (id >= TAG_MAX_ID) return NULL;
    return &g_tag_meta_table[id];
}

/* =========================================================
 * Protocol Specific Maps
 * ========================================================= */

{% if protocols.modbus %}
// --- Modbus ---
static const modbus_map_t s_modbus_map[] = {
{% for m in protocols.modbus.entries %}
    { {{ m.addr }}, TAG_{{ m.tag_name }}, {{ m.scale }}f },
{% endfor %}
};
static const int s_modbus_len = {{ protocols.modbus.count }};

edge_tag_id_t edge_lookup_modbus(uint16_t reg, float *out_scale) {
    int left = 0, right = s_modbus_len - 1;
    while (left <= right) {
        int mid = left + (right - left) / 2;
        if (s_modbus_map[mid].addr == reg) {
            if (out_scale) *out_scale = s_modbus_map[mid].scale;
            return s_modbus_map[mid].id;
        }
        if (s_modbus_map[mid].addr < reg) left = mid + 1;
        else right = mid - 1;
    }
    return TAG_INVALID;
}
{% else %}
edge_tag_id_t edge_lookup_modbus(uint16_t reg, float *out_scale) { (void)reg; (void)out_scale; return TAG_INVALID; }
{% endif %}

{% if protocols.dlms %}
// --- DLMS ---
static const dlms_map_t s_dlms_map[] = {
{% for m in protocols.dlms.entries %}
    { "{{ m.obis }}", TAG_{{ m.tag_name }}, {{ m.scaler }}f },
{% endfor %}
};
static const int s_dlms_len = {{ protocols.dlms.count }};

edge_tag_id_t edge_lookup_dlms(const char* obis, float *out_scale) {
    for (int i = 0; i < s_dlms_len; i++) {
        if (strcmp(s_dlms_map[i].obis, obis) == 0) {
            if (out_scale) *out_scale = s_dlms_map[i].scaler;
            return s_dlms_map[i].id;
        }
    }
    return TAG_INVALID;
}
{% else %}
edge_tag_id_t edge_lookup_dlms(const char* obis, float *out_scale) { (void)obis; (void)out_scale; return TAG_INVALID; }
{% endif %}

